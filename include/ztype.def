#ifndef TYPE_MASKS
#define TYPE_MASKS

#define TYPE_NULLABLE_MASK      (1 << 0x00)     /* can hold 'none'                  */
#define TYPE_WRAPPER_MASK       (1 << 0x01)     /* wraps a payload that '!' unwraps */
#define TYPE_COMPARABLE_MASK    (1 << 0x02)     /* comparable types                 */

#endif

/*    kind              category bits                               hash seed */
TYPE(Z_TYPE_PRIMITIVE,  0xE142EA7D17BE3111ULL,  TYPE_COMPARABLE_MASK)
TYPE(Z_TYPE_POINTER,    0x9064005C3985C3CFULL,  TYPE_COMPARABLE_MASK | TYPE_NULLABLE_MASK)
TYPE(Z_TYPE_STRUCT,     0xBF87E362CF8D446BULL,  0)
TYPE(Z_TYPE_ARRAY,      0xC8A639D015B52909ULL,  0)
TYPE(Z_TYPE_FUNCTION,   0xC797B2C957207247ULL,  0)
TYPE(Z_TYPE_TUPLE,      0xFDE31A516694C343ULL,  0)
TYPE(Z_TYPE_GENERIC,    0xC4007D5AE88DA719ULL,  0)
TYPE(Z_TYPE_FACET,      0xFF9D3E64C1A6423BULL,  0)
TYPE(Z_TYPE_ENUM,       0x8CF2B69B0577AEA9ULL,  0)
TYPE(Z_TYPE_NONE,       0xE92AC1391F4A8CA1ULL,  0)
TYPE(Z_TYPE_NAMESPACE,  0xA7AA7CBC23377BBDULL,  0)
TYPE(Z_TYPE_SUM,        0xAD78DC4BFB9E8DDBULL,  0)
TYPE(Z_TYPE_OPTIONAL,   0x9E3779B185EBCA87ULL,  TYPE_COMPARABLE_MASK | TYPE_NULLABLE_MASK | TYPE_WRAPPER_MASK)
TYPE(Z_TYPE_RESULT,     0xC2B2AE3D27D4EB4FULL,  TYPE_COMPARABLE_MASK | TYPE_WRAPPER_MASK)
