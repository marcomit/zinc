/* ---------------- misc ---------------- */
ZOP(NOP,        FMT_NONE)
ZOP(MOV,        FMT_DA)
ZOP(LOADK,      FMT_DK)
ZOP(LOADI,      FMT_DI)
ZOP(SELECT,     FMT_DABC)

/* ---------------- addresses ---------------- */
ZOP(FRAMEADDR,  FMT_DI)
ZOP(GLOBALADDR, FMT_DI)
ZOP(FUNCADDR,   FMT_DI)
ZOP(ADDI,       FMT_DAI)
ZOP(INDEX,      FMT_DABI)

/* ---------------- memory ---------------- */
ZOP(LOAD8,      FMT_DAI)
ZOP(LOAD16,     FMT_DAI)
ZOP(LOAD32,     FMT_DAI)
ZOP(LOAD64,     FMT_DAI)
ZOP(STORE8,     FMT_ABI)
ZOP(STORE16,    FMT_ABI)
ZOP(STORE32,    FMT_ABI)
ZOP(STORE64,    FMT_ABI)
ZOP(COPY,       FMT_ABI)
ZOP(MEMSET,     FMT_ABI)

/* ---------------- integer arithmetic ---------------- */
ZOP(ADD_I32,    FMT_DAB)
ZOP(ADD_I64,    FMT_DAB)
ZOP(SUB_I32,    FMT_DAB)
ZOP(SUB_I64,    FMT_DAB)
ZOP(MUL_I32,    FMT_DAB)
ZOP(MUL_I64,    FMT_DAB)
ZOP(SDIV_I32,   FMT_DAB)
ZOP(SDIV_I64,   FMT_DAB)
ZOP(UDIV_I32,   FMT_DAB)
ZOP(UDIV_I64,   FMT_DAB)
ZOP(SREM_I32,   FMT_DAB)
ZOP(SREM_I64,   FMT_DAB)
ZOP(UREM_I32,   FMT_DAB)
ZOP(UREM_I64,   FMT_DAB)
ZOP(AND_I32,    FMT_DAB)
ZOP(AND_I64,    FMT_DAB)
ZOP(OR_I32,     FMT_DAB)
ZOP(OR_I64,     FMT_DAB)
ZOP(XOR_I32,    FMT_DAB)
ZOP(XOR_I64,    FMT_DAB)
ZOP(SHL_I32,    FMT_DAB)
ZOP(SHL_I64,    FMT_DAB)
ZOP(LSHR_I32,   FMT_DAB)
ZOP(LSHR_I64,   FMT_DAB)
ZOP(ASHR_I32,   FMT_DAB)
ZOP(ASHR_I64,   FMT_DAB)

/* ---------------- float arithmetic ---------------- */
ZOP(FADD_F32,   FMT_DAB)
ZOP(FADD_F64,   FMT_DAB)
ZOP(FSUB_F32,   FMT_DAB)
ZOP(FSUB_F64,   FMT_DAB)
ZOP(FMUL_F32,   FMT_DAB)
ZOP(FMUL_F64,   FMT_DAB)
ZOP(FDIV_F32,   FMT_DAB)
ZOP(FDIV_F64,   FMT_DAB)
ZOP(FREM_F32,   FMT_DAB)
ZOP(FREM_F64,   FMT_DAB)
ZOP(FNEG_F32,   FMT_DA)
ZOP(FNEG_F64,   FMT_DA)

/* ---------------- integer compare ---------- */
ZOP(EQ_I32,     FMT_DAB)
ZOP(EQ_I64,     FMT_DAB)
ZOP(NE_I32,     FMT_DAB)
ZOP(NE_I64,     FMT_DAB)
ZOP(SLT_I32,    FMT_DAB)
ZOP(SLT_I64,    FMT_DAB)
ZOP(SLE_I32,    FMT_DAB)
ZOP(SLE_I64,    FMT_DAB)
ZOP(ULT_I32,    FMT_DAB)
ZOP(ULT_I64,    FMT_DAB)
ZOP(ULE_I32,    FMT_DAB)
ZOP(ULE_I64,    FMT_DAB)

/* ---------------- float compare --------------- */
ZOP(FOEQ_F32,   FMT_DAB)
ZOP(FOEQ_F64,   FMT_DAB)
ZOP(FONE_F32,   FMT_DAB)
ZOP(FONE_F64,   FMT_DAB)
ZOP(FOLT_F32,   FMT_DAB)
ZOP(FOLT_F64,   FMT_DAB)
ZOP(FOLE_F32,   FMT_DAB)
ZOP(FOLE_F64,   FMT_DAB)
ZOP(FUEQ_F32,   FMT_DAB)
ZOP(FUEQ_F64,   FMT_DAB)
ZOP(FUNE_F32,   FMT_DAB)
ZOP(FUNE_F64,   FMT_DAB)
ZOP(FULT_F32,   FMT_DAB)
ZOP(FULT_F64,   FMT_DAB)
ZOP(FULE_F32,   FMT_DAB)
ZOP(FULE_F64,   FMT_DAB)
ZOP(FORD_F32,   FMT_DAB)
ZOP(FORD_F64,   FMT_DAB)
ZOP(FUNO_F32,   FMT_DAB)
ZOP(FUNO_F64,   FMT_DAB)

/* ---------------- integer width changes ---------------- */
ZOP(TRUNC_I1,   FMT_DA)
ZOP(TRUNC_I8,   FMT_DA)
ZOP(TRUNC_I16,  FMT_DA)
ZOP(TRUNC_I32,  FMT_DA)
ZOP(SEXT_I1,    FMT_DA)
ZOP(SEXT_I8,    FMT_DA)
ZOP(SEXT_I16,   FMT_DA)
ZOP(SEXT_I32,   FMT_DA)

/* ---------------- float <-> int ---------------- */
ZOP(F32_TO_I32, FMT_DA)
ZOP(F32_TO_I64, FMT_DA)
ZOP(F64_TO_I32, FMT_DA)
ZOP(F64_TO_I64, FMT_DA)
ZOP(F32_TO_U32, FMT_DA)
ZOP(F32_TO_U64, FMT_DA)
ZOP(F64_TO_U32, FMT_DA)
ZOP(F64_TO_U64, FMT_DA)
ZOP(I32_TO_F32, FMT_DA)
ZOP(I64_TO_F32, FMT_DA)
ZOP(I32_TO_F64, FMT_DA)
ZOP(I64_TO_F64, FMT_DA)
ZOP(U32_TO_F32, FMT_DA)
ZOP(U64_TO_F32, FMT_DA)
ZOP(U32_TO_F64, FMT_DA)
ZOP(U64_TO_F64, FMT_DA)
ZOP(F32_TO_F64, FMT_DA)
ZOP(F64_TO_F32, FMT_DA)

/* ---------------- control flow ---------------- */
ZOP(JMP,        FMT_I)
ZOP(JZ,         FMT_AI)
ZOP(JNZ,        FMT_AI)
ZOP(SWITCH,     FMT_AI)
ZOP(CALL,       FMT_DI)
ZOP(CALLI,      FMT_DAI)
ZOP(RET,        FMT_A)
ZOP(RETAGG,     FMT_AI)
ZOP(RETV,       FMT_NONE)
ZOP(TRAP,       FMT_I)
