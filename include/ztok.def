/*
 * Definition of tokens using the X macros trick.
 */

#ifndef TOK_MASKS
#define TOK_MASKS

#define TOK_FLOWS_MASK                  (1 << 0)
#define TOK_TYPES_MASK                  (1 << 0x01)
#define TOK_DYN_MASK                    (1 << 0x02)
#define TOK_SYMBOLS_MASK                (1 << 0x03)
#define TOK_OPERATOR                    (1 << 0x04)
#define TOK_TYPES_SIGNATURE_MASK        (1 << 0x05)
#define TOK_LITERAL                     (1 << 0x06)
#define TOK_SIGNED                      (1 << 0x07)
#define TOK_UNSIGNED                    (1 << 0x08)
#define TOK_FLOAT                       (1 << 0x09)
#define TOK_EXPANDABLE                  (1 << 0x0A)
#define TOK_BITOPERATOR_MASK            (1 << 0x0B)
#define TOK_OVERLOADABLE                (1 << 0x0C)
#define TOK_SELF_OPERATOR               (1 << 0x0D)
#endif

#ifdef TOK_FLOWS
DEF(TOK_IF,         "if",               TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_ELSE,       "else",             TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_FOR,        "for",              TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_CONTINUE,   "continue",         TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_BREAK,      "break",            TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_RETURN,     "return",           TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_SWITCH,     "switch",           TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_CASE,       "case",             TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_MODULE,     "use",              TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_FOREIGN,    "foreign",          TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_DEFER,      "defer",            TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_IN,         "in",               TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_MATCH,      "match",            TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_MACRO,      "macro",            TOK_FLOWS_MASK)
DEF(TOK_NOT,        "not",              TOK_FLOWS_MASK)
DEF(TOK_OR,         "or",               TOK_FLOWS_MASK)
DEF(TOK_AND,        "and",              TOK_FLOWS_MASK)
DEF(TOK_NONE,       "none",             TOK_FLOWS_MASK | TOK_LITERAL)
DEF(TOK_TRUE,       "true",             TOK_FLOWS_MASK | TOK_LITERAL)
DEF(TOK_FALSE,      "false",            TOK_FLOWS_MASK | TOK_LITERAL)
DEF(TOK_CAST,       "as",               TOK_FLOWS_MASK | TOK_EXPANDABLE | TOK_OVERLOADABLE)
DEF(TOK_SIZEOF,     "sizeof",           TOK_FLOWS_MASK | TOK_EXPANDABLE)
DEF(TOK_WHERE,      "where",            TOK_FLOWS_MASK)
DEF(TOK_WITH,       "with",             TOK_FLOWS_MASK)
DEF(TOK_IMPL,       "impl",             TOK_FLOWS_MASK)
DEF(TOK_FACET,      "facet",            TOK_FLOWS_MASK)
DEF(TOK_FN,         "fn",               TOK_FLOWS_MASK)
#endif

#ifdef TOK_TYPES
DEF(TOK_VOID,       "u0",               TOK_TYPES_MASK)
DEF(TOK_BOOL,       "u1",               TOK_TYPES_MASK | TOK_UNSIGNED)
DEF(TOK_CHAR,       "char",             TOK_TYPES_MASK)
DEF(TOK_RUNE,       "rune",             TOK_TYPES_MASK | TOK_UNSIGNED)
DEF(TOK_F32,        "f32",              TOK_TYPES_MASK | TOK_FLOAT)
DEF(TOK_F64,        "f64",              TOK_TYPES_MASK | TOK_FLOAT)
DEF(TOK_I8,         "i8",               TOK_TYPES_MASK | TOK_SIGNED)
DEF(TOK_I16,        "i16",              TOK_TYPES_MASK | TOK_SIGNED)
DEF(TOK_I32,        "i32",              TOK_TYPES_MASK | TOK_SIGNED)
DEF(TOK_I64,        "i64",              TOK_TYPES_MASK | TOK_SIGNED)
DEF(TOK_U8,         "u8",               TOK_TYPES_MASK | TOK_UNSIGNED)
DEF(TOK_U16,        "u16",              TOK_TYPES_MASK | TOK_UNSIGNED)
DEF(TOK_U32,        "u32",              TOK_TYPES_MASK | TOK_UNSIGNED)
DEF(TOK_U64,        "u64",              TOK_TYPES_MASK | TOK_UNSIGNED)
DEF(TOK_STRUCT,     "struct",           TOK_TYPES_SIGNATURE_MASK | TOK_EXPANDABLE)
DEF(TOK_TYPEDEF,    "type",             TOK_TYPES_SIGNATURE_MASK)
DEF(TOK_ENUM,       "enum",             TOK_TYPES_SIGNATURE_MASK | TOK_EXPANDABLE)
DEF(TOK_CONST,      "const",            TOK_TYPES_SIGNATURE_MASK)
DEF(TOK_PUB,        "pub",              TOK_TYPES_SIGNATURE_MASK)
DEF(TOK_DYNAMIC,    "dyn",              TOK_TYPES_SIGNATURE_MASK)
DEF(TOK_DO,         "do",               TOK_TYPES_SIGNATURE_MASK)
#endif

#ifdef TOK_DYN
DEF(TOK_STR_LIT,    "string literal",   TOK_DYN_MASK | TOK_LITERAL)
DEF(TOK_INT_LIT,    "int literal",      TOK_DYN_MASK | TOK_LITERAL)
DEF(TOK_FLOAT_LIT,  "float literal",    TOK_DYN_MASK | TOK_LITERAL)
DEF(TOK_IDENT,      "identifier",       TOK_DYN_MASK | TOK_EXPANDABLE)
DEF(TOK_RUNE_LIT,   "rune literal",     TOK_DYN_MASK | TOK_LITERAL | TOK_EXPANDABLE)
#endif

#ifdef TOK_SYMBOLS
DEF(TOK_ARROW,          "->",           TOK_SYMBOLS_MASK)
DEF(TOK_LARROW,         "<-",           TOK_SYMBOLS_MASK)
DEF(TOK_EQEQ,           "==",           TOK_SYMBOLS_MASK | TOK_OVERLOADABLE)
DEF(TOK_NOTEQ,          "!=",           TOK_SYMBOLS_MASK)
DEF(TOK_ASSIGN,         ":=",           TOK_SYMBOLS_MASK)
DEF(TOK_DOUBLE_COLON,   "::",           TOK_SYMBOLS_MASK)
DEF(TOK_TRIPLE_DOT,     "...",          TOK_SYMBOLS_MASK)
DEF(TOK_LPAREN,         "(",            TOK_SYMBOLS_MASK)
DEF(TOK_RPAREN,         ")",            TOK_SYMBOLS_MASK)
DEF(TOK_LBRACKET,       "{",            TOK_SYMBOLS_MASK)
DEF(TOK_RBRACKET,       "}",            TOK_SYMBOLS_MASK)
DEF(TOK_LSBRACKET,      "[",            TOK_SYMBOLS_MASK)
DEF(TOK_RSBRACKET,      "]",            TOK_SYMBOLS_MASK)
DEF(TOK_SELF_PLUS,      "+=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_MINUS,     "-=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_MUL,       "*=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_DIV,       "/=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_BITOR,     "|=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_BITAND,    "&=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_BITXOR,    "^=",           TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_BITL,      "<<=",          TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_SELF_BITR,      ">>=",          TOK_SYMBOLS_MASK | TOK_SELF_OPERATOR)
DEF(TOK_REF,            "&",            TOK_SYMBOLS_MASK)
DEF(TOK_STAR,           "*",            TOK_OPERATOR | TOK_OVERLOADABLE     | TOK_SYMBOLS_MASK)
DEF(TOK_PLUS,           "+",            TOK_OPERATOR | TOK_OVERLOADABLE     | TOK_SYMBOLS_MASK)
DEF(TOK_MINUS,          "-",            TOK_OPERATOR | TOK_OVERLOADABLE     | TOK_SYMBOLS_MASK)
DEF(TOK_DIV,            "/",            TOK_OPERATOR | TOK_OVERLOADABLE     | TOK_SYMBOLS_MASK)
DEF(TOK_COMMA,          ",",            TOK_SYMBOLS_MASK | TOK_EXPANDABLE)
DEF(TOK_EQ,             "=",            TOK_SYMBOLS_MASK | TOK_OVERLOADABLE |TOK_EXPANDABLE)
DEF(TOK_DOT,            ".",            TOK_SYMBOLS_MASK | TOK_EXPANDABLE)
DEF(TOK_BITL,           "<<",           TOK_SYMBOLS_MASK | TOK_BITOPERATOR_MASK)
DEF(TOK_BITR,           ">>",           TOK_SYMBOLS_MASK | TOK_BITOPERATOR_MASK)
DEF(TOK_BITOR,          "|",            TOK_SYMBOLS_MASK | TOK_BITOPERATOR_MASK)
DEF(TOK_BITNOT,         "~",            TOK_SYMBOLS_MASK | TOK_BITOPERATOR_MASK)
DEF(TOK_BITXOR,         "^",            TOK_SYMBOLS_MASK | TOK_BITOPERATOR_MASK)
DEF(TOK_GTE,            ">=",           TOK_SYMBOLS_MASK | TOK_OVERLOADABLE)
DEF(TOK_LTE,            "<=",           TOK_SYMBOLS_MASK | TOK_OVERLOADABLE)
DEF(TOK_GT,             ">",            TOK_SYMBOLS_MASK | TOK_OVERLOADABLE)
DEF(TOK_LT,             "<",            TOK_SYMBOLS_MASK | TOK_OVERLOADABLE)
DEF(TOK_SEMICOLON,      ";",            TOK_SYMBOLS_MASK | TOK_EXPANDABLE)
DEF(TOK_COLON,          ":",            TOK_SYMBOLS_MASK | TOK_EXPANDABLE)
DEF(TOK_MACRO_EXPR,     "$",            TOK_SYMBOLS_MASK)
DEF(TOK_MACRO_IDENT,    "@",            TOK_SYMBOLS_MASK)
DEF(TOK_HASHTAG,        "#",            TOK_SYMBOLS_MASK)
DEF(TOK_QUOTE,          "'",            TOK_SYMBOLS_MASK)
DEF(TOK_MOD,            "%",            TOK_SYMBOLS_MASK)
DEF(TOK_OPT,            "?",            TOK_SYMBOLS_MASK)
DEF(TOK_ESCL,           "!",            TOK_SYMBOLS_MASK)
#endif
