Io :: struct {
    stdout: Writer
    stdin: Reader
    stderr: Writer
}

#lang(writer)
Writer :: facet {
    write: fn (char *, usize) u0
}

#lang(writable)
Writable :: facet {
    sink: fn (*Writer)
}

User :: struct {
    name: *char
    age: i32
}

User self :: impl(Writable) {
    sink :: fn (writer: *Writer) {
        writer
            .write_str("User{name=")
            .write(self.name, strlen(self.name))
            .write_str(", age=")
            .write_int(self.age)
            .write_byte('}')
    }
}

StringBuilder :: struct {
    allocator: Allocator
    buffer: *char
    len: usize
    capacity: usize
}

StringBuilder :: impl {
    new :: fn () *StringBuilder with a: Allocator {
        self: *StringBuilder = alloc(sizeof StirngBuilder)
        self.allocator = a
        self.buffer = none
        self.len = 0
        self.capacity = 0
        return self
    }
}

*StringBuilder self :: impl {
    append :: fn (buffer: *char, bytes: usize) {
        if not buffer or bytes == 0 return

        with _ := self.allocator {
            if not self.buffer {
                self.capacity = 8
                self.buffer = alloc(self.capacity)
            } else if self.len >= self.capacity {
                self.capacity *= 2
                self.buffer = resize(self.buffer, self.capacity)
            }

            libc.memcpy()
        }
    }
}

*StringBuilder self :: impl(Writer) {
    write :: fn (buffer: *char, bytes: usize) {
        self.append(buffer, bytes)
    }

    write_str :: fn (str: *char) {
        self.append(str, libc.strlen(str))
    }

    write_byte :: fn (byte: char) {
        self.append(&byte, 1)
    }
}

#lang(interpolated_string)
InterpolatedString :: enum {
    Lit(*char)
    Obj(Writer)
}

print :: fn (out: []InterpolatedString) u0 with Io {

}


main :: fn () i32 {
    name := "Some"
    age := 99

    stdout := std.Writer.stdout()

    with _ := GeneralPurposeAllocator.init().&.allocator() {
        sb := StringBuilder.new()
    }
    stdout.write(#"Hello, {name}, i'm {age} years old")

    return 0
}
