foreign raylib {
    u0 InitWindow(i32, i32, *char)
    u0 CloseWindow()
    u0 SetTargetFPS(i32)
    u1 WindowShouldClose()
    u0 BeginDrawing()
    u0 EndDrawing()
    f32 GetFrameTime()
    u1 IsKeyDown(i32)
    u1 CheckCollisionCircleRec(Vector2, f32, Rectangle)
    u0 ClearBackground(Color)
    u0 DrawCircleV(Vector2, f32, Color)
    u0 DrawRectangleRec(Rectangle, Color)
    u0 DrawFPS(i32, i32)
    u0 DrawText(*char, i32, i32, i32, Color)
}

struct Vector2 {
    f32 x
    f32 y
}

struct Rectangle {
    f32 x
    f32 y
    f32 width
    f32 height
}

struct Color {
    u8 r
    u8 g
    u8 b
    u8 a
}

i32 main() {
    screenWidth  := 800
    screenHeight := 450

    raylib::InitWindow(screenWidth, screenHeight, "Raylib Simple Pong")

    ballPosition := Vector2 { x: 400.0, y: 225.0 }
    ballSpeed    := Vector2 { x: 300.0, y: 300.0 }
    ballRadius   := 10.0

    paddle      := Rectangle { x: 770.0, y: 175.0, width: 20.0, height: 100.0 }
    paddleSpeed := 400.0

    black  := Color { r: 0,   g: 0,   b: 0,   a: 255 }
    white  := Color { r: 255, g: 255, b: 255, a: 255 }
    maroon := Color { r: 190, g: 33,  b: 55,  a: 255 }
    gray   := Color { r: 130, g: 130, b: 130, a: 255 }

    raylib::SetTargetFPS(60)

    for not raylib::WindowShouldClose() {
        dt := raylib::GetFrameTime()

        ballPosition.x = ballPosition.x + ballSpeed.x * dt
        ballPosition.y = ballPosition.y + ballSpeed.y * dt

        if ballPosition.y <= ballRadius and ballSpeed.y < 0.0 {
            ballSpeed.y = ballSpeed.y * -1.0
        }
        if ballPosition.y >= screenHeight - ballRadius and ballSpeed.y > 0.0 {
            ballSpeed.y = ballSpeed.y * -1.0
        }

        if ballPosition.x >= screenWidth or ballPosition.x - ballRadius <= 0.0 {
            ballSpeed.x = ballSpeed.x * -1.0005
        }

        if raylib::IsKeyDown(265) {
            paddle.y = paddle.y - paddleSpeed * dt
            if paddle.y < 0.0 {
                paddle.y = 0.0
            }
        }
        if raylib::IsKeyDown(264) {
            paddle.y = paddle.y + paddleSpeed * dt
            if paddle.y > screenHeight - paddle.height {
                paddle.y = screenHeight - paddle.height
            }
        }

        if raylib::CheckCollisionCircleRec(ballPosition, ballRadius, paddle) {
            ballSpeed.x = ballSpeed.x * -1.0005
        }

        raylib::BeginDrawing()
        raylib::ClearBackground(black)
        raylib::DrawCircleV(ballPosition, ballRadius, maroon)
        raylib::DrawRectangleRec(paddle, white)
        raylib::DrawFPS(10, 10)
        raylib::DrawText("Use UP/DOWN Arrows", 10, 40, 20, gray)
        raylib::EndDrawing()
    }

    raylib::CloseWindow()
    return 0
}
