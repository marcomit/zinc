use <std::mem::gpa>
use <std::io::thread>
use <std::io::mutex>
use <std::io::net>

libc :: foreign {
    printf   : fn (*char, ...) u0
    snprintf : fn (*char, u64, *char, ...) i32
    fflush   : fn (*u8) i32
}

Client :: struct {
    stream: TcpStream
    id: u64
    alive: u1
}

Context :: struct {
    clients: *Client
    mutex: Mutex
    len: u64
}

Context :: impl {
    new :: fn (mutex: Mutex) *Context [Allocator] {
        self := alloc(sizeof Context) as *Context
        self.mutex = mutex
        self.len = 0
        self.clients = alloc(sizeof Client * 64) as *Client
        return self
    }
}

*Context self :: impl {
    add :: fn (stream: TcpStream) u64 {
        self.mutex.lock()
        id := self.len
        self.clients[id].stream = stream
        self.clients[id].id     = id
        self.clients[id].alive  = true
        self.len = self.len + 1
        self.mutex.unlock()
        return id
    }

    broadcast :: fn (from: u64, buf: *u8, sz: u64) u0 {
        self.mutex.lock()
        i := 0 as u64
        for i < self.len {
            if i != from {
                if self.clients[i].alive {
                    res := self.clients[i].stream.send(buf, sz)
                    if res < 0 { self.clients[i].alive = false }
                }
            }
            i :+ 1
        }
        self.mutex.unlock()
    }
}

WorkerArg :: struct {
    ctx: *Context
    id: u64
}

worker :: fn (arg: *u8) *u8 {
    w   := arg as *WorkerArg
    ctx := w.ctx
    id  := w.id

    gpa := GeneralPurposeAllocator::init()
    with _ := (&gpa).allocator() {
        buf := alloc(1024)
        out := alloc(1024)

        for {
            stream := ctx.clients[id].stream
            n := stream.recv(buf, 1023)
            if n <= 0 { break }
            buf[n] = 0

            m := libc::snprintf(out as *char, 1024, "[user %llu] %s", id, buf as *char)
            libc::printf("%s\n", out as *char)
            libc::fflush(none)

            ctx.broadcast(id, out, m as u64)
        }

        ctx.clients[id].alive = false
        ctx.clients[id].stream.close()
        libc::printf("server: client %llu disconnected\n", id)
        libc::fflush(none)
    }
    return none
}

main :: fn () i32 {
    gpa := GeneralPurposeAllocator::init()
    with _ := (&gpa).allocator() {
        listener := TcpListener::bind(8080)
        if not listener.valid() {
            libc::printf("server: failed to bind on :8080\n")
            return 1
        }
        libc::printf("server: listening on :8080\n")
        libc::fflush(none)

        ctx := Context::new(Mutex::new())

        for {
            conn := listener.accept()
            if not conn.valid() { continue }

            id := ctx.add(conn)
            libc::printf("server: client %llu connected\n", id)
            libc::fflush(none)

            arg := alloc(sizeof WorkerArg) as *WorkerArg
            arg.ctx = ctx
            arg.id  = id

            Thread::spawn(worker, arg as *u8)
        }
    }
    return 0
}
