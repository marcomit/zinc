use <core::mem>

foreign c {
    u0 printf(*char, ...)
}

struct Node {
    i32 val
    *Node left
    *Node right
}

for Node {
    pub *Node new(i32 val)(Allocator allocator) {
        *Node self = allocator.alloc(sizeof Node)
        self.val = val
        return self
    }
}

for *Node self {
    pub u0 print() {
        if not self { return }
        self.left.print()
        c::printf("%d\n", self.val)
        self.right.print()
    }

    pub u0 insert(i32 val)(Allocator _) {
        new := Node::new(val)
        cur := self
        prev := cur

        for cur {
            prev = cur
            cur =   if cur.val > val    -> cur.left
                    else                -> cur.right
        }

        if prev.val > val   -> prev.left  = new
        else                -> prev.right = new
    }

    pub u0 free()(Allocator allocator) {
        if not self { return }
        self.left.free()
        self.right.free()
        allocator.free(self)
    }
}

i32 main() {
    with _ := Allocator::heap() {
        root := Node::new(10)
        root.insert(12)
        root.insert(9)
        root.insert(11)
        root.insert(13)
        root.insert(8)

        root.print()

        root.free()
    }
    return 0
}
