libc :: foreign {
    printf :: u0 (*char, ...)
}

Expr :: enum {
    List([]i32)
    None
}

print :: u0 ([]i32 list) {
    libc::printf("%zu\n", list.len)
}

main :: i32 () {
    e := Expr::List([
        1, 2, 3, 4
    ])


    match e {
        Expr::None() -> libc::printf("none\n"),
        _ {
            libc::printf("unknown\n")
        }
    }
    return 0
}
