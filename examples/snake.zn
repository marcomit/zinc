use <std.libc>
use <std.mem>
use <std.core.rand>
use <std.mem.gpa>


rl :: foreign {
    InitWindow:         fn (i32, i32, *char) u0
    CloseWindow:        fn () u0
    SetTargetFPS:       fn (i32) u0
    WindowShouldClose:  fn () i32
    BeginDrawing:       fn () u0
    EndDrawing:         fn () u0
    ClearBackground:    fn (Color) u0
    DrawRectangleV:     fn (Rect, Color) u0
    IsKeyPressed:       fn (i32) i32
    DrawText:           fn (*char, i32, i32, i32, Color) u0
    TextFormat:         fn (*char, ...) *char
}

Color :: type u32

WIDTH :: 400
HEIGHT :: 400

BLOCK :: 20

KEY_RIGHT   :: 262
KEY_LEFT    :: 263
KEY_DOWN    :: 264
KEY_UP      :: 265

Black   :: 0xFF000000
White   :: 0xFFFFFFFF
Green   :: 0xFF00FF00
Red     :: 0xFF0000FF

#[packed]
Vec2 :: struct {
    x: f32
    y: f32
}

Vec2 :: impl {
    rand :: fn (rand: *Random) Vec2 -> .{
        x: rand.range(0, 19),
        y: rand.range(0, 19)
    }
}

Vec2 self :: impl {
    equals :: fn (other: Vec2) u1 {
        return self.x == other.x and self.y == other.y
    }

    draw :: fn (color: Color) u0 -> rl.DrawRectangleV(.{
        x: self.x * BLOCK,
        y: self.y * BLOCK,
        width: BLOCK,
        height: BLOCK
    }, color)
}

#[packed]
Rect :: struct {
    ...Vec2
    width: f32
    height: f32
}

Direction :: enum {
    Left
    Right
    Up
    Down
}

Snake :: struct {
    head: *Vec2
    len: i32
    dir: Direction
}

Snake :: impl {
    new :: fn () *Snake with Allocator {
        self: *Snake = alloc(sizeof Snake)
        self.len = 3
        self.dir = .Right()
        self.head = alloc(sizeof Vec2 * self.len)

        self.head[0] = .{x: 5, y: 10}
        self.head[1] = .{x: 4, y: 10}
        self.head[2] = .{x: 3, y: 10}
        return self
    }
}

*Snake self :: impl {
    append :: fn () u0 with Allocator {
        self.len = self.len + 1
        self.head = resize(self.head, sizeof Vec2 * self.len)
        self.head[self.len - 1] = self.head[self.len - 2]
        io.printf("append(%d)\n", self.len)
    }

    draw :: fn () u0 {
        i := 0
        for i < self.len {
            self.head[i].draw(Green)
            i: + 1
        }
    }

    change_dir :: fn (dir: Direction) u0 {
        match (dir, self.dir) {
            (.Left(), .Right()) { return },
            (.Right(), .Left()) { return },
            (.Up(), .Down())    { return },
            (.Down(), .Up())    { return }
        }
        self.dir = dir
    }

    move :: fn () u0 {
        i := self.len - 1
        for i > 0 {
            self.head[i] = self.head[i - 1]
            i: - 1
        }

        match self.dir {
            .Left() {
                self.head[0].x: - 1
            },
            .Right() {
                self.head[0].x: + 1
            },
            .Up() {
                self.head[0].y: - 1
            },
            .Down() {
                self.head[0].y: + 1
            }
        }

        self.head[0].x = (self.head[0].x + 20) % 20
        self.head[0].y = (self.head[0].y + 20) % 20
    }

    eat :: fn (apple: Vec2) u1 {
        return self.head[0].equals(apple)
    }

    collide :: fn () u1 {
        i := 1
        for i < self.len {
            if self.head[0].equals(self.head[i]) { return true }
            i: + 1
        }
        return false
    }
}

main :: fn () i32 {
    rl.InitWindow(WIDTH, HEIGHT, "Snake")
    rl.SetTargetFPS(10)

    defer rl.CloseWindow()

    gpa := GeneralPurposeAllocator.init()

    with _ := (&gpa).allocator() {
        score := 0
        snake := Snake.new()
        rand := Random.by_ref()
        apple := Vec2.rand(rand)
        for not rl.WindowShouldClose() {
            rl.BeginDrawing()
            rl.ClearBackground(Black)

            if rl.IsKeyPressed(KEY_LEFT) {
                snake.change_dir(.Left())
            } else if rl.IsKeyPressed(KEY_RIGHT) {
                snake.change_dir(.Right())
            } else if rl.IsKeyPressed(KEY_UP) {
                snake.change_dir(.Up())
            } else if rl.IsKeyPressed(KEY_DOWN) {
                snake.change_dir(.Down())
            }

            snake.move()

            apple.draw(Red)
            snake.draw()
            rl.DrawText(rl.TextFormat("%d", score), BLOCK, BLOCK, BLOCK, White)

            if snake.eat(apple) {
                apple = Vec2.rand(rand)
                snake.append()
                score: + 1
            }

            if snake.collide() { break }
            rl.EndDrawing()
        }
    }

    return 0
}
