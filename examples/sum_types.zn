c :: foreign {
    printf :: u0 (*char, ...)
}

maybeCrash :: i32 | *char | f32 (age: i32) {
    return  if age < 18 -> "invalid"
            else        ->
                if age < 1  -> 0.0 as f32
                else        -> age
}

main :: i32 () {
    val: i32 | *char | f32 = maybeCrash(18)

    match val {
        i32(num)    -> c::printf("%d\n", num),
        *char(msg)  -> c::printf("%s\n", msg),
        f32(f)      -> c::printf("%f\n", f)
    }

    if i32(num) := val {
        c::printf("%d\n", num)
    }
    return 0
}
