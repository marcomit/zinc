use <std::mem::gpa>
use <std::mem::rc>
use <std::libc>

Expr :: enum {
    Sym(*char)
    Num(f64)
    Log(*Expr)
    Add(*Expr, *Expr)
    Sub(*Expr, *Expr)
    Mul(*Expr, *Expr)
    Div(*Expr, *Expr)
}

Expr :: impl {
    new :: fn (expr: Expr) *Expr [Allocator] {
        self: *Expr = Rc::new(sizeof Expr)
        *self = expr
        return self
    }

    sym :: fn (a: *char) *Expr             [Allocator] -> Expr::new(Expr::Sym(a))
    num :: fn (n: f64) *Expr               [Allocator] -> Expr::new(Expr::Num(n))
    log :: fn (e: *Expr) *Expr             [Allocator] -> Expr::new(Expr::Log(e))
    add :: fn (l: *Expr, r: *Expr) *Expr   [Allocator] -> Expr::new(Expr::Add(l, r))
    sub :: fn (l: *Expr, r: *Expr) *Expr   [Allocator] -> Expr::new(Expr::Sub(l, r))
    mul :: fn (l: *Expr, r: *Expr) *Expr   [Allocator] -> Expr::new(Expr::Mul(l, r))
    div :: fn (l: *Expr, r: *Expr) *Expr   [Allocator] -> Expr::new(Expr::Div(l, r))
}

*Expr self :: impl {
    print :: fn () u0 {
        if not self { return }

        match *self {
            Expr::Sym(s) -> io::printf("%s", s),
            Expr::Num(n) -> io::printf("%g", n),
            Expr::Add(l, r) {
                l.print()
                io::printf(" + ")
                r.print()
            },
            Expr::Sub(l, r) {
                l.print()
                io::printf(" + ")
                r.print()
            },
            Expr::Mul(l, r) {
                l.print()
                io::printf(" * ")
                r.print()
            },
            Expr::Div(l, r) {
                l.print()
                io::printf(" / ")
                r.print()
            },
            Expr::Log(e) {
                io::printf("log(")
                e.print()
                io::printf(")")
            },
        }
    }

    derive :: fn (sym: *char) *Expr [Allocator] {
        if not self { return none }
        match *self {
            Expr::Sym(s) { return Expr::num(mem::strcmp(s, sym) as f64) },
            Expr::Num(n) { return Expr::num(0.0) },
            Expr::Add(l, r) {
                return Expr::add(l.derive(sym), r.derive(sym))
            },
            Expr::Sub(l, r) {
                return Expr::sub(l.derive(sym), r.derive(sym))
            },
            Expr::Mul(l, r) {
                return Expr::add(
                    Expr::mul(l.derive(sym), r),
                    Expr::mul(l, r.derive(sym))
                )
            },
            Expr::Div(l, r) {
                return Expr::div(
                    Expr::sub(
                        Expr::mul(l.derive(sym), r),
                        Expr::mul(l, r.derive(sym))
                    ),
                    Expr::mul(r, r)
                )
            },
            Expr::Log(e) {
                return Expr::div(Expr::num(1.0), e)
            }
        }

        io::printf("Unknown expression\n")
        return none
    }

    println :: fn () u0 {
        self.print()
        io::printf("\n")
    }
}

foreign readline :: fn (*char) *char
repl :: fn () u0 [Allocator] {
    for {
        prompt := readline(">> ")

        if not prompt { continue }
        if mem::strcmp(prompt, "exit") == 0 {
            io::printf("Goodbye by marcomit\n")
            return
        }
        io::printf("%s\n", prompt)
    }
}

main :: fn () i32 {
    gpa := GeneralPurposeAllocator::init()

    sym := "x"
    with _ := (&gpa).allocator() {
        expr := Expr::add(
            Expr::num(10.0),
            Expr::log(
                Expr::sym(sym)
            )
        )
        expr.println()
        expr.derive(sym).println()
    }

    return 0
}
