use <core::mem>
use <io::file>

foreign libc {
    u0 printf(*char, ...)
    u0 perror(*char)
}

i32 main(i32 argc, **char argv) {
    if argc != 2 {
        libc::printf("Usage: %s <filename>\n", argv[0])
        return 1
    }
    heap := Allocator::heap()
    
    f := File::new(&heap, argv[1], 0)

    if f.open(0) == -1 {
        libc::perror(none)
        return 1
    }
    defer f.close()

    content := f.readAll()
    if not content {
        libc::perror(none)
        return 1
    }
    defer (&heap).free(content)

    libc::printf(content)

    return 0
}
