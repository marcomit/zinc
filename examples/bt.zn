use <core::mem>

foreign libc {
    u0 printf(*char, ...)
}

struct Node {
    *Node left
    *Node right
}

for Node {
    *Node new(i32 depth)(Allocator allocator) {
        *Node self = allocator.alloc(sizeof Node)
        if depth == 0 {
            self.left = none
            self.right = none
        } else {
            self.left = Node::new(depth - 1)
            self.right = Node::new(depth - 1)
        }
        return self
    }
}

for *Node self {
    u64 check() {
        if not self.left { return 1 }
        return 1 + self.left.check() + self.right.check()
    }

    u0 free()(Allocator allocator) {
        if not self     { return }
        self.left.free()
        self.right.free()
        allocator.free(self)
    }
}

i32 main() {
    MAX := 18
    MIN := 64
    with _ := Allocator::heap() {
        stretch := Node::new(MAX + 1)
        libc::printf("stretch tree of depth %d\t check: %ld\n", MAX + 1, stretch.check())
        stretch.free()

        longlived := Node::new(MAX)

        depth := MIN
        for depth <= MAX {
            i32 iterations = 1 << (MAX - depth + MIN)

            u64 total = 0
            u64 i = 0
            for i < iterations {
                t := Node::new(depth)
                total := t.check()
                t.free()
                i = i + 1
            }

            libc::printf("%d\y trees of depth %d\t check: %ld\n", iterations, depth, total)

            depth = depth + 2
        }
        libc::printf("long lived tree of depth %ld\t check %ld\n", MAX, longlived.check())
        longlived.free()
    }
}
