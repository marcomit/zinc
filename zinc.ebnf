source_file = { declaration } ;

declaration =
    { attribute } [ "pub" ]
    (
        struct_declaration  |
        enum_declaration    |
        type_alias          |
        facet_declaration   |
        foreign_block       |
        foreign_func        |
        func_block          |
        func_decl           |
        import_decl         |
        constant_declaration ) ;

attribute = "#" "[" attribute_item { "," attribute_item } [ "," ] "]" ;

attribute_item = identifier [ "(" [ attribute_arg { "," attribute_arg } ] ")" ] ;

attribute_arg = identifier | operator | literal ;

import_decl =
    "use" (
        "<" module_path ">" | module_path
    ) ;

module_path = identifier { "::" identifier } ;

struct_declaration =
    identifier [ comptime_params ] "::" "struct" "{" { struct_member } "}" ;

struct_member = field_declaration | struct_embed ;

field_declaration =
    field_type identifier
  | identifier ":" field_type ;

struct_embed = "..." type ;

enum_declaration =
    identifier [ comptime_params ] "::" "enum" "{" { enum_variant } "}" ;

enum_variant =
    { attribute } identifier
    [ "(" [ field_type { "," field_type } ] ")" ] ;

type_alias = identifier "::" "type" field_type ;

constant_declaration = identifier "::" literal ;

foreign_block = identifier "::" "foreign" "{" { foreign_signature } "}" ;

foreign_signature = identifier "::" type parameter_list ;

foreign_func = "foreign" identifier "::" type parameter_list ;

facet_declaration =
    identifier [ comptime_params ] "::" "facet" "{" { func_decl } "}" ;

func_block =
    type [ identifier ] "::" "impl" [ facet_name ] "{" { func_decl } "}" ;

facet_name = type_identifier | generic_type ;

func_decl =
    { attribute } [ "pub" ]
    identifier [ comptime_params ] "::"
    field_type
    parameter_list
    [ capability_list ]
    func_body ;

func_body = block | "->" expression ;

comptime_params = "[" comptime_param { "," comptime_param } [ "," ] "]" ;

comptime_param = identifier [ "::" kind ] ;

kind =
    "type"
  | facet_name
  | field_type ;

parameter_list = "(" [
        parameter_or_variadic
        { "," parameter_or_variadic }
        [ "," ]
    ] ")" ;

parameter_or_variadic = parameter | "..." ;

parameter =
    field_type identifier
  | identifier ":" field_type
  | field_type ;

capability_list = "[" capability { "," capability } [ "," ] "]" ;

capability =
    field_type [ identifier ]
  | identifier ":" field_type ;

field_type = type | sum_type ;

type =
    primitive_type  |
    pointer_type    |
    slice_type      |
    tuple_type      |
    grouped_type    |
    generic_type    |
    func_type       |
    type_identifier ;

sum_type = type "|" type { "|" type } ;

grouped_type = "(" field_type ")" ;

func_type = type "(" [ type { "," type } ] ")" ;

primitive_type =
    "u0"    |
    "u1"    |
    "u8"    |
    "i8"    |
    "u16"   |
    "i16"   |
    "u32"   |
    "i32"   |
    "u64"   |
    "i64"   |
    "f32"   |
    "f64"   |
    "char"  |
    "rune"  ;

pointer_type = "*" type ;

slice_type = "[" [ expression ] "]" type ;

tuple_type = "(" type "," type { "," type } ")" ;

generic_type =
    type_identifier "[" comptime_arg { "," comptime_arg } [ "," ] "]" ;

comptime_arg = type | expression ;

type_identifier = identifier ;

block = "{" { statement } "}" ;

statement
    = local_declaration
    | variable_declaration
    | update_statement
    | for_statement
    | match_statement
    | with_statement
    | return_statement
    | defer_statement
    | break_statement
    | continue_statement
    | comptime_statement
    | expression_statement
    | block ;

local_declaration
    = struct_declaration
    | enum_declaration
    | type_alias
    | foreign_block ;

variable_declaration
    = field_type identifier [ "=" expression ]
    | identifier ":" field_type [ "=" expression ]
    | identifier "::" expression
    | binding ":=" expression ;

binding
    = identifier
    | tuple_destructure
    | struct_destructure ;

tuple_destructure
    = "("
        binding ","
        binding
        { "," binding }
        [ "," ]
      ")" ;

struct_destructure
    = "{"
        struct_destructure_field
        { "," struct_destructure_field }
        [ "," ]
      "}" ;

struct_destructure_field
    = identifier [ ":" identifier ] ;

update_statement
    = expression ":" update_tail ;

update_tail
    = "." identifier
    | ( "not" | "!" | "~" )
    | binary_operator expression
    | expression ;

comptime_statement
    = "comptime" ( block | for_statement | if_expression | expression_statement ) ;

expression_statement
    = expression ;

for_statement
    = "for"
      [ c_style_for_header | for_in_header | condition ]
      block ;

for_in_header = ( binding | enum_pattern | type_pattern ) "in" expression ;

c_style_for_header
    = ( variable_declaration | expression )
      ";"
      expression
      ";"
      expression ;

condition
    = let_condition
    | expression ;

let_condition
    = match_pattern ":=" expression ;

match_statement
    = "match"
      expression
      "{"
        { match_arm }
      "}" ;

match_arm
    = match_pattern
      (
          "->" expression
        | block
      )
      [ "," ] ;

with_statement
    = "with"
      ( let_condition | expression )
      block ;

return_statement
    = "return" [ expression ] ;

defer_statement
    = "defer" expression ;

break_statement
    = "break" ;

continue_statement
    = "continue" ;

match_pattern
    = enum_pattern
    | type_pattern
    | tuple_pattern
    | literal
    | identifier ;

type_pattern
    = type "(" [ match_pattern { "," match_pattern } [ "," ] ] ")" ;

enum_pattern
    = scoped_identifier
      [ "("
            [
                match_pattern
                { "," match_pattern }
                [ "," ]
            ]
        ")" ] ;

tuple_pattern
    = "("
        match_pattern ","
        match_pattern
        { "," match_pattern }
        [ "," ]
      ")" ;

expression
    = assignment_expression ;

assignment_expression
    = coalesce_expression
    | coalesce_expression "=" assignment_expression ;

coalesce_expression
    = logical_or_expression
    | logical_or_expression "??" coalesce_expression ;

logical_or_expression
    = logical_and_expression
    | logical_or_expression
      ( "or" | "||" )
      logical_and_expression ;

logical_and_expression
    = bitwise_or_expression
    | logical_and_expression
      ( "and" | "&&" )
      bitwise_or_expression ;

bitwise_or_expression
    = bitwise_xor_expression
    | bitwise_or_expression "|"
      bitwise_xor_expression ;

bitwise_xor_expression
    = bitwise_and_expression
    | bitwise_xor_expression "^"
      bitwise_and_expression ;

bitwise_and_expression
    = equality_expression
    | bitwise_and_expression "&"
      equality_expression ;

equality_expression
    = relational_expression
    | equality_expression
      ( "==" | "!=" )
      relational_expression ;

relational_expression
    = shift_expression
    | relational_expression
      ( "<" | ">" | "<=" | ">=" )
      shift_expression ;

shift_expression
    = additive_expression
    | shift_expression
      ( "<<" | ">>" )
      additive_expression ;

additive_expression
    = multiplicative_expression
    | additive_expression
      ( "+" | "-" )
      multiplicative_expression ;

multiplicative_expression
    = cast_expression
    | multiplicative_expression
      ( "*" | "/" | "%" )
      cast_expression ;

cast_expression
    = unary_expression
    | unary_expression "as" type ;

unary_expression
    = postfix_expression
    | ( "-" | "+" | "!" | "not" | "~" | "*" | "&" )
      unary_expression
    | sizeof_expression
    | comptime_expression ;

sizeof_expression
    = "sizeof" field_type ;

comptime_expression
    = "comptime" unary_expression ;

postfix_expression
    = primary_expression
      {
          argument_list
        | "[" ( expression | slice ) "]"
        | "." identifier
        | "?"
      } ;

primary_expression
    = identifier
    | scoped_identifier
    | literal
    | if_expression
    | struct_literal
    | array_literal
    | tuple_literal
    | parenthesized_expression ;

if_expression
    = "if"
      condition
      if_branch
      [ "else" ( if_expression | if_branch ) ] ;

if_branch
    = block
    | "->" expression ;

scoped_identifier
    = identifier "::"
      identifier
      { "::" identifier } ;

parenthesized_expression
    = "(" expression ")" ;

tuple_literal
    = "("
        expression ","
        expression
        { "," expression }
        [ "," ]
      ")" ;

array_literal
    = "["
        [
            expression
            { "," expression }
            [ "," ]
        ]
      "]" ;

struct_literal
    = ( identifier | generic_type )
      field_initializer_list ;

field_initializer_list
    = "{"
        [
            field_initializer
            { "," field_initializer }
            [ "," ]
        ]
      "}" ;

field_initializer
    = identifier ":" expression ;

argument_list
    = "("
        [
            expression
            { "," expression }
            [ "," ]
        ]
      ")" ;

slice
    = [ expression ]
      ":"
      [ expression ] ;

binary_operator
    = "+" | "-" | "*" | "/" | "%"
    | "&" | "|" | "^" | "<<" | ">>"
    | "and" | "or" | "&&" | "||"
    | "==" | "!=" | "<" | ">" | "<=" | ">=" ;

operator
    = binary_operator
    | "!" | "not" | "~" | "??" | "=" ;

literal
    = int_literal
    | float_literal
    | string_literal
    | rune_literal
    | bool_literal
    | none_literal ;

bool_literal
    = "true"
    | "false" ;

none_literal
    = "none" ;

identifier
    = letter { letter | digit | "_" } ;

int_literal
    = decimal_literal
    | hexadecimal_literal
    | binary_literal ;

float_literal
    = digit { digit }
      "."
      { digit }
      [ exponent ] ;

decimal_literal
    = digit { digit } ;

hexadecimal_literal
    = "0x"
      hexadecimal_digit
      { hexadecimal_digit } ;

binary_literal
    = "0b"
      binary_digit
      { binary_digit } ;

string_literal
    = "\""
      { string_character }
      "\"" ;

rune_literal
    = "'"
      { rune_character }
      "'" ;

exponent
    = ( "e" | "E" )
      [ "+" | "-" ]
      digit
      { digit } ;

letter
    = "a"..."z"
    | "A"..."Z"
    | "_" ;

digit
    = "0"..."9" ;

binary_digit
    = "0" | "1" ;

hexadecimal_digit
    = digit
    | "a"..."f"
    | "A"..."F" ;

string_character
    = ? any non-quote character or escaped sequence ? ;

rune_character
    = ? any non-quote character or escaped sequence ? ;

comment
    = "//" { ? any character except newline ? }
    | "/*" { ? comment content ? } "*/" ;
