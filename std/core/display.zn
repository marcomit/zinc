use <std.libc>

#lang(writer)
pub Writer :: facet {
    write: fn (*u8, usize) isize
}

pub Reader :: facet {
    read: fn (*u8, usize) u0
}

#lang(writable)
pub Writable :: facet {
    sink: fn (Writer) u0
}

Writer self :: impl {
    pub fmt :: fn (items: []InterpolatedString) {
        interpolate(self, items)
    }

    pub write_all :: fn (buff: *u8, len: usize) {
        wrote: isize = 0

        for wrote = self.write(buff[wrote].&, len) #allow_empty {

        }
    }
}

/*
#lang(format_spec)
pub FmtSpec :: enum {
}*/

#lang(interpolated_string)
pub InterpolatedString :: enum {
    Literal([]char)
    Obj(Writable)
}

pub FDWriter :: struct {
    fd: i32
}

*FDWriter self :: impl(Writer) {
    pub write :: fn (buff: *u8, size: usize) isize {
        return sys.write(self.fd, buff, size)
    }
}

#inline pub interpolate :: fn (w: Writer, items: []InterpolatedString) {
    for item in items do match item {
        .Literal(chars) -> w.write(chars, chars.len),
        .Obj(obj)       -> obj.sink(w)
    }
}

#inline
pub sink_char :: fn (w: Writer, c: char) {
    w.write(&c, 1)
}

pub sink_int :: fn (w: Writer, num: i64) {
    buff: [32]char
    bytes := io.snprintf(buff.ptr, 31, "%d", num)
    w.write(buff.ptr, bytes)
}

pub sink_bool :: fn (w: Writer, b: u1) {
    buff: [32]char
    bytes := io.snprintf(buff.ptr, 31, "%s", if b do "true".ptr else "false".ptr)
    w.write(buff.ptr, bytes)
}

pub sink_float :: fn (w: Writer, num: f64) {
    buff: [32]char
    bytes := io.snprintf(buff.ptr, 31, "%f", num)
    w.write(buff.ptr, bytes)
}

pub sink_str :: fn (w: Writer, str: []char) {
    w.write(str.ptr, str.len)
}

pub sink_cstr :: fn (w: Writer, str: *char) {
    w.write(str, mem.strlen(str))
}

#inline pub print :: fn (items: []InterpolatedString) {
    stdout := Writer(FDWriter{fd=1}.&)
    interpolate(stdout, items)
}

#inline pub println :: fn (items: []InterpolatedString) {
    stdout := Writer(FDWriter{fd=1}.&)
    interpolate(stdout, items)
    stdout.write("\n", 1)
}

*char self :: impl(Writable) {
    sink :: fn (w: Writer) {
        w.write(self, mem.strlen(self))
    }
}
