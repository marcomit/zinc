DEFAULT_DYNAMIC_ARRAY_CAPACITY :: 16

RawDynamicArray :: struct {
    len: usize
    cap: usize
    allocator: Allocator
    buff: *u8
}

*RawDynamicArray self :: impl {
    make_room :: fn (size: usize) with Allocator {
        if not self return

        newcap := self.cap
        if not newcap do newcap = DEFAULT_DYNAMIC_ARRAY_CAPACITY

        for self.len + size >= newcap {
            newcap *= 2
        }

        if newcap != self.cap {
            self.buff = resize(self.buff, newcap)
            self.cap = newcap
        }
    }
}

pub make_room :: fn (list: *[..]char, size: usize) with Allocator {
    items: *RawDynamicArray = list
    items.make_room(size)
}

User :: struct {
    name: []char
    age: i32
}

*User self :: impl(Writable) {
    sink :: fn (w: Writer) {
        sink_str(w, self.name)
        sink_int(w, self.age)
    }
}

append_user :: fn (users: *[..]User, user: User) with Allocator {
    make_room(users.&, sizeof User)

    users.*[users.len-1] = user
}

main :: fn () i32 {
    with _ := GeneralPurposeAllocator.new() {
        users: [..]User

        append_user(&users, .{name="marco", age=21 })
        append_user(&users, .{name="carlo", age=21 })
        append_user(&users, .{name="lucia", age=21 })
        append_user(&users, .{name="prrr", age=25 })

        for user in users {
            println(#"User: {&user}")
        }
    }
    return 0
}
