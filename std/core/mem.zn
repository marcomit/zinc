c :: foreign {
    malloc :: *u8(u64)
    realloc :: *u8(*u8, u64)
    free :: u0(*u8)
}

pub Allocator :: struct {
    u64             bytes
    *u8(u64)        alloc
    *u8(*u8, u64)   realloc
    u0(*u8)         free
}

Allocator :: impl {
    pub heap :: Allocator() {
        return Allocator{
            bytes: 0,
            alloc: c::malloc,
            realloc: c::realloc,
            free: c::free
        }
    }
}

pub alloc :: *u8 (u64 size)[Allocator allocator] {
    return allocator.alloc(size)
}

pub resize :: *u8 (*u8 ptr, u64 size)[Allocator allocator] {
    return allocator.realloc(ptr, size)
}

pub destroy :: u0 (*u8 ptr)[Allocator allocator] {
    allocator.free(ptr)
}
