c :: foreign {
    malloc :: *u8(u64)
    realloc :: *u8(*u8, u64)
    free :: u0(*u8)
}

pub Allocator :: struct {
    bytes:      u64
    alloc:      *u8(u64)
    realloc:    *u8(*u8, u64)
    free:       u0(*u8)
}

Allocator :: impl {
    pub heap :: Allocator() {
        return Allocator{
            bytes: 0,
            alloc: c::malloc,
            realloc: c::realloc,
            free: c::free
        }
    }
}

#[inline(always)]
pub alloc :: *u8 (size: u64)[allocator: Allocator] {
    return allocator.alloc(size)
}

#[inline(always)]
pub resize :: *u8 (ptr: *u8, size: u64)[allocator: Allocator] {
    return allocator.realloc(ptr, size)
}

#[inline(always)]
pub destroy :: u0 (ptr: *u8)[allocator: Allocator] {
    allocator.free(ptr)
}
