c :: foreign {
    printf :: u0 (*char, ...)
    putchar :: i32 (i32)
    strlen :: u64 (*char)
    strcmp :: i32 (*char, *char)
    strncmp :: i32 (*char, *char, u64)
    strcpy :: *u8(*u8, *char)
    strcat :: *u8 (*u8, *char)
    strstr :: *char (*char, *char)
    malloc :: *u8 (u64)
}

pub String :: struct {
    *char data
    u64   len
}

String :: for {
    pub from :: String (*char s) -> String { data: s, len: c::strlen(s) }

    pub withCapacity :: String (u64 cap) {
        *char buf = c::malloc(cap + 1)
        return String { data: buf, len: 0 }
    }

    pub concat :: String (*char a, *char b) {
        u64 total = c::strlen(a) + c::strlen(b)
        buf := c::malloc(total + 1)
        c::strcpy(buf, a)
        c::strcpy(buf, b)

        return String {
            data: buf,
            len: total
        }
    }
}

String self :: for {
    pub len :: u64 () -> self.len

    pub isEmpty :: u1 () -> self.len == 0

    pub print :: u0 () -> c::printf(self.data)

    pub println :: u0 () -> c::printf("%s\n", self.data)

    pub eq :: u1 (*char other) -> c::strcmp(self.data, other) == 0

    pub neq :: u1 (*char other) -> c::strcmp(self.data, other) != 0

    pub startsWith :: u1 (*char prefix) {
        u64 plen = c::strlen(prefix)
        if plen > self.len {
            return false
        }

        return c::strncmp(self.data, prefix, plen) == 0
    }

    pub contains :: u1 (*char other) {
        *char found = c::strstr(self.data, other)
        if not found { return false }
        return true
    }

    pub append :: String (*char other) {
        u64 total = c::strlen(other) + self.len

        buf := c::malloc(total + 1)

        c::strcpy(buf, self.data)
        c::strcat(buf, other)

        return String {
            data: buf,
            len: total
        }
    }

    pub clone :: String () {
        buf := c::malloc(self.len + 1)
        c::strcpy(buf, self.data)

        return String {
            data: buf,
            len: self.len
        }
    }
}
