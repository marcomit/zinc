use <std::core::mem>
use <std::libc>

#[packed]
SdsHdr :: struct {
    len:    u32
    alloc:  u32
}

pub string :: type *char

string :: impl {
    make :: string (init: *char, initlen: u32, cap: u32)[Allocator] {
        sh := alloc(sizeof SdsHdr + cap + 1) as *SdsHdr
        if not sh { return none }

        sh.len   = initlen
        sh.alloc = cap

        base := sh as *u8
        s := (&(base[sizeof SdsHdr])) as string

        if initlen > 0 and init != none {
            mem::memcpy(s as *u8, init as *u8, initlen as u64)
        }
        s[initlen] = 0 as char
        return s
    }

    pub new :: string (init: *char)[Allocator] {
        l: u32 = 0
        if init != none { l = mem::strlen(init) as u32 }
        return string::make(init, l, l)
    }

    pub empty :: string ()[Allocator] {
        return string::make(none, 0, 0)
    }

    pub with_capacity :: string (cap: u32)[Allocator] {
        return string::make(none, 0, cap)
    }
}

string self :: impl {
    #[inline]
    header :: *SdsHdr () {
        off: i64 = 0 - (sizeof SdsHdr) as i64
        return (&(self[off])) as *SdsHdr
    }

    make_room_for :: string (addlen: u32)[Allocator] {
        if not self { return none }

        hdr := self.header()
        available := hdr.alloc - hdr.len
        if available >= addlen { return self }

        newlen := hdr.len + addlen
        newalloc := newlen
        if newalloc < 32 {
            newalloc = 32
        } else {
            newalloc :* 2
        }

        new_sh := resize(hdr, sizeof SdsHdr + newalloc + 1) as *SdsHdr
        if not new_sh { return none }

        new_sh.alloc = newalloc
        new_base := new_sh as *u8
        return (&(new_base[sizeof SdsHdr])) as string
    }

    pub len :: u32 () {
        if not self { return 0 }
        hdr := self.header()
        return hdr.len
    }

    pub cap :: u32 () {
        if not self { return 0 }
        hdr := self.header()
        return hdr.alloc
    }

    pub avail :: u32 () {
        if not self { return 0 }
        hdr := self.header()
        return hdr.alloc - hdr.len
    }

    pub is_empty :: u1 () -> self.len() == 0

    pub append :: string (t: *char)[Allocator] {
        if not t { return self }

        tlen := mem::strlen(t) as u32
        if tlen == 0 { return self }

        s := self.make_room_for(tlen)
        if not s { return none }

        hdr := s.header()
        dst := s as *u8
        mem::memcpy(&(dst[hdr.len]), t as *u8, tlen as u64)

        hdr.len :+ tlen
        s[hdr.len] = 0 as char
        return s
    }

    pub append_str :: string (other: string)[Allocator] {
        return self.append(other)
    }

    pub append_char :: string (ch: char)[Allocator] {
        s := self.make_room_for(1)
        if not s { return none }

        hdr := s.header()
        s[hdr.len] = ch
        hdr.len :+ 1
        s[hdr.len] = 0 as char
        return s
    }

    pub dup :: string ()[Allocator] {
        if not self { return none }
        hdr := self.header()
        return string::make(self, hdr.len, hdr.len)
    }

    pub clear :: u0 () {
        if not self { return }
        hdr := self.header()
        hdr.len = 0
        self[0] = 0 as char
    }

    pub cmp :: i32 (other: *char) {
        return mem::strcmp(self, other)
    }

    #[overload(==)]
    pub equals :: u1 (other: *char) {
        return mem::strcmp(self, other) == 0
    }

    pub starts_with :: u1 (prefix: *char) {
        plen := mem::strlen(prefix)
        return mem::strncmp(self, prefix, plen) == 0
    }

    pub contains :: u1 (needle: *char) {
        return mem::strstr(self, needle) != none
    }

    pub print :: u0 () {
        libc::printf("%s", self)
    }

    pub println :: u0 () {
        libc::printf("%s\n", self)
    }

    pub free :: u0 ()[Allocator] {
        if not self { return }
        destroy(self.header())
    }
}
