foreign c {
    u0      printf(*char, ...)
    i32     putchar(i32)
    u64     strlen(*char)
    i32     strcmp(*char, *char)
    i32     strncmp(*char, *char, u64)
    *u8     strcpy(*u8, *char)
    *u8     strcat(*u8, *char)
    *char   strstr(*char, *char)
    *u8     malloc(u64)
}

pub struct String {
    *char data
    u64   len
}

for String {
    pub String from(*char s) -> String { data: s, len: c::strlen(s) }

    pub String withCapacity(u64 cap) {
        *char buf = c::malloc(cap + 1)
        return String { data: buf, len: 0 }
    }

    pub String concat(*char a, *char b) {
        u64 total = c::strlen(a) + c::strlen(b)
        buf := c::malloc(total + 1)
        c::strcpy(buf, a)
        c::strcpy(buf, b)

        return String {
            data: buf,
            len: total
        }
    }
}

for String self {
    pub u64 len() -> self.len

    pub u1 isEmpty() -> self.len == 0

    pub u0 print() -> c::printf(self.data)

    pub u0 println() -> c::printf("%s\n", self.data)

    pub u1 eq(*char other) -> c::strcmp(self.data, other) == 0

    pub u1 neq(*char other) -> c::strcmp(self.data, other) != 0

    pub u1 startsWith(*char prefix) {
        u64 plen = c::strlen(prefix)
        if plen > self.len {
            return false
        }

        return c::strncmp(self.data, prefix, plen) == 0
    }

    pub u1 contains(*char other) {
        *char found = c::strstr(self.data, other)
        if not found { return false }
        return true
    }

    pub String append(*char other) {
        u64 total = c::strlen(other) + self.len

        buf := c::malloc(total + 1)

        c::strcpy(buf, self.data)
        c::strcat(buf, other)

        return String {
            data: buf,
            len: total
        }
    }

    pub String clone() {
        buf := c::malloc(self.len + 1)
        c::strcpy(buf, self.data)

        return String {
            data: buf,
            len: self.len
        }
    }
}
