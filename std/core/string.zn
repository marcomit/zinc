use <core::mem>

c :: foreign {
    printf  :: u0    (*char, ...)
    strlen  :: u64   (*char)
    strcmp  :: i32   (*char, *char)
    strncmp :: i32   (*char, *char, u64)
    strstr  :: *char (*char, *char)
}

pub String :: struct {
    *char data
    u64   len
}

copyinto :: u0 (*char dst, u64 off, *char src, u64 n) {
    i := 0 as u64
    for i < n {
        dst[off + i] = src[i]
        i :+ 1
    }
}

String :: for {
    pub from :: String (*char s) -> String { data: s, len: c::strlen(s) }

    pub withCapacity :: String (u64 cap)[Allocator] {
        buf := alloc(cap + 1) as *char
        buf[0] = 0 as char
        return String { data: buf, len: 0 }
    }

    pub concat :: String (*char a, *char b)[Allocator] {
        alen  := c::strlen(a)
        blen  := c::strlen(b)
        total := alen + blen

        buf := alloc(total + 1) as *char
        copyinto(buf, 0, a, alen)
        copyinto(buf, alen, b, blen)
        buf[total] = 0 as char

        return String { data: buf, len: total }
    }
}

String self :: for {
    pub isEmpty :: u1 () -> self.len == 0

    pub print :: u0 () -> c::printf("%s", self.data)

    pub println :: u0 () -> c::printf("%s\n", self.data)

    pub at :: char (u64 index) {
        if index >= self.len { return 0 as char }
        return self.data[index]
    }

    pub indexOf :: i64 (char c) {
        i := 0 as u64
        for i < self.len {
            if self.data[i] == c { return i as i64 }
            i :+ 1
        }
        return -1
    }

    pub contains :: u1 (*char other) -> c::strstr(self.data, other) != none

    pub startsWith :: u1 (*char prefix) {
        plen := c::strlen(prefix)
        if plen > self.len { return false }
        return c::strncmp(self.data, prefix, plen) == 0
    }

    pub endsWith :: u1 (*char suffix) {
        slen := c::strlen(suffix)
        if slen > self.len { return false }

        off := self.len - slen
        i := 0 as u64
        for i < slen {
            if self.data[off + i] != suffix[i] { return false }
            i :+ 1
        }
        return true
    }

    pub equals :: u1 (*char other) -> c::strcmp(self.data, other) == 0

    #[overload(==)]
    pub eq :: u1 (String other) {
        if self.len != other.len { return false }
        return c::strncmp(self.data, other.data, self.len) == 0
    }

    #[overload(+)]
    pub append :: String (*char other)[Allocator] {
        olen  := c::strlen(other)
        total := self.len + olen

        buf := alloc(total + 1) as *char
        copyinto(buf, 0, self.data, self.len)
        copyinto(buf, self.len, other, olen)
        buf[total] = 0 as char

        return String { data: buf, len: total }
    }

    pub substring :: String (u64 start, u64 end)[Allocator] {
        s := start
        e := end
        if s > self.len { s = self.len }
        if e > self.len { e = self.len }
        if e < s { e = s }

        n := e - s
        buf := alloc(n + 1) as *char
        i := 0 as u64
        for i < n {
            buf[i] = self.data[s + i]
            i :+ 1
        }
        buf[n] = 0 as char

        return String { data: buf, len: n }
    }

    pub clone :: String ()[Allocator] {
        buf := alloc(self.len + 1) as *char
        copyinto(buf, 0, self.data, self.len)
        buf[self.len] = 0 as char
        return String { data: buf, len: self.len }
    }

    pub drop :: u0 ()[Allocator] {
        free(self.data as *u8)
    }
}
