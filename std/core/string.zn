#import "std/mem"
#import "std/libc"
#import "list"
#import "display"

pub string :: type [..]char

string :: impl {
    #inline
    pub new :: fn (lit: []char) string with Allocator {
        res: string
        make_room(&res, lit.len, sizeof char)
        res.len += lit.len
        mem.memcpy(res.ptr, lit.ptr, lit.len)
        return res
    }

    #inline
    pub from_len :: fn (ptr: *char, len: usize) string with Allocator {
        res: string
        make_room(&res, len, sizeof char)
        res.len += len
        mem.memcpy(res.ptr, ptr, len)
        return res
    }

    #inline
    pub from_cstr :: fn (ptr: *char) string with Allocator {
        return string.from_len(ptr, mem.strlen(ptr))
    }

    #inline
    pub with_capacity :: fn (capacity: usize) string with Allocator {
        res: string
        make_room(&res, capacity, sizeof char)
        return res
    }
}

string self :: impl {
    pub equals :: fn (other: string) bool {
        return mem.strcmp(self.ptr, other.ptr) == 0
    }
}

*string self :: impl(Writable) {
    pub sink :: fn (w: Writer) {
        w.write(self.ptr, self.len)
    }
}

STRING_INITIAL_CAPACITY :: 8
pub StringBuilder :: struct {
    allocator: Allocator
    buff: ?*char
    len: usize
    cap: usize
}

StringBuilder :: impl {
    pub new :: fn () *StringBuilder with a: Allocator {
        self: *StringBuilder    = alloc(sizeof StringBuilder) as *StringBuilder
        self.buff               = none
        self.len                = 0
        self.cap                = 0
        self.allocator = a
        return self
    }
}

*StringBuilder self :: impl {
    pub to_writer :: fn () Writer -> self

    pub to_string :: fn () string {
        res: [..]char
        with _ := self.allocator {
            make_room(&res, self.len + 1, sizeof char)
            mem.memcpy(res.ptr, self.buff as *u8, self.len)
            res.len += self.len + 1
            res[res.len - 1] = 0
        }
        return res
    }

    pub append_buff :: fn (buff: *u8, len: usize) {
        with _ := self.allocator {
            if not self.cap do self.cap = STRING_INITIAL_CAPACITY
            newcap := self.cap
            for self.len + len >= newcap {
                newcap *= 2
            }

            if not self.buff {
                self.buff = alloc(self.cap)
            } else if self.cap != newcap {
                self.cap = newcap
                self.buff = resize(self.buff, self.cap)
            }

            dst := self.buff as *u8
            mem.memcpy(dst[self.len].&, buff, len)
            self.len += len
        }
    }
    pub append :: fn (strlit: []char) {
        self.append_buff(strlit, strlit.len)
    }

    pub append_char :: fn (c: char) {
        self.append_buff(&c, 1)
    }
}

*StringBuilder self :: impl(Writer) {
    write :: fn (buff: *u8, len: usize) {
        with _ := self.allocator {
            self.append_buff(buff, len)
        }
    }
}

#[inline]
pub sprint :: fn (items: []InterpolatedString) string with Allocator {
    res := StringBuilder.new()
    interpolate(res.to_writer(), items)
    return res.to_string()
}
