use <std::mem>
use <std::libc>

#[packed]
SdsHdr :: struct {
    len:    u32
    alloc:  u32
}

pub string :: type *char

string :: impl {
    make :: fn (init: *char, initlen: u32, cap: u32) string with Allocator {
        sh := alloc(sizeof SdsHdr + cap + 1) as *SdsHdr
        if not sh { return none }

        sh.len   = initlen
        sh.alloc = cap

        base := sh as *u8
        s := (&(base[sizeof SdsHdr])) as string

        if initlen > 0 and init != none {
            mem::memcpy(s as *u8, init as *u8, initlen as u64)
        }
        s[initlen] = 0 as char
        return s
    }

    pub new :: fn (init: *char) string with Allocator {
        l: u32 = 0
        if init != none { l = mem::strlen(init) as u32 }
        return string::make(init, l, l)
    }

    pub empty :: fn () string with Allocator {
        return string::make(none, 0, 0)
    }

    pub with_capacity :: fn (cap: u32) string with Allocator {
        return string::make(none, 0, cap)
    }
}

string self :: impl {
    #[inline]
    header :: fn () *SdsHdr {
        off: i64 = 0 - (sizeof SdsHdr) as i64
        return (&(self[off])) as *SdsHdr
    }

    make_room_for :: fn (addlen: u32) string with Allocator {
        if not self { return none }

        hdr := self.header()
        available := hdr.alloc - hdr.len
        if available >= addlen { return self }

        newlen := hdr.len + addlen
        newalloc := newlen
        if newalloc < 32 {
            newalloc = 32
        } else {
            newalloc :* 2
        }

        new_sh := resize(hdr, sizeof SdsHdr + newalloc + 1) as *SdsHdr
        if not new_sh { return none }

        new_sh.alloc = newalloc
        new_base := new_sh as *u8
        return (&(new_base[sizeof SdsHdr])) as string
    }

    pub len :: fn () u32 {
        if not self { return 0 }
        hdr := self.header()
        return hdr.len
    }

    pub cap :: fn () u32 {
        if not self { return 0 }
        hdr := self.header()
        return hdr.alloc
    }

    pub avail :: fn () u32 {
        if not self { return 0 }
        hdr := self.header()
        return hdr.alloc - hdr.len
    }

    pub is_empty :: fn () u1 -> self.len() == 0

    pub append :: fn (t: *char) string with Allocator {
        if not t { return self }

        tlen := mem::strlen(t) as u32
        if tlen == 0 { return self }

        s := self.make_room_for(tlen)
        if not s { return none }

        hdr := s.header()
        dst := s as *u8
        mem::memcpy(&(dst[hdr.len]), t as *u8, tlen as u64)

        hdr.len :+ tlen
        s[hdr.len] = 0 as char
        return s
    }

    pub append_str :: fn (other: string) string with Allocator {
        return self.append(other)
    }

    pub append_char :: fn (ch: char) string with Allocator {
        s := self.make_room_for(1)
        if not s { return none }

        hdr := s.header()
        s[hdr.len] = ch
        hdr.len :+ 1
        s[hdr.len] = 0 as char
        return s
    }

    pub dup :: fn () string with Allocator {
        if not self { return none }
        hdr := self.header()
        return string::make(self, hdr.len, hdr.len)
    }

    pub clear :: fn () u0 {
        if not self { return }
        hdr := self.header()
        hdr.len = 0
        self[0] = 0 as char
    }

    pub cmp :: fn (other: *char) i32 {
        return mem::strcmp(self, other)
    }

    // #[overload(==)]
    pub equals :: fn (other: *char) u1 {
        return mem::strcmp(self, other) == 0
    }

    pub starts_with :: fn (prefix: *char) u1 {
        plen := mem::strlen(prefix)
        return mem::strncmp(self, prefix, plen) == 0
    }

    pub contains :: fn (needle: *char) u1 {
        return mem::strstr(self, needle) != none
    }

    pub print :: fn () u0 {
        io::printf("%s", self)
    }

    pub println :: fn () u0 {
        io::printf("%s\n", self)
    }

    pub free :: fn () u0 with Allocator {
        if not self { return }
        destroy(self.header())
    }
}
