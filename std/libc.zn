pub io :: foreign {
    printf:     fn (*char, ...) u0
    putchar:    fn (i32)       i32
    perror:     fn (*char)      u0
    exit:       fn (i32)        u0
}
pub mem :: foreign {
    memset  : fn (*u8, i32, u64)        *u8
    memcpy  : fn (*u8, *u8, u64)        *u8
    strlen  : fn (*char)                u64
    strcmp  : fn (*char, *char)         i32
    strncmp : fn (*char, *char, u64)    i32
    strstr  : fn (*char, *char)         *char
}

pub math :: foreign {
    sin:    fn (f64)      f64
    cos:    fn (f64)      f64
    tan:    fn (f64)      f64
    atan:   fn (f64)      f64
    atan2:  fn (f64, f64) f64
    sqrt:   fn (f64)      f64
    fabs:   fn (f64)      f64
    pow:    fn (f64, f64) f64
    exp:    fn (f64)      f64

    sinf:   fn (f32)      f32
    cosf:   fn (f32)      f32
    tanf:   fn (f32)      f32
    atanf:  fn (f32)      f32 
    atan2f: fn (f32, f32) f32 
    sqrtf:  fn (f32)      f32 
    fabsf:  fn (f32)      f32 
    powf:   fn (f32, f32) f32 
    expf:   fn (f32)      f32 
}
