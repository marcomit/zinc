use <std.mem.gpa>
use <std.core.list>

JsonMapEntry :: struct {
    key:    *char
    value:  *Json
}

pub Json :: enum {
    Num(f64)
    Bool(u1)
    Str(*char)
    List([..]*Json)
    Map([..]JsonMapEntry)
    None
}

pub json_num :: fn (num: f64) *Json with Allocator {
    self: *Json = alloc(sizeof Json)
    self.* = .Num(num)
    return self
}

pub json_bool :: fn (val: u1) *Json with Allocator {
    self := alloc(sizeof Json) as *Json
    self.* = .Bool(val)

    return self
}

pub json_str :: fn (val: *char) *Json with Allocator {
    self: *Json = alloc(sizeof Json)
    self.* = .Str(val)
    return self
}

pub json_list :: fn (values: [..]*Json) *Json with Allocator {
    self: *Json = alloc(sizeof *Json)
    self.* = .List(values)
    return self
}

pub json_map :: fn (entries: [..]JsonMapEntry) *Json with Allocator {
    self: *Json = alloc(sizeof Json)
    self.* = .Map(entries)
    return self
}

pub json_none :: fn () *Json with Allocator {
    self: *Json = alloc(sizeof Json)
    self.* = .None
    return self
}

pub json_list_append :: fn (list: *[..]*Json, item: *Json) with Allocator {
    make_room(list, 1, sizeof *Json)
    list.len += 1
    list.*[list.len - 1] = item
}

pub json_map_append :: fn (entries: *[..]JsonMapEntry, entry: JsonMapEntry) with Allocator {
    make_room(entries, 1, sizeof JsonMapEntry)
    entries.len += 1
    entries.*[entries.len - 1] = entry
}

pub json_len :: fn (json: *Json) ?usize {
    if .List(list) := json.* {
        return list.len
    }
    return none
}

pub json_at :: fn (json: *Json, index: i32) ?*Json {
    if .List(list) := json.* {
        if index < 0 and index >= list.len return none
        return list[index]
    }
    return none
}

JsonDecoder :: struct {
    cursor: *char
}

*JsonDecoder self :: impl {
    #inline(always)
    peek :: fn () char -> self.cursor.*

    #inline
    check :: fn (expected: char) bool -> expected == self.peek()

    advance :: fn () bool {
        if self.cursor.* == 0 return false
        self.cursor = self.cursor[1].&
        return true
    }

    #inline
    expect :: fn (expected: char) bool {
        if self.check(expected) {
            self.advance()
            return true
        }
        return false
    }

    match_str :: fn (str: []char) bool {
        saved := self.cursor

        for i in 0 .. str.len {
            if not self.peek() break

            if not self.expect(str[i]) {
                self.cursor = saved
                return false
            }
        }
        return true
    }
    skip_whitespaces :: fn () void {
        tok := self.peek()
        for tok == ' ' or tok == '\n' or tok == '\t' or tok == '\r' {
            if not self.advance() break
            tok = self.peek()
        }
    }

    decode_list :: fn () ?*Json with Allocator {
        self.expect('[') or return none

        l: [..]*Json
        self.skip_whitespaces()
        if not self.check(']') {
            for {
                item := self.decode()
                if item == none return none

                json_list_append(&l, item)
                self.skip_whitespaces()
                if self.check(']') break
                self.expect(',') or return none
            }
        }
        self.expect(']') or return none
        return json_list(l)
    }

    decode_map :: fn () ?*Json with Allocator {
        map: [..]JsonMapEntry
        self.expect('{') or return none

        for true {
            key := self._decode_string() or return none
            if not self.expect(':') return none

            value := self.decode() or return none

            json_map_append(&map, .{ key, value })

            if self.check('}') break
            if not self.expect(',') return none
        }

        self.expect('}') or return none
        return json_map(map)
    }

    _decode_string :: fn () ?*char with Allocator {
        self.expect('"') or return none
        buff := StringBuilder.new()
        for not self.check('"') {
            buff.append_char(self.peek())
            self.advance() or break
        }
        self.expect('"') or return none
        buff.append_char(0)

        return buff.buff
    }

    decode_string :: fn () ?*Json with Allocator {
        buff := self._decode_string() or return none
        return json_str(buff)
    }

    decode_num :: fn () ?*Json with Allocator {
        return none
    }

    decode :: fn () ?*Json with Allocator {
        self.skip_whitespaces()
        tok := self.peek()
        match tok {
            '{' -> { return self.decode_map() },
            '[' -> { return self.decode_list() },
            '"' -> { return self.decode_string() },
            _   -> {
                if self.match_str("true") {
                    return json_bool(true)
                } else if self.match_str("false") {
                    return json_bool(false)
                } else if self.match_str("null") {
                    return json_none()
                } else if tok >= '0' and tok <= '9' {
                    return self.decode_num()
                } else {
                    return none
                }
            }
        }
        return none
    }
}

pub JsonDecode :: fn (cursor: *char) ?*Json with Allocator {
    decoder: *JsonDecoder = .{ cursor }.&
    return decoder.decode()
}

*Json self :: impl(Writable) {
    pub sink :: fn (w: Writer) {
        if self match self.* {
            .Num(val) -> { sink_int(w, val) },
            .Bool(val) -> { sink_bool(w, val) },
            .Str(val) -> {
                sink_char(w, '"')
                sink_cstr(w, val)
                sink_char(w, '"')
            },
            .List(val) -> {
                sink_char(w, '[')
                for item, i in val {
                    item.sink(w)
                    if i < val.len - 1 { sink_char(w, ',') }
                }
                sink_char(w, ']')
            },
            .Map(val) -> {
                sink_char(w, '{')
                for entry, i in val {
                    sink_char(w, '"')
                    sink_cstr(w, entry.key)
                    sink_char(w, '"')
                    sink_char(w, ':')
                    entry.value.sink(w)

                    if i < val.len - 1 do sink_char(w, ',')
                }
                sink_char(w, '}')
            },
            .None -> { sink_str(w, "null") }
        }
    }
}

pub JsonEncode :: fn (self: *Json) *char with Allocator {
    sb := StringBuilder.new()
    self.sink(sb.to_writer())
    return sb.buff
}
