use <std.mem>

c :: foreign {
    fopen   : fn (*char, *char) ?*u8
    fclose  : fn (*u8) i32
    fseek   : fn (*u8, i64, i32) i32
    ftell   : fn (*u8) i64
    rewind  : fn (*u8) u0
    fread   : fn (*u8, i64, i64, *char) i64
}

pub File :: struct {
    file: ?*u8
    path: *char
    mode: *char
}

File :: impl {
    pub new :: fn (path: *char, mode: []char) ?*File with Allocator {
        raw := alloc(sizeof File)
        if not raw { return none }
        self := raw as *File

        self.file = none
        self.path = path
        self.mode = mode
        return self
    }
}

*File self :: impl {
    pub open :: fn () u1 {
        self.file = c.fopen(self.path, self.mode)
        if self.file != none { return true }
        return false
    }

    pub close :: fn () u0 {
        if self.file != none {
            c.fclose(self.file)
            self.file = none
        }
    }

    pub readAll :: fn () ?*char with Allocator {
        if not self.file { return none }

        c.fseek(self.file, 0, 2)
        size: i64 = c.ftell(self.file)
        c.rewind(self.file)

        if size <= 0 { return none }

        raw := alloc(size + 1)
        if not raw { return none }
        buffer := raw as *char

        bytesRead: i64 = c.fread(buffer, 1, size, self.file)

        buffer[bytesRead] = 0

        return buffer
    }
}
