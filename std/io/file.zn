use <std::mem>

c :: foreign {
    fopen   :: *u8  (*char, *char)
    fclose  :: i32  (*u8)
    fseek   :: i32  (*u8, i64, i32)
    ftell   :: i64  (*u8)
    rewind  :: u0   (*u8)
    fread   :: i64  (*u8, i64, i64, *char)
}

pub File :: struct {
    file: *u8
    path: *char
    mode: *char
}

File :: impl {
    new :: *File (path: *char, mode: *char)[Allocator] {
        self: *File = alloc(sizeof File)
        if not self { return none }
        
        self.file = none
        self.path = path
        self.mode = mode
        return self
    }
}

*File self :: impl {
    pub open :: u1 () {
        self.file = c::fopen(self.path, self.mode)
        if self.file { return true }
        return false
    }

    pub close :: u0 () {
        if self.file {
            c::fclose(self.file)
            self.file = none
        }
    }

    pub readAll :: *char ()[Allocator] {
        if not self.file { return none }

        c::fseek(self.file, 0, 2)
        size: i64 = c::ftell(self.file)
        c::rewind(self.file)

        if size <= 0 { return none }

        buffer: *char = alloc(size + 1)
        if not buffer { return none }

        bytesRead: i64 = c::fread(buffer, 1, size, self.file)
        
        buffer[bytesRead] = 0 

        return buffer
    }
}
