use <core::mem>

c :: foreign {
    fopen :: *u8 (*char, *char)
    fclose :: i32 (*u8)
    fseek :: i32 (*u8, i64, i32)
    ftell :: i64 (*u8)
    rewind :: u0 (*u8)
    fread :: i64 (*u8, i64, i64, *char)
}

File :: struct {
    *u8 file
    *char path
    *char mode
}

File :: for {
    new :: *File (*char path, *char mode)[Allocator allocator] {
        *File self = allocator.alloc(sizeof File)
        if not self { return none }
        
        self.file = none
        self.path = path
        self.mode = mode
        return self
    }
}

*File self :: for {
    open :: u1 () {
        self.file = c::fopen(self.path, self.mode)
        if self.file { return true }
        return false
    }

    close :: u0 () {
        if self.file {
            c::fclose(self.file)
            self.file = none
        }
    }

    readAll :: *char ()[Allocator allocator] {
        if not self.file { return none }

        c::fseek(self.file, 0, 2)
        i64 size = c::ftell(self.file)
        c::rewind(self.file)

        if size <= 0 { return none }

        *char buffer = allocator.alloc(size + 1)
        if not buffer { return none }

        i64 bytesRead = c::fread(buffer, 1, size, self.file)
        
        buffer[bytesRead] = 0 

        return buffer
    }
}
