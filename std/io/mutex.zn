use <std::mem>

c :: foreign {
    pthread_mutex_init      :: i32 (*u8, *u0)
    pthread_mutex_lock      :: i32 (*u8)
    pthread_mutex_unlock    :: i32 (*u8)
    pthread_mutex_destroy   :: i32 (*u8)
}

pub Mutex :: struct {
    handle: *u8
}

Mutex :: impl {
    pub new :: Mutex ()[Allocator] {
        handle := alloc(64)
        c::pthread_mutex_init(handle, none)
        return Mutex { handle: handle }
    }
}

Mutex self :: impl {
    pub lock    :: u0 () { c::pthread_mutex_lock(self.handle)   }
    pub unlock  :: u0 () { c::pthread_mutex_unlock(self.handle) }
    pub destroy :: u0 () { c::pthread_mutex_destroy(self.handle)}
}
