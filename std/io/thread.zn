use <std::mem>

pthread_t :: type u64

pub ThreadFunc :: type *u8 (*u8)

timespec :: struct {
    tv_sec: i64
    tv_nsec: i64
}

c :: foreign {
    pthread_create :: i32 (*pthread_t, *u8, ThreadFunc, *u8)
    pthread_join :: i32 (pthread_t, **u8)
    pthread_exit :: u0 (*u8)

    nanosleep :: i32 (*timespec, *timespec)

    printf :: u0 (*char, ...)
}

ThreadContext :: struct {
    func: ThreadFunc
    data: *u8
}

pub Thread :: struct {
    handle: pthread_t
}

thread_trampoline :: *u8 (arg: *u8) {
    ctx := arg as *ThreadContext
    ctx.func(ctx.data)
    return none
}

Thread :: impl {
    pub spawn :: Thread (func: ThreadFunc, data: *u8)[Allocator] {
        ctx: *ThreadContext = alloc(sizeof ThreadContext)
        ctx.func = func
        ctx.data = data

        t := Thread { handle: 0 }

        c::pthread_create(&t.handle, none, thread_trampoline, ctx)
        return t
    }

    pub sleep :: u0 (millis: i64) {
        req := timespec {
            tv_sec: millis / 1000,
            tv_nsec: (millis % 1000) * 1000000
        }

        rem := timespec { tv_sec: 0, tv_nsec: 0 }

        c::nanosleep(&req, &rem)
    }
}

Thread self :: impl {
    pub join :: u0 () {
        c::pthread_join(self.handle, none)
    }
}
