#import "std/mem"
#import "std/core"

pthread_t :: type u64

pub ThreadFunc :: type fn (*u8) ?*u8

timespec :: struct {
    tv_sec: i64
    tv_nsec: i64
}

c :: foreign {
    pthread_create : fn (*pthread_t, ?*u8, ThreadFunc, *u8) i32
    pthread_join : fn (pthread_t, ?**u8) i32
    pthread_exit : fn (?*u8) void

    nanosleep : fn (*timespec, *timespec) i32

    printf : fn (*char, ..) void
}

ThreadContext :: struct {
    func: ThreadFunc
    data: *u8
}

pub Thread :: struct {
    handle: pthread_t
}

thread_trampoline :: fn (arg: *u8) ?*u8 {
    ctx := arg as *ThreadContext
    ctx.func(ctx.data)
    return none
}

Thread :: impl {
    pub spawn :: fn (func: ThreadFunc, data: ?*u8) Thread with Allocator {
        ctx: *ThreadContext = alloc(sizeof ThreadContext) as *ThreadContext
        ctx.func = func
        ctx.data = data as *u8

        t := Thread { handle= 0 }

        c.pthread_create(&t.handle, none, thread_trampoline, ctx)
        return t
    }

    pub sleep :: fn (millis: i64) void {
        req := timespec {
            tv_sec= millis / 1000,
            tv_nsec= (millis % 1000) * 1000000
        }

        rem := timespec { tv_sec= 0, tv_nsec= 0 }

        c.nanosleep(&req, &rem)
    }
}

Thread self :: impl {
    pub join :: fn () {
        c.pthread_join(self.handle, none)
    }
}

ThreadScope :: struct {
    threads: [..]Thread
}

ThreadScope :: impl {
    new :: fn () *ThreadScope with Allocator {
        self: *ThreadScope = alloc(sizeof ThreadScope) as *ThreadScope
        return self
    }
}

*ThreadScope self :: impl {
    spawn :: fn (worker: fn(*u8) ?*u8, arg: ?*u8) with Allocator {
        make_room(&self.threads, 1, sizeof Thread)
        thread := Thread.spawn(worker, arg)
        self.threads.len += 1
        self.threads[self.threads.len - 1] = thread
    }
}
