use lib

c :: foreign {
    mmap   :: *u8 (*u8, u64, i32, i32, i32, i64)
    munmap :: i32 (*u8, u64)
    memcpy :: *u8 (*u8, *u8, u64)
}

PAGE_SIZE   :: 4096
PROT_RW     :: 3
// MAP_PRIVATE (0x2) | MAP_ANON (0x1000 on macOS, 0x20 on Linux).
MAP_FLAGS   :: 4098

pub PageAllocator :: struct {
    mappings: u64
}

PageAllocator :: impl {
    pub init :: PageAllocator () {
        return PageAllocator{ mappings: 0 }
    }
}

*PageAllocator self :: impl Allocator {
    alloc :: *u8 (size: u64) {
        total := sizeof u64 + size
        pages := (total + (PAGE_SIZE as u64 - 1)) / PAGE_SIZE as u64
        mapped := pages * PAGE_SIZE as u64

        base := c::mmap(none, mapped, PROT_RW, MAP_FLAGS, 0 - 1, 0)
        if not base { return none }

        head := base as *u64
        head[0] = mapped
        self.mappings :+ 1
        return &(base[sizeof u64])
    }

    resize :: *u8 (ptr: *u8, size: u64) {
        if not ptr { return self.alloc(size) }

        off: i64 = 0 - (sizeof u64) as i64
        base := &(ptr[off])
        head := base as *u64
        mapped := head[0]
        old := mapped - sizeof u64

        if size <= old { return ptr }

        fresh := self.alloc(size)
        if not fresh { return none }
        c::memcpy(fresh, ptr, old)
        self.unmap(base, mapped)
        return fresh
    }

    destroy :: u0 (ptr: *u8) {
        if not ptr { return }
        off: i64 = 0 - (sizeof u64) as i64
        base := &(ptr[off])
        head := base as *u64
        mapped := head[0]
        self.unmap(base, mapped)
    }
}

*PageAllocator self :: impl {
    pub allocator :: Allocator () -> self as Allocator

    unmap :: u0 (base: *u8, mapped: u64) {
        c::munmap(base, mapped)
        if self.mappings > 0 { self.mappings :- 1 }
    }
}
