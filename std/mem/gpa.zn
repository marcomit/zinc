#import "lib"

c :: foreign {
    malloc: fn (u64) ?*u8
    realloc: fn (?*u8, u64) ?*u8
    free: fn (*u8) void
}

pub GeneralPurposeAllocator :: struct { }

GeneralPurposeAllocator :: impl {
    pub init :: fn () GeneralPurposeAllocator -> .{  }

    pub new :: fn () Allocator -> Allocator(&GeneralPurposeAllocator{})
}

GeneralPurposeAllocator :: impl(Allocator) {
    alloc :: fn (*self, size: u64) ?*u8 {
        p := c.malloc(size)
        return p
    }

    resize :: fn (*self, ptr: ?*u8, size: u64) ?*u8 {
        return c.realloc(ptr, size)
    }

    destroy :: fn (*self, ptr: *u8) void {
        c.free(ptr)
    }
    #allow_empty init ::     fn () void {  }
    #allow_empty deinit ::   fn () void {  }
}

GeneralPurposeAllocator :: impl {
    pub allocator :: fn (*self) Allocator -> Allocator(self)
}
