use lib

c :: foreign {
    malloc: fn *u8 (u64) *u8
    realloc: fn (*u8, u64) *u8
    free: fn (*u8) u0
}

pub GeneralPurposeAllocator :: struct {
    active: u64
    bytes:  u64
}

GeneralPurposeAllocator :: impl {
    pub init :: fn () GeneralPurposeAllocator {
        return GeneralPurposeAllocator{ active: 0, bytes: 0 }
    }
}

*GeneralPurposeAllocator self :: impl Allocator {
    alloc :: fn (size: u64) *u8 {
        p := c::malloc(size)
        if not p { return none }
        self.active :+ 1
        self.bytes  :+ size
        return p
    }

    resize :: fn (ptr: *u8, size: u64) *u8 {
        return c::realloc(ptr, size)
    }

    destroy :: fn (ptr: *u8) u0 {
        if not ptr { return }
        if self.active > 0 { self.active :- 1 }
        c::free(ptr)
    }
    init ::     fn () u0 { return }
    deinit ::   fn () u0 { return }
}

*GeneralPurposeAllocator self :: impl {
    pub allocator :: fn () Allocator -> self as Allocator

    pub leaked :: fn () u64 -> self.active
}
