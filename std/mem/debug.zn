#import "lib"

c :: foreign {
    printf : fn (*char, ..) void
}

pub DebugAllocator :: struct {
    inner:   Allocator
    allocs:  u64
    resizes: u64
    frees:   u64
}

DebugAllocator :: impl {
    pub init :: fn (inner: Allocator) DebugAllocator {
        return DebugAllocator{ inner: inner, allocs: 0, resizes: 0, frees: 0 }
    }
}

DebugAllocator :: impl(Allocator) {
    alloc :: fn (*self, size: u64) *u8 {
        p := self.inner.alloc(size)
        c.printf("[debug] alloc(%lu) -> %p\n", size, p)
        if p { self.allocs :+ 1 }
        return p
    }

    resize :: fn (*self, ptr: *u8, size: u64) *u8 {
        p := self.inner.resize(ptr, size)
        c.printf("[debug] resize(%p, %lu) -> %p\n", ptr, size, p)
        self.resizes :+ 1
        return p
    }

    destroy :: fn (*self, ptr: *u8) void {
        c.printf("[debug] destroy(%p)\n", ptr)
        if ptr { self.frees :+ 1 }
        self.inner.destroy(ptr)
    }
}

DebugAllocator :: impl {
    pub allocator :: fn (*self) Allocator -> self as Allocator

    pub live :: fn (*self) u64 -> self.allocs - self.frees

    pub report :: fn (*self) void {
        c.printf(
            "[debug] allocs=%lu resizes=%lu frees=%lu live=%lu\n",
            self.allocs, self.resizes, self.frees, self.live()
        )
    }
}
