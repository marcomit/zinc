use lib

c :: foreign {
    printf : fn (*char, ..) u0
}

pub DebugAllocator :: struct {
    inner:   Allocator
    allocs:  u64
    resizes: u64
    frees:   u64
}

DebugAllocator :: impl {
    pub init :: fn (inner: Allocator) DebugAllocator {
        return DebugAllocator{ inner: inner, allocs: 0, resizes: 0, frees: 0 }
    }
}

*DebugAllocator self :: impl(Allocator) {
    alloc :: fn (size: u64) *u8 {
        p := self.inner.alloc(size)
        c::printf("[debug] alloc(%lu) -> %p\n", size, p)
        if p { self.allocs :+ 1 }
        return p
    }

    resize :: fn (ptr: *u8, size: u64) *u8 {
        p := self.inner.resize(ptr, size)
        c::printf("[debug] resize(%p, %lu) -> %p\n", ptr, size, p)
        self.resizes :+ 1
        return p
    }

    destroy :: fn (ptr: *u8) u0 {
        c::printf("[debug] destroy(%p)\n", ptr)
        if ptr { self.frees :+ 1 }
        self.inner.destroy(ptr)
    }
}

*DebugAllocator self :: impl {
    pub allocator :: fn () Allocator -> self as Allocator

    pub live :: fn () u64 -> self.allocs - self.frees

    pub report :: fn () u0 {
        c::printf(
            "[debug] allocs=%lu resizes=%lu frees=%lu live=%lu\n",
            self.allocs, self.resizes, self.frees, self.live()
        )
    }
}
