pub Allocator :: facet {
    alloc   :: *u8 (u64)
    resize  :: *u8 (*u8, u64)
    destroy ::  u0 (*u8)
    init    ::  u0 ()
    deinit  ::  u0 ()
}

#[inline(always)]
pub alloc :: *u8 (size: u64)[a: Allocator] {
    return a.alloc(size)
}

#[inline(always)]
pub resize :: *u8 (ptr: *u8, size: u64)[a: Allocator] {
    return a.resize(ptr, size)
}

#[inline(always)]
pub destroy :: u0 (ptr: *u8)[a: Allocator] {
    a.destroy(ptr)
}
