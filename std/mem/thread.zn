use <std.io.mutex>
use lib

pub ThreadAllocator :: struct {
    inner: Allocator
    mutex: Mutex
}

ThreadAllocator :: impl {
    pub init :: fn (allocator: Allocator) ThreadAllocator {
        self := ThreadAllocator{
            inner: allocator,
            mutex: Mutex::new()
        }
    }

    pub from_ctx :: fn () ThreadAllocator with allocator: Allocator {
        self := ThreadAllocator{
            inner: allocator,
            mutex: Mutex::new()
        }
    }
}

*ThreadAllocator self :: impl {
    allocator :: fn () Allocator -> self as Allocator
}

*ThreadAllocator self :: impl(Allocator) {
    pub init :: fn () u0 {}
    pub deinit :: fn () u0 -> self.mutex.destroy()

    pub alloc :: fn (size: u64) *u8 {
        self.mutex.lock()
        ptr := self.allocator.alloc()
        self.mutex.unlock()
        return ptr
    }

    pub resize :: fn (ptr: *u8, size: u64) *u8 {
        self.mutex.lock()
        new_ptr := self.allocator.resize(ptr, size)
        self.mutex.unlock()
        return new_ptr
    }

    pub destroy :: fn (ptr: *u8) u0 {
        self.mutex.lock()
        self.allocator.free(ptr)
        self.mutex.unlock()
    }
}


