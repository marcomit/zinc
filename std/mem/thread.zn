#import "std/io/mutex"
#import "lib"

pub ThreadAllocator :: struct {
    inner: Allocator
    mutex: Mutex
}

ThreadAllocator :: impl {
    pub init :: fn (allocator: Allocator) ThreadAllocator {
        self := ThreadAllocator{
            inner: allocator,
            mutex: Mutex::new()
        }
    }

    pub from_ctx :: fn () ThreadAllocator with allocator: Allocator {
        self := ThreadAllocator{
            inner: allocator,
            mutex: Mutex::new()
        }
    }

    allocator :: fn (self) Allocator -> self as Allocator
}

ThreadAllocator :: impl(Allocator) {
    pub init :: fn (*self) void {}
    pub deinit :: fn (*self) void -> self.mutex.destroy()

    pub alloc :: fn (*self, size: u64) *u8 {
        self.mutex.lock()
        ptr := self.allocator.alloc()
        self.mutex.unlock()
        return ptr
    }

    pub resize :: fn (*self, ptr: *u8, size: u64) *u8 {
        self.mutex.lock()
        new_ptr := self.allocator.resize(ptr, size)
        self.mutex.unlock()
        return new_ptr
    }

    pub destroy :: fn (*self, ptr: *u8) void {
        self.mutex.lock()
        self.allocator.free(ptr)
        self.mutex.unlock()
    }
}


