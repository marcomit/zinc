use <std.mem>

RcDrop :: type fn (*u8) u0

pub Rc :: struct {
    ref: u32
    offset: u32
}

RC_FLAG :: 0xDEADBEEF as u32

Rc :: impl {
    pub new :: fn (size: u64) *u8 [Allocator] {
        self: *Rc = alloc(sizeof Rc + size)
        self.ref = 1
        self.offset = RC_FLAG
        return &(self[1])
    }

    pub retain :: fn (ptr: *u8) *u8 {
        self: *Rc = &(ptr[-sizeof Rc])
        if not self or self.offset != RC_FLAG { return none }
        self.ref: + 1
        return self
    }

    pub release :: fn (ptr: *u8) u32 {
        self: *Rc = &(ptr[-sizeof Rc])
        if not self or self.offset != RC_FLAG or self.ref == 0 { return -1 }
        self.ref: - 1
        return self.ref
    }
}
