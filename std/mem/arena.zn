#import "lib"

DEFAULT_BLOCK :: 4096

#[packed]
Block :: struct {
    next: ?*Block
    cap:  u64
    used: u64
}

Block :: impl {
    new :: fn (buffer_size: usize) ?*Block with Allocator {
        self: *Block = alloc(sizeof Block + buffer_size) or return none
        self.next = none
        self.cap = buffer_size
        self.used = 0
        return self
    }

    #inline(always)
    has_size :: fn (*self, size: usize) bool -> self.used + size < self.cap

    #inline(always)
    current_ptr :: fn (*self, size: usize) ?*u8 {
        if not self.has_size(size) return none
        defer self.used += size

        buffer: *u8 = self[1].&
        return buffer[self.used].&
    }

    destroy :: fn (*self) with Allocator {
        if self.next {
            self.next!.destroy()
        }
        destroy(self)
    }
}

pub ArenaAllocator :: struct {
    parent_allocator: Allocator
    #private head: ?*Block
    #private tail: ?*Block
}

ArenaAllocator :: impl {
    new :: fn () Allocator with parent_allocator: Allocator {
        self: *ArenaAllocator = alloc(sizeof ArenaAllocator)
        self.head = none
        self.tail = none
        self.parent_allocator = parent_allocator
    }
}

ArenaAllocator :: impl {
    grow :: fn (*self) {
        with _ := self.parent_allocator {
            block := Block.new(DEFAULT_ALLOCATOR)
            if not self.head {
                self.head = block
                self.tail = block
            } else {
                self.tail!.next = block
            }
        }
    }

    pub scope :: fn (*self) Allocator {
        temp: *TempAllocator = self.alloc(sizeof TempAllocator)
        temp.arena = self
        temp.block = self.tail!
        return Allocator(temp)
    }

    end_scope :: fn (*self, block: Block) {

    }
}

ArenaAllocator :: impl(Allocator) {
    alloc :: fn (*self, size: usize) ?*u8 {
        with _ := self.parent_allocator {
            if not self.head or not self.tail {
                    self.head = Block.new(DEFAULT_BLOCK)
                    self.tail = self.head
            }

            if not self.tail return none
            if not self.tail!.has_size() {
                self.grow()
            }

            return self.tail!.current_ptr()
        }
    }

    realloc :: fn (*self, #unused ptr: *u8, size: usize) ?*u8 {
        return self.alloc(size)
    }

    #allow_empty
    free :: fn (*self, ptr: *u8) {

    }

    init :: fn (*self, ) {

    }

    deinit :: fn (*self) {
        with _ := self.parent_allocator {
            self.head.destroy()
        }
    }
}

pub TempAllocator :: struct {
    arena: *ArenaAllocator
    block: Block
}

TempAllocator :: impl(Allocator) {
    alloc :: fn (*self, size: usize) ?*u8 -> self.arena.alloc(size)
    realloc :: fn (*self, ptr: *u8, size: usize) ?*u8 -> self.arena.realloc(size)
    free :: fn (*self, ptr: *u8) -> self.arena.free(ptr)

    #allow_empty
    init :: fn (*self) { }

    deinit :: fn (*self) -> self.arena.end_scope()
}
