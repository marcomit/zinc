#import "lib"

DEFAULT_BLOCK :: 4096

#[packed]
Block :: struct {
    next: ?*Block
    cap:  u64
    used: u64
}

Block :: impl {
    new :: fn (buffer_size: usize) ?*Block with Allocator {
        self: *Block = alloc(sizeof Block + buffer_size) or return none
        self.next = none
        self.cap = buffer_size
        self.used = 0
        return self
    }
}

*Block self :: impl {
    #inline(always)
    has_size :: fn (size: usize) u1 -> self.used + size < self.cap

    #inline(always)
    current_ptr :: fn (size: usize) ?*u8 {
        if not self.has_size(size) return none
        defer self.used += size

        buffer: *u8 = self[1].&
        return buffer[self.used].&
    }

    destroy :: fn () with Allocator {
        if self.next {
            self.next!.destroy()
        }
        destroy(self)
    }
}

pub ArenaAllocator :: struct {
    parent_allocator: Allocator
    #private head: ?*Block
    #private tail: ?*Block
}

ArenaAllocator :: impl {
    new :: fn () Allocator with parent_allocator: Allocator {
        self: *ArenaAllocator = alloc(sizeof ArenaAllocator)
        self.head = none
        self.tail = none
        self.parent_allocator = parent_allocator
    }
}

*ArenaAllocator self :: impl {
    grow :: fn () {
        with _ := self.parent_allocator {
            block := Block.new(DEFAULT_ALLOCATOR)
            if not self.head {
                self.head = block
                self.tail = block
            } else {
                self.tail!.next = block
            }
        }
    }

    pub scope :: fn () Allocator {
        temp: *TempAllocator = self.alloc(sizeof TempAllocator)
        temp.arena = self
        temp.block = self.tail!
        return Allocator(temp)
    }

    end_scope :: fn (block: Block) {

    }
}

*ArenaAllocator self :: impl(Allocator) {
    alloc :: fn (size: usize) ?*u8 {
        with _ := self.parent_allocator {
            if not self.head or not self.tail {
                    self.head = Block.new(DEFAULT_BLOCK)
                    self.tail = self.head
            }

            if not self.tail return none
            if not self.tail!.has_size() {
                self.grow()
            }

            return self.tail!.current_ptr()
        }
    }

    realloc :: fn (#unused ptr: *u8, size: usize) ?*u8 {
        return self.alloc(size)
    }

    #allow_empty
    free :: fn (ptr: *u8) {

    }

    init :: fn () {

    }

    deinit :: fn () {
        with _ := self.parent_allocator {
            self.head.destroy()
        }
    }
}

pub TempAllocator :: struct {
    arena: *ArenaAllocator
    block: Block
}

*TempAllocator self :: impl(Allocator) {
    alloc :: fn (size: usize) ?*u8 -> self.arena.alloc(size)
    realloc :: fn (ptr: *u8, size: usize) ?*u8 -> self.arena.realloc(size)
    free :: fn (ptr: *u8) -> self.arena.free(ptr)

    #allow_empty
    init :: fn () { }

    deinit :: fn () -> self.arena.end_scope()
}
