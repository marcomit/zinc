#[lang(type_info)]
Type :: enum {
    hash: u32

    Void
    Bool(u1)
    Integer(u8, u1)
    Float(u8)
    Struct(*char, []StructField)
    Enum(*char, []TypeInfoStruct)
    Pointer(*Type)
    Optional(*Type)
    Error(*Type, *Type)
    Func(*Type, []*Type)
}

#[lang(type_info_struct)]
TypeInfoStruct :: struct {
    name: *char
    fields: []StructField
}

#[lang(type_info_struct_field)]
StructField :: struct {
    name: *char
    typeref: Type
}

#[lang(source_location_type)]
pub SourceLocation :: struct {
    file: []char
    curr: []char
    row: u64
    col: u64
}

#[lang(source_location_func)]
pub foreign here :: SourceLocation

func :: fn (loc: SourceLocation) u0 {
}

main :: fn () i32 {

    func(here)

    return 0
}
