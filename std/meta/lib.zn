#import "std/core/display"

#lang(type_info)
pub Type :: enum {
    Void
    Bool
    Integer(bits: u8, signed: u1)
    Float
    Double
    Array(*Type)
    Struct(name: []char, fields: []TypeKeyValueField)
    Enum(name: []char, variants: []TypeEnumVariant)
    Pointer(*Type)
    Optional(*Type)
    Result(success: *Type, error: *Type)
    Func(ret: *Type, args: []TypeKeyValueField)
    Sum([]*Type)
    Tuple([]*Type)
    Facet(name: []char, methods: []*Type)
}

#lang(type_info_enum_variant)
pub TypeEnumVariant :: struct {
    name: []char
    fields: []TypeKeyValueField
}

#lang(type_info_struct_field)
pub TypeKeyValueField :: struct {
    name: []char
    type_info: *Type
}

*Type self :: impl(Writable) {
    pub sink :: fn (w: Writer) {
        match *self {
            .Void -> sink_str(w, "void"),
            .Bool -> sink_str(w, "bool"),
            .Integer(bits, signed) {
                sink_char(w, if signed do 'i' else 'u')
                sink_int(w, bits)
            },
            .Float -> sink_str(w, "f32"),
            .Double -> sink_str(w, "f64"),
            .Array(base) {
                sink_str(w, "[]")
                base.sink(w)
            },
            .Pointer(base) {
                sink_char(w, '*')
                base.sink(w)
            },
            .Optional(base) {
                sink_char(w, '?')
                base.sink(w)
            },
            .Tuple(types) {
                sink_char(w, '(')
                for i in 0..types.len {
                    types[i].sink(w)
                    if i != types.len - 1 {
                        sink_str(w, ", ")
                    }
                }
                sink_char(w, ')')
            },
            .Result(success, error) {
                success.sink(w)
                sink_char(w, '!')
                error.sink(w)
            },
            .Struct(name, _) {
                sink_str(w, name)
            },
            .Enum(name, _) {
                sink_str(w, name)
            },
            .Facet(name, _) {
                sink_str(w, name)
            },
            .Func(ret, args) {
                sink_str(w, "fn (")
                for i in 0..args.len {
                    if i != args.len - 1 {
                        args[i].type_info.sink(w)
                        sink_str(w, ", ")
                    }
                }
                sink_str(w, ") ")
                ret.sink(w )
            }
        }
    }
}

#lang(source_location_type)
pub SourceLocation :: struct {
    file: []char
    curr: []char
    row: u64
    col: u64
}

#lang(source_location_func)
pub here :: foreign fn () SourceLocation
