@startuml
title Activity Diagram - Zinc Compilation Pipeline

' Models main() + pipeline() in src/zinc.c and zcompile() in src/zgen.c.
' Key invariant: after each phase canAdvance() checks for accumulated
' errors; on failure the build aborts and diagnostics are printed.

skinparam shadowing false

start

:Parse CLI arguments (loadState);
if (arguments valid?) then (no)
  :Report usage error;
  stop
else (yes)
endif

:Start build timer;

partition "Lexical analysis" {
  :Tokenize source (ztokenize);
}
if (tokens produced and no errors?) then (no)
  :Print diagnostics (printLogs);
  stop
else (yes)
endif

partition "Syntax analysis" {
  :Parse tokens into AST (zparse);
  note right
    Imports are resolved and
    macros expanded while parsing
  end note
}
if (no errors? (canAdvance)) then (no)
  :Print diagnostics (printLogs);
  stop
else (yes)
endif

partition "Semantic analysis" {
  :Resolve scopes, symbols, types (zanalyze);
}
if (debug mode?) then (yes)
  :Dump AST (printNode);
else (no)
endif
if (no errors? (canAdvance)) then (no)
  :Print diagnostics (printLogs);
  stop
else (yes)
endif

partition "Code generation (zcompile)" {
  :Emit LLVM IR module\n(types, declarations, function bodies);

  if (LLVM module valid?) then (no)
    :Report LLVM error;
    :Print diagnostics (printLogs);
    stop
  else (yes)
  endif

  if (--emit-llvm?) then (yes)
    :Write .ll IR file;
    :Print diagnostics (printLogs);
    stop
  else (no)
    :Emit native object file (.o);
    if (object emitted?) then (no)
      :Print diagnostics (printLogs);
      stop
    else (yes)
    endif

    :Link object with LLD (zinc_lld_link);
    if (link succeeded?) then (no)
      :Report linker error;
    else (yes)
      :Write executable;
      :Remove temporary .o;
    endif
  endif
}

:Print diagnostics (printLogs);
:Report "Finished build" with elapsed time;
stop

@enduml
