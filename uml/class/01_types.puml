@startuml
title Class Diagram - Type System (ZType)

skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle

enum ZTypeKind {
    Z_TYPE_PRIMITIVE
    Z_TYPE_POINTER
    Z_TYPE_STRUCT
    Z_TYPE_ARRAY
    Z_TYPE_FUNCTION
    Z_TYPE_TUPLE
    Z_TYPE_GENERIC
    Z_TYPE_FACET
    Z_TYPE_ENUM
    Z_TYPE_NONE
    Z_TYPE_NAMESPACE
}

abstract class ZType {
    kind : ZTypeKind
    tok : ZToken*
    constant : bool
}
ZType --> ZTypeKind : kind

class ZTypePrimitive {
    token : ZToken*
    base : ZType*
    generics : ZType**
}
class ZTypePtr {
    base : ZType*
}
class ZTypeStruct {
    name : ZToken*
    fields : ZNode**
    generics : ZType**
}
class ZTypeFunc {
    ret : ZType*
    args : ZType**
    generics : ZType**
    capabilities : ZType**
    variadic : bool
}
class ZTypeArray {
    base : ZType*
    size : usize
}
class ZTypeGeneric {
    name : ZToken*
    extensions : ZType**
}
class ZTypeTuple {
    tuple : ZType**
}
class ZTypeFacet {
    facet : ZType**
}
class ZTypeEnum {
    name : ZToken*
    fields : ZType**
    generics : ZType**
}

ZTypePrimitive  --|> ZType
ZTypePtr        --|> ZType
ZTypeStruct     --|> ZType
ZTypeFunc       --|> ZType
ZTypeArray      --|> ZType
ZTypeGeneric    --|> ZType
ZTypeTuple      --|> ZType
ZTypeFacet      --|> ZType
ZTypeEnum       --|> ZType

note bottom of ZTypeStruct : 'fields' references ZNode (see AST diagrams)
@enduml
