@startuml
title Class Diagram - Driver / Compiler State

skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle

enum ZPhase {
    Z_PHASE_LEXICAL
    Z_PHASE_SYNTAX
    Z_PHASE_SEMANTIC
    Z_PHASE_GENERATE
}

enum ZLogLevel {
    Z_ERROR
    Z_WARNING
    Z_INFO
    Z_DEBUG
}

class ZState {
    output : char*
    logs : ZLog**
    currentPhase : ZPhase
    currentPath : char*
    filename : char*
    compilerPath : char*
    pathFiles : char**
    visitedFiles : char**
    canAdvance : bool
    debug : bool
    unusedVar : bool
    unusedFunc : bool
    unusedStruct : bool
    emitLLVM : bool
    skipLLVMValidation : bool
    verbose : bool
    optimizationLevel : u8
    root : ZNode*
    extraArgs : char**
}

class ZLog {
    filename : char*
    message : char*
    token : ZToken*
    level : ZLogLevel
    phase : ZPhase
    src_file : const char*
    src_line : int
}

ZState *--> ZLog     : logs
ZState --> ZPhase    : currentPhase
ZLog   --> ZLogLevel : level
ZLog   --> ZPhase    : phase

note as N1
  Cross-layer references (see other diagrams):
  - ZState.root -> ZNode (AST)
  - ZLog.token -> ZToken (Tokens)
end note
@enduml
