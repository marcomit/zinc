@startuml
title Class Diagram - Tokens (ZToken)

skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle

enum ZTokenType {
}
note right of ZTokenType : Generated from ztok.h\n(TOK_IDENT, TOK_INT, TOK_STR, ...)

abstract class ZToken {
    type : ZTokenType
    sourcePtr : char*
    sourceLinePtr : char*
    start : char*
    row : usize
    col : usize
    newlineBefore : bool
}
ZToken --> ZTokenType : type

class ZTokenStr {
    str : char*
}
class ZTokenInt {
    integer : i64
}
class ZTokenFloat {
    floating : f64
}
class ZTokenBool {
    boolean : bool
}

ZTokenStr   --|> ZToken
ZTokenInt   --|> ZToken
ZTokenFloat --|> ZToken
ZTokenBool  --|> ZToken
@enduml
