@startuml
title Class Diagram - AST Statements & Control Flow

skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle

abstract class ZNode {
    type : ZNodeType
    resolved : ZType*
    tok : ZToken*
}

class ZNodeBlock {
    scope : ZScope*
    block : ZNode**
}
class ZNodeIfStmt {
    cond : ZNode*
    body : ZNode*
    elseBranch : ZNode*
}
class ZNodeWhileStmt {
    cond : ZNode*
    branch : ZNode*
}
class ZNodeForStmt {
    var : ZNode*
    cond : ZNode*
    incr : ZNode*
    block : ZNode*
}
class ZNodeReturn {
    expr : ZNode*
}
class ZNodeDefer {
    expr : ZNode*
}
class ZNodeMatch {
    cond : ZNode*
    arms : ZNode**
}
class ZNodeMatchArm {
    pattern : ZVarDestructPattern*
    expr : ZNode*
}
class ZNodeVarDecl {
    pattern : ZVarDestructPattern*
    rvalue : ZNode*
}
class ZNodeCapability {
    capability : ZNode*
    block : ZNode*
}
class ZNodeGotoLabel {
    gotoLabel : ZToken*
}

ZNodeBlock      --|> ZNode
ZNodeIfStmt     --|> ZNode
ZNodeWhileStmt  --|> ZNode
ZNodeForStmt    --|> ZNode
ZNodeReturn     --|> ZNode
ZNodeDefer      --|> ZNode
ZNodeMatch      --|> ZNode
ZNodeMatchArm   --|> ZNode
ZNodeVarDecl    --|> ZNode
ZNodeCapability --|> ZNode
ZNodeGotoLabel  --|> ZNode

ZNodeBlock      *--> ZNode : block
ZNodeIfStmt     *--> ZNode : cond / body / elseBranch
ZNodeWhileStmt  *--> ZNode : cond / branch
ZNodeForStmt    *--> ZNode : var / cond / incr / block
ZNodeReturn     *--> ZNode : expr
ZNodeDefer      *--> ZNode : expr
ZNodeMatch      *--> ZNode : cond / arms
ZNodeMatchArm   *--> ZNode : expr
ZNodeVarDecl    *--> ZNode : rvalue
ZNodeCapability *--> ZNode : capability / block

note bottom of ZNode : 'resolved' -> ZType ; 'pattern' -> ZVarDestructPattern\n(see Type System / AST Helpers diagrams)
@enduml
