use <std::core::mem::gpa>
use <std::libc>

leaf :: i32 ()[alloc: Allocator] {
    _ := alloc.alloc(8)
    return 99
}

level3 :: i32 ()[Allocator] -> leaf()
level2 :: i32 ()[Allocator] -> level3()
level1 :: i32 ()[Allocator] -> level2()

main :: i32 () {
    gpa := GeneralPurposeAllocator::init()
    with _ := (&gpa).allocator() {
        r := level1()
        io::printf("%d\n", r)
    }
    return 0
}
