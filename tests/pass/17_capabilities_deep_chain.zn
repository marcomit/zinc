use <std::mem::gpa>
use <std::mem>
use <std::libc>

leaf :: fn () i32 with alloc: Allocator {
    _ := alloc.alloc(8)
    return 99
}

level3 :: fn () i32 with Allocator -> leaf()
level2 :: fn () i32 with Allocator -> level3()
level1 :: fn () i32 with Allocator -> level2()

main :: fn () i32 {
    gpa := GeneralPurposeAllocator.init()
    with _ := (&gpa).allocator() {
        r := level1()
        io.printf("%d\n", r)
    }
    return 0
}
