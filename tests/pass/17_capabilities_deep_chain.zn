// Four levels of call chain, each requiring the same capability.
// Verifies that the capability threads correctly through all levels
// without being passed explicitly.

use <core::mem>

c :: foreign {
    printf :: u0 (*char, ...)
}

leaf :: i32 ()[Allocator alloc] {
    _ := alloc.alloc(8)
    return 99
}

level3 :: i32 ()[Allocator _] -> leaf()
level2 :: i32 ()[Allocator _] -> level3()
level1 :: i32 ()[Allocator _] -> level2()

main :: i32 () {
    with _ := Allocator::heap() {
        i32 r = level1()
        c::printf("%d\n", r)
    }
    return 0
}
