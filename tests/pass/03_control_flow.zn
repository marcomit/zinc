foreign printf :: fn (*char) u0

main :: fn (argc: i32) i32 {

    x: i32 = 5
    if x == 5  { printf("eq\n")  }
    if x != 4  { printf("neq\n") }
    if x > 4   { printf("gt\n")  }
    if x < 6   { printf("lt\n")  }
    if x >= 5  { printf("gte\n") }
    if x <= 5  { printf("lte\n") }
    if x == 6  { printf("NOPE\n") }

    if argc == 1 { printf("one arg\n") }

    i := 0
    for i < 3 {
        printf("while\n")
        i += 1
    }

    j := 0
    for j < 3 {
        printf("for\n")
        j += 1
    }

    j = 0
    for j < 3 {
        printf("for typed\n")
        j += 1
    }

    k := 0
    for k < 10 {
        k += 1
        if k > 3 { break }
    }
    printf("break\n")

    m := 0
    for m < 5 {
        m += 1
        if m < 3 { continue }
        printf("cont\n")
    }

    defer printf("f0\n")
    defer printf("f1\n")

    if true {
        defer printf("if\n")
    }

    n := 2
    for n > 0 {
        defer printf("loop\n")
        n -= 1
    }

    defer printf("f2\n")

    return 0
}
