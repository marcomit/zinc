c :: foreign {
    printf :: u0 (*char, ...)
}

Option :: enum {
    Some(*char)
    None
}

fromFunc :: Option () {
    return Option::Some("hello")
}

nestedCond :: (i32, Option) () {
    return (1, Option::Some("hi"))
}

doubleCond :: (Option, Option) () {
    return (Option::Some("message 1"), Option::None())
}

printDoubleCond :: u0 ((Option, Option) cond) {
    match cond {
        (Option::Some(msg1), Option::Some(msg2))    -> c::printf("%s, %s\n", msg1, msg2),
        (Option::Some(msg), Option::None())         -> c::printf("1:%s\n", msg),
        (Option::None(), Option::Some(msg))         -> c::printf("2:%s\n", msg)
    }
}

main :: i32 () {
    match fromFunc() {
        Option::Some(msg)   -> c::printf("%s\n", msg),
        Option::None()      -> c::printf("none\n")
    }

    match nestedCond() {
        (_, Option::Some(msg))  -> c::printf("%s\n", msg),
        (val, Option::None())     -> c::printf("%d none\n", val)
    }

    case1 := (Option::Some("msg1"), Option::Some("msg2"))
    case2 := (Option::Some("msg"), Option::None())
    case3 := (Option::None(), Option::Some("msg"))

    printDoubleCond(case1)
    printDoubleCond(case2)
    printDoubleCond(case3)
    return 0
}
