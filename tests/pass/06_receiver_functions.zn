c :: foreign {
    printf : fn (*char, ...) u0
}


Counter :: struct {
    count: i32
}

Rect :: struct {
    w: i32
    h: i32
}

Counter self :: impl {
    print :: fn () u0 -> c.printf("%d\n", self.count)
    get :: fn () i32 -> self.count
    add :: fn (n: i32) i32 -> self.count + n
    between :: fn (lo: i32, hi: i32) i32 {
        if self.count > lo and self.count < hi {
            return 1
        }
        return 0
    }
}

Rect self :: impl {
    area :: fn () i32 -> self.w * self.h
    describe :: fn () u0 -> c.printf("%d %d\n", self.w, self.h)
    scaledArea :: fn (factor: i32) i32 -> self.w * self.h * factor
}

i32 self :: impl {
    sum :: fn (other: i32) i32 -> other + self
    print :: fn () u0 -> c.printf("%d\n", self)
}

main :: fn () i32 {
    c: Counter = Counter { count= 3 }

    c.print()

    v: i32 = c.get()
    v.print()

    sum: i32 = c.add(4)
    sum.print()

    inside: i32 = c.between(1, 5)
    inside.print()

    outside: i32 = c.between(4, 9)
    outside.print()

    r: Rect = Rect { w= 3, h= 4 }
    r.describe()

    area: i32 = r.area()
    area.print()

    scaled: i32 = r.scaledArea(2)
    scaled.print()

    a: Counter = Counter { count= 1 }
    b: Counter = Counter { count= 2 }
    a.print()
    b.print()

    return 0
}
