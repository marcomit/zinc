foreign c {
    u0 printf(*char, ...)
}


struct Counter {
    i32 count
}

struct Rect {
    i32 w
    i32 h
}

for Counter self {
    u0 print() -> c::printf("%d\n", self.count)
    i32 get() -> self.count
    i32 add(i32 n) -> self.count + n
    i32 between(i32 lo, i32 hi) {
        if self.count > lo and self.count < hi {
            return 1
        }
        return 0
    }
}

for Rect self {
    i32 area() -> self.w * self.h
    u0 describe() -> c::printf("%d %d\n", self.w, self.h)
    i32 scaledArea(i32 factor) -> self.w * self.h * factor
}

for i32 self {
    i32 sum(i32 other) -> other + self

    u0 print() -> c::printf("%d\n", self)
}

i32 main() {
    Counter c = Counter { count: 3 }

    c.print()

    i32 v = c.get()
    v.print()

    i32 sum = c.add(4)
    sum.print()

    i32 inside = c.between(1, 5)
    inside.print()

    i32 outside = c.between(4, 9)
    outside.print()

    Rect r = Rect { w: 3, h: 4 }
    r.describe()

    i32 area = r.area()
    area.print()

    i32 scaled = r.scaledArea(2)
    scaled.print()

    Counter a = Counter { count: 1 }
    Counter b = Counter { count: 2 }
    a.print()
    b.print()

    return 0
}
