c :: foreign {
    printf :: u0 (*char, ...)
}


Counter :: struct {
    i32 count
}

Rect :: struct {
    i32 w
    i32 h
}

Counter self :: for {
    print :: u0() -> c::printf("%d\n", self.count)
    get :: i32 () -> self.count
    add :: i32 (i32 n) -> self.count + n
    between :: i32 (i32 lo, i32 hi) {
        if self.count > lo and self.count < hi {
            return 1
        }
        return 0
    }
}

Rect self :: for {
    area :: i32 () -> self.w * self.h
    describe :: u0 () -> c::printf("%d %d\n", self.w, self.h)
    scaledArea :: i32 (i32 factor) -> self.w * self.h * factor
}

i32 self :: for {
    sum :: i32 (i32 other) -> other + self
    print :: u0 () -> c::printf("%d\n", self)
}

main :: i32 () {
    Counter c = Counter { count: 3 }

    c.print()

    i32 v = c.get()
    v.print()

    i32 sum = c.add(4)
    sum.print()

    i32 inside = c.between(1, 5)
    inside.print()

    i32 outside = c.between(4, 9)
    outside.print()

    Rect r = Rect { w: 3, h: 4 }
    r.describe()

    i32 area = r.area()
    area.print()

    i32 scaled = r.scaledArea(2)
    scaled.print()

    Counter a = Counter { count: 1 }
    Counter b = Counter { count: 2 }
    a.print()
    b.print()

    return 0
}
