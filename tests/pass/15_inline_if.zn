foreign printf :: fn (*char, ...) u0
main :: fn () i32 {
    x := 5
    y := 4
    z := 3


    nested: i32 =
            if x > z do
                if x > y    do x
                else        do y
            else
                if z > y    do z
                else        do y

    printf("%d\n", nested)

    return 0
}
