foreign printf :: fn (*char, ...) u0
main :: fn () i32 {
    x := 5
    y := 4
    z := 3


    nested: i32 =
            if x > z ->
                if x > y    -> x
                else        -> y
            else
                if z > y    -> z
                else        -> y

    printf("%d\n", nested)

    return 0
}
