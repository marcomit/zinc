use <std::core::string>
use <std::core::mem>

libc :: foreign {
    printf :: u0 (*char, ...)
}

main :: i32 () {
    with _ := Allocator::heap() {
        hello := String::from("Ciao")
        cap := String::withCapacity(64)

        hello2 := String::from("Ciao")
        
        hello.println()

        if hello == hello2 {
            libc::printf("ok\n")
        }
    }

    return 0
}
