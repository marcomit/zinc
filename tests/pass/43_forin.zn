use <std.libc>

Range :: struct {
    start: i32
    end: i32
    current: i32
}

*Range self :: impl {
    next :: fn () ?i32 {
        if self.current >= self.end return none
        defer self.current += 1
        return self.current
    }
}

range :: fn (start: i32, end: i32) Range -> .{
    start: start, end: end, current: start
}

ArrIter :: struct {
    data: []i32
    current: i32
}

[]i32 self :: impl {
    iter :: fn () ArrIter -> .{
        data: self, current: 0
    }
}

*ArrIter self :: impl {
    next :: fn () ?i32 {
        if self.current >= self.data.len return none
        defer self.current += 1
        return self.data[self.current]
    }
}

main :: fn () i32 {
    io.printf("nums\n")
    for i in range(0, 10) {
        io.printf("%d\n", i)
    }

    io.printf("values\n")
    values := [5, 4, 3, 2, 1]
    for item in values.iter() {
        io.printf("%d\n", item)
    }
    return 0
}
