c :: foreign {
    printf :: u0 (*u8, ...)
}

Vec2 :: struct {
    x: i32
    y: i32
}

Vec2 :: impl {
    new :: Vec2 (x: i32, y: i32) -> Vec2{ x: x, y: y}
}

GLOBAL :: 100

Vec2 self :: impl {
    #[overload(+)]
    add :: Vec2 (other: Vec2) {
        return Vec2 {
            x: self.x + other.x,
            y: self.y + other.y
        }
    }

    #[overload(-)]
    sub :: Vec2 (other: Vec2) {
        return Vec2 {
            x: self.x - other.x,
            y: self.y - other.y
        }
    }

    #[overload(*)]
    mul :: Vec2 (other: Vec2) {
        return Vec2 {
            x: self.x * other.x,
            y: self.y * other.y
        }
    }

    #[overload(/)]
    div :: Vec2 (other: Vec2) {
        return Vec2 {
            x: self.x / other.x,
            y: self.y / other.y
        }
    }

    #[overload(==)]
    eq :: u1 (other: Vec2) {
        return self.x == other.x and self.y == other.y
    }

    print :: u0 () {
        c::printf("(%d, %d)\n", self.x, self.y)
    }
}

main :: i32 () {
    v1 := Vec2::new(1, 2)
    v2 := Vec2::new(3, 4)

    sum := v1 + v2
    sum.print()

    diff := v2 - v1
    diff.print()

    a := Vec2::new(2, 3)
    b := Vec2::new(4, 5)
    prod := a * b
    prod.print()

    p := Vec2::new(10, 15)
    q := Vec2::new(2, 3)
    quot := p / q
    quot.print()

    if v1 == Vec2::new(1, 2) {
        c::printf("equal\n")
    }

    if v1 == v2 {
        c::printf("equal\n")
    }

    return 0
}
