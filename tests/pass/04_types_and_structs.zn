c :: foreign {
    malloc :: *u8(u64)
    printf :: u0 (*char, ...)
}

Vec2 :: struct {
    x: f32
    y: f32
}

Color :: struct {
    r: u8
    g: u8
    b: u8
}

Point :: struct {
    x: i32
    y: i32
}

Linked :: struct {
    val: i32
    next: *Linked 
}

sum :: f32 (x: f64, y: f64) {
    return x + y
}

main :: i32 () {
    p: Point = Point { x: 10, y: 20 }
    val: i32 = p.x
    c::printf("member ok\n")

    ival: i32 = 10
    v := Vec2 { x: ival, y: 10 }

    res: i32 = sum(v.x, v.y)
    c::printf("%d\n", res)

    ptr: *Point = c::malloc(sizeof Point)

    return res - res
}
