c :: foreign {
    malloc : fn (u64) *u8
    printf : fn (*char, ...) u0
}

Vec2 :: struct {
    x: f32
    y: f32
}

Color :: struct {
    r: u8
    g: u8
    b: u8
}

Point :: struct {
    x: i32
    y: i32
}

Linked :: struct {
    val: i32
    next: *Linked
}

sum :: fn (x: f64, y: f64) f32 {
    return x + y
}

main :: fn () i32 {
    p: Point = Point { x= 10, y= 20 }
    val: i32 = p.x
    c.printf("member ok\n")

    ival: i32 = 10
    v := Vec2 { x = ival, y = 10 }

    res: i32 = sum(v.x, v.y)
    c.printf("%d\n", res)

    ptr: *Point = c.malloc(sizeof Point)

    return res - res
}
