c :: foreign {
    malloc :: *u8(u64)
    printf :: u0 (*char, ...)
}

Vec2 :: struct {
    f32 x
    f32 y
}

Color :: struct {
    u8 r
    u8 g
    u8 b
}

Point :: struct {
    i32 x
    i32 y
}

Linked :: struct {
    i32 val
    *Linked next
}

sum :: f32 (f64 x, f64 y) {
    return x + y
}

main :: i32 () {
    Point p = Point { x: 10, y: 20 }
    i32 val = p.x
    c::printf("member ok\n")

    i32 ival = 10
    v := Vec2 { x: ival, y: 10 }

    i32 res = sum(v.x, v.y)
    c::printf("%d\n", res)

    *Point ptr = c::malloc(sizeof Point)

    return res - res
}
