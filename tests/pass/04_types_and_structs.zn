foreign c {
    *u8 malloc(u64)
    u0 printf(*char, ...)
}

struct Vec2 {
    f32 x
    f32 y
}

struct Color {
    u8 r
    u8 g
    u8 b
}

struct Point {
    i32 x
    i32 y
}

struct Linked {
    i32 val
    *Linked next
}

f32 sum(f64 x, f64 y) {
    return x + y
}

i32 main() {
    Point p = Point { x: 10, y: 20 }
    i32 val = p.x
    c::printf("member ok\n")

    i32 ival = 10
    v := Vec2 { x: ival, y: 10 }

    i32 res = sum(v.x, v.y)
    c::printf("%d\n", res)

    *Point ptr = c::malloc(sizeof Point)

    return res - res
}
