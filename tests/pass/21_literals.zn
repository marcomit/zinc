c :: foreign {
    printf :: u0 (*char, ...)
}

main :: i32 () {
    // Integer literals
    i32 zero = 0
    i32 pos = 42
    i32 large = 1000000
    c::printf("%d\n", zero)
    c::printf("%d\n", pos)
    c::printf("%d\n", large)

    // Negative (unary minus on literal)
    i32 neg = -1
    i32 neg2 = -100
    c::printf("%d\n", neg)
    c::printf("%d\n", neg2)

    // Float literals
    f64 f1 = 3.14
    f64 f2 = 0.0
    f64 f3 = 1.0
    f64 f4 = 100.5
    c::printf("%.2f\n", f1)
    c::printf("%.1f\n", f2)
    c::printf("%.1f\n", f3)
    c::printf("%.1f\n", f4)

    // f32 assignment (implicit narrowing)
    f32 g1 = 2.5
    f32 g2 = 0.0
    c::printf("%.1f\n", g1)
    c::printf("%.1f\n", g2)

    // Float arithmetic
    f64 pi = 3.14
    f64 two = 2.0
    c::printf("%.2f\n", pi * two)

    // Boolean literals
    u1 tval = true
    u1 fval = false
    if tval { c::printf("true\n") }
    if not fval { c::printf("false_inverted\n") }
    c::printf("%d\n", tval)
    c::printf("%d\n", fval)

    // String escape sequences
    c::printf("tab:\there\n")
    c::printf("backslash:\\\n")
    c::printf("quote:\"\n")

    // none as null
    *i32 p = none
    if p == none { c::printf("null_ok\n") }

    // Large integer values
    i32 maxval = 2147483647
    c::printf("%d\n", maxval)

    // Various integer types
    u8  u8val  = 255
    u16 u16val = 65535
    u32 u32val = 4294967295
    i8  i8val  = 127
    i16 i16val = 32767
    c::printf("%u\n", u8val)
    c::printf("%u\n", u16val)
    c::printf("%u\n", u32val)
    c::printf("%d\n", i8val)
    c::printf("%d\n", i16val)

    return 0
}
