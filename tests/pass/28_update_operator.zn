use <std::mem::gpa>
use <std::libc>

LinkedList :: struct {
    val: i32
    next: *LinkedList
}
LinkedList :: impl {
    new :: *LinkedList(next: *LinkedList, val: i32)[Allocator] {
        self: *LinkedList = alloc(sizeof LinkedList)
        self.next = next
        self.val = val
        return self
    }
}
*LinkedList self :: impl {
    print :: u0 () {
        if not self { return }
        io::printf("%d\n", self.val)
        self.next.print()
    }
}

main :: i32 () {
    gpa := GeneralPurposeAllocator::init()
    with _ := (&gpa).allocator() {
        i := 0
        root := LinkedList::new(none, 0)

        for (i) < 10 {
            root : LinkedList::new(i)
            i: + 1
        }

        for root {
            io::printf("%d\n", root.val)
            root : .next
        }

        flag := false
        flag : not
    }
    return 0
}
