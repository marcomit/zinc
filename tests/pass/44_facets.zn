printf :: foreign fn (*char, ..) void

Entity :: facet {
    draw : fn () void
    update : fn () void
}

Circle :: struct {
    radius: i32
}

Rect :: struct {
    width: i32
    height: i32
}

Circle :: impl(Entity) {
    draw :: fn (*self) void {
        printf("Circle{radius: %d}\n", self.radius)
    }

    update :: fn (*self) void {
        self.radius += 1
    }
}

Rect :: impl(Entity) {
    draw :: fn (*self) void {
        printf("Rect{w:%d, h:%d}\n", self.width, self.height)
    }

    update :: fn (*self) void {

    }
}

draw :: fn (entity: Entity) void -> entity.draw()

main :: fn () i32 {
    rect            := Rect{width = 10, height = 12}.&
    circle          := Circle{radius = 10}.&
    entity: Entity  = rect
    draw(entity)

    entities := [
        Entity(rect),
        Entity(circle),
        Entity(rect),
        Entity(circle)
    ]

    for i in 0..entities.len {
        draw(entities[i])
    }

    return 0
}
