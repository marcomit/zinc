printf :: foreign fn (*char, ..) u0

Entity :: facet {
    draw : fn () u0
    update : fn () u0
}

Circle :: struct {
    radius: i32
}

Rect :: struct {
    width: i32
    height: i32
}

*Circle self :: impl(Entity) {
    draw :: fn () u0 {
        printf("Circle{radius: %d}\n", self.radius)
    }

    update :: fn () u0 {
        self.radius += 1
    }
}

*Rect self :: impl(Entity) {
    draw :: fn () u0 {
        printf("Rect{w:%d, h:%d}\n", self.width, self.height)
    }

    update :: fn () u0 {

    }
}

draw :: fn (entity: Entity) u0 -> entity.draw()

main :: fn () i32 {
    rect            := Rect{width = 10, height = 12}.&
    circle          := Circle{radius = 10}.&
    entity: Entity  = rect
    draw(entity)

    entities := [
        Entity(rect),
        Entity(circle),
        Entity(rect),
        Entity(circle)
    ]

    i := 0
    for i < entities.len {
        draw(entities[i])
        i += 1
    }

    return 0
}
