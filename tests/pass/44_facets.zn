foreign printf :: u0 (*char, ...)

Entity :: facet {
    draw :: u0 ()
    update :: u0 ()
}

Circle :: struct {
    radius: i32
}

Rect :: struct {
    width: i32
    height: i32
}

*Circle self :: impl Entity {
    draw :: u0 () {
        printf("Circle{radius: %d}\n", self.radius)
    }

    update :: u0 () {
        self.radius: + 0.1
    }
}

*Rect self :: impl Entity {
    draw :: u0 () {
        printf("Rect{w:%d, h:%d}\n", self.width, self.height)
    }

    update :: u0 () {
        
    }
}


main :: i32 () {
    entity: Entity = &Rect{width: 10.0, height: 12.0}
    entity.draw()
    entity = &Circle{radius: 10.0}
    return 0
}
