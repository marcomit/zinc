printf :: foreign fn (*char) void

greet :: fn () void -> printf("greet\n")

say_bye :: fn () void -> printf("bye\n")

print_msg :: fn (msg: *char) void -> printf(msg)

add :: fn (a: i32, b: i32) i32 -> a + b

Vec :: struct { len: i32 }

Counter :: struct { count: i32 }

Vec :: impl {
    create :: fn () void -> printf("Vec:new\n")
}

Counter :: impl {
    say :: fn (msg: *char) void -> printf(msg)
    value :: fn () i32 -> 65
}

main :: fn () i32 {
    greet()
    say_bye()
    print_msg("msg\n")

    r: i32 = add(3, 4)
    printf("add\n")

    Vec.create()
    Counter.say("hello\n")
    Counter.say("world\n")

    v   := Counter.value()
    val: i32 = Counter.value()

    return 0
}
