foreign printf :: u0 (*char)

greet :: u0 () -> printf("greet\n")

say_bye :: u0 () -> printf("bye\n")

print_msg :: u0 (*char msg) -> printf(msg)

add :: i32 (i32 a, i32 b) -> a + b

Vec :: struct { i32 len }

Counter :: struct { i32 count }

Vec :: impl {
    create :: u0 () -> printf("Vec:new\n")
}

Counter :: impl {
    say :: u0 (*char msg) -> printf(msg)
    value :: i32 () -> 65
}

main :: i32 () {
    greet()
    say_bye()
    print_msg("msg\n")

    i32 r = add(3, 4)
    printf("add\n")

    Vec::create()
    Counter::say("hello\n")
    Counter::say("world\n")

    v   := Counter::value()
    i32 val = Counter::value()

    return 0
}
