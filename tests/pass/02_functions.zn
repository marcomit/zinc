foreign printf :: fn (*char) u0

greet :: fn () u0 -> printf("greet\n")

say_bye :: fn () u0 -> printf("bye\n")

print_msg :: fn (msg: *char) u0 -> printf(msg)

add :: fn (a: i32, b: i32) i32 -> a + b

Vec :: struct { len: i32 }

Counter :: struct { count: i32 }

Vec :: impl {
    create :: fn () u0 -> printf("Vec:new\n")
}

Counter :: impl {
    say :: fn (msg: *char) u0 -> printf(msg)
    value :: fn () i32 -> 65
}

main :: fn () i32 {
    greet()
    say_bye()
    print_msg("msg\n")

    r: i32 = add(3, 4)
    printf("add\n")

    Vec::create()
    Counter::say("hello\n")
    Counter::say("world\n")

    v   := Counter::value()
    val: i32 = Counter::value()

    return 0
}
