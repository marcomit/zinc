foreign printf :: u0 (*char)

greet :: u0 () -> printf("greet\n")

say_bye :: u0 () -> printf("bye\n")

print_msg :: u0 (msg: *char) -> printf(msg)

add :: i32 (a: i32, b: i32) -> a + b

Vec :: struct { len: i32 }

Counter :: struct { count: i32 }

Vec :: impl {
    create :: u0 () -> printf("Vec:new\n")
}

Counter :: impl {
    say :: u0 (msg: *char) -> printf(msg)
    value :: i32 () -> 65
}

main :: i32 () {
    greet()
    say_bye()
    print_msg("msg\n")

    r: i32 = add(3, 4)
    printf("add\n")

    Vec::create()
    Counter::say("hello\n")
    Counter::say("world\n")

    v   := Counter::value()
    val: i32 = Counter::value()

    return 0
}
