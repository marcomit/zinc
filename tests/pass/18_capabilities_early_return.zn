use <std::mem::gpa>
use <std::mem>
use <std::libc>


allocate :: i32 (size: u64)[alloc: Allocator] {
    _ := alloc.alloc(size)
    return 7
}

run :: i32 () {
    gpa := GeneralPurposeAllocator::init()
    with _ := (&gpa).allocator() {
        return allocate(32)
    }
}

main :: i32 () {
    io::printf("%d\n", run())
    return 0
}
