// Early return from inside a capability block.
// The function returns before the `with` scope ends normally.

use <core::mem>

c :: foreign {
    printf :: u0 (*char, ...)
}

allocate :: i32 (size: u64)[alloc: Allocator] {
    _ := alloc.alloc(size)
    return 7
}

run :: i32 () {
    with _ := Allocator::heap() {
        return allocate(32)
    }
}

main :: i32 () {
    c::printf("%d\n", run())
    return 0
}
