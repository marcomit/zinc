foreign printf :: fn (*char, ...) u0

map :: fn (nums: []i32, iter: fn(i32) i32) u0 {
    i := 0
    for i < nums.len {
        nums[i] = iter(nums[i])
        i += 1
    }
}

printNums :: fn (nums: []i32) u0 {
    i := 0
    printf("NUMS: ")
    for i < nums.len {
        printf("%d ", nums[i])
        i += 1
    }
    printf("\n")
}

main :: fn () i32 {
    square := fn (x: i32) i32 -> x * x
    nums := [1, 2, 3, 4]

    printNums(nums)

    map(nums, fn (x) -> x * x)
    printNums(nums)

    map(nums, square)
    printNums(nums)


    return 0
}
