printf :: foreign fn (*char, ...) u0

Point :: struct {
    x: i32
    y: i32
}

main :: fn () i32 {
    /* Basic arithmetic compound operators. */
    a: i32 = 10
    a += 5
    a -= 3
    a *= 4
    a /= 2
    printf("a=%d\n", a)

    /* Bitwise compound operators. */
    b: u32 = 0b1010
    b |= 0b0101
    b &= 0b1101
    b ^= 0b0001
    printf("b=%u\n", b)

    /* Shift compound operators. */
    s: u32 = 3
    s <<= 4
    s >>= 2
    printf("s=%u\n", s)

    /* Implicit cast: int literal added to a float lvalue. */
    f: f64 = 1.5
    f += 1
    f *= 2
    printf("f=%f\n", f)

    /* Implicit cast: wider rhs coerced to the lhs type. */
    w: i32 = 1
    big: i64 = 5
    w += big
    printf("w=%d\n", w)

    /* Compound assignment through member and subscript lvalues. */
    p := Point { x: 1, y: 2 }
    p.x += 9
    p.y <<= 3
    printf("p=%d,%d\n", p.x, p.y)

    arr := [1, 2, 3]
    arr[1] *= 10
    arr[2] += arr[0]
    printf("arr=%d,%d,%d\n", arr[0], arr[1], arr[2])

    /* Compound assignment inside a loop condition body. */
    i := 0
    total := 0
    for i < 5 {
        total += i
        i += 1
    }
    printf("total=%d\n", total)

    return 0
}
