printf :: foreign fn (*char, ..) void

Logger :: struct { level: i32 }
Context :: struct { val: i32 }

print_ctx :: fn () void with c: Context -> printf("%d\n", c.val)
print_logger :: fn () void with l: Logger -> printf("%d\n", l.level)

transitive :: fn () void with Context, Logger -> print_logger()

test :: fn () void with Logger, Context {
    transitive()
    print_ctx()
}

main :: fn () i32 {
    with _ := Logger { level = 10 } {
        with _ := Context { val = 10 } {
            test()
        }
    }

    return 0
}
