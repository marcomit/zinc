printf :: foreign fn (*char, ...) u0

Logger :: struct { level: i32 }
Context :: struct { val: i32 }

print_ctx :: fn () u0 with c: Context -> printf("%d\n", c.val)
print_logger :: fn () u0 with l: Logger -> printf("%d\n", l.level)

transitive :: fn () u0 with Context, Logger -> print_logger()

test :: fn () u0 with Logger, Context {
    transitive()
    print_ctx()
}

main :: fn () i32 {
    with _ := Logger { level : 10 } {
        with _ := Context { val: 10 } {
            test()
        }
    }

    return 0
}
