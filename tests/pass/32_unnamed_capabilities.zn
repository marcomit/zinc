foreign printf :: u0 (*char, ...)

Logger :: struct { level: i32 }
Context :: struct { val: i32 }

print_ctx :: u0 ()[c: Context] -> printf("%d\n", c.val)
print_logger :: u0 ()[l: Logger] -> printf("%d\n", l.level)

transitive :: u0 ()[Context, Logger] -> print_logger()

test :: u0 ()[Logger, Context] {
    transitive()
    print_ctx()
}

main :: i32 () {
    with _ := Logger { level : 10 } {
        with _ := Context { val: 10 } {
            test()
        }
    }

    return 0
}
