Logger :: struct  {
    level: i32
}

allocAndLog :: fn (size: u64) i32 with alloc: Allocator, log: Logger {
    buf: *u8 = alloc.alloc(size) as *u8
    return log.level
}

main :: fn () i32 {
    with log := Logger { level = 42 } {
        with heap := GeneralPurposeAllocator.new() {
            r := allocAndLog(16)
            io.printf("%d\n", r)
        }
    }
    return 0
}
