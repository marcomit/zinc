// Function requiring two different capability types (Allocator and Logger).
// Each type is provided by a separate nested `with` block;
// lookupScopedCapability walks parent scopes so both are found at the call site.

use <core::mem>

c :: foreign {
    printf :: u0 (*char, ...)
}

Logger :: struct  {
    level: i32
}

allocAndLog :: i32 (size: u64)[alloc: Allocator, log: Logger] {
    buf: *u8 = alloc.alloc(size)
    return log.level
}

main :: i32 () {
    with log := Logger { level: 42 } {
        with heap := Allocator::heap() {
            r := allocAndLog(16)
            c::printf("%d\n", r)
        }
    }
    return 0
}
