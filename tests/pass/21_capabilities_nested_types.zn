use <std.mem.gpa>
use <std.mem>
use <std.libc>

Logger :: struct  {
    level: i32
}

allocAndLog :: fn (size: u64) i32 with alloc: Allocator, log: Logger {
    buf: *u8 = alloc.alloc(size)
    return log.level
}

main :: fn () i32 {
    with log := Logger { level = 42 } {
        gpa := GeneralPurposeAllocator.init()
        with heap := gpa.&.allocator() {
            r := allocAndLog(16)
            io.printf("%d\n", r)
        }
    }
    return 0
}
