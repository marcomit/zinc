use <std::mem::gpa>
use <std::libc>

Logger :: struct  {
    level: i32
}

allocAndLog :: i32 (size: u64)[alloc: Allocator, log: Logger] {
    buf: *u8 = alloc.alloc(size)
    return log.level
}

main :: i32 () {
    with log := Logger { level: 42 } {
        gpa := GeneralPurposeAllocator::init()
        with heap := (&gpa).allocator() {
            r := allocAndLog(16)
            io::printf("%d\n", r)
        }
    }
    return 0
}
