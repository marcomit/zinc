c :: foreign {
    printf :: u0 (*char, ...)
}

Vec2 :: struct  {
    i32 x
    i32 y
}

Rect :: struct  {
    i32 x
    i32 y
    i32 w
    i32 h
}

Vec2 :: for  {
    zero :: Vec2 () -> Vec2 { x: 0, y: 0 }
    from :: Vec2 (i32 x, i32 y) -> Vec2 { x: x, y: y }
}

Vec2 self :: for {
    len2 :: i32 ()  -> self.x * self.x + self.y * self.y
    scale :: Vec2 (i32 s) -> Vec2 { x: self.x * s, y: self.y * s }
    add :: Vec2 (Vec2 other) -> Vec2 { x: self.x + other.x, y: self.y + other.y }
    print :: u0 () -> c::printf("(%d,%d)\n", self.x, self.y)
    sum :: i32 ()   -> self.x + self.y
}

Rect :: for  {
    make :: Rect (i32 x, i32 y, i32 w, i32 h) -> Rect { x: x, y: y, w: w, h: h }
}

Rect self :: for {
    area :: i32 ()    -> self.w * self.h
    perimeter :: i32 () -> 2 * (self.w + self.h)
    contains :: u1 (i32 px, i32 py) {
        return px >= self.x and px < self.x + self.w and
               py >= self.y and py < self.y + self.h
    }
    print :: u0 () -> c::printf("Rect(%d,%d,%d,%d)\n", self.x, self.y, self.w, self.h)
}

i32 self :: for {
    abs :: i32 () {
        if self < 0 { return -self }
        return self
    }
    clamp :: i32 (i32 lo, i32 hi) {
        if self < lo { return lo }
        if self > hi { return hi }
        return self
    }
    print :: u0 () -> c::printf("%d\n", self)
}

main :: i32 () {
    // Static method calls
    Vec2 origin = Vec2::zero()
    origin.print()

    Vec2 pt = Vec2::from(3, 4)
    pt.print()

    // Receiver method chaining (each method returns value)
    Vec2 scaled = pt.scale(2)
    scaled.print()

    // Using return value directly
    Vec2::from(1, 2).print()
    Vec2::from(5, 5).scale(3).print()

    // Chained arithmetic on receiver results
    c::printf("%d\n", pt.len2())
    c::printf("%d\n", pt.sum())
    c::printf("%d\n", pt.scale(3).sum())

    // Receiver on struct result from static
    c::printf("%d\n", Vec2::from(2, 3).len2())

    // Receiver methods on i32
    i32 neg = -5
    c::printf("%d\n", neg.abs())

    i32 val = 15
    c::printf("%d\n", val.clamp(0, 10))
    c::printf("%d\n", val.clamp(20, 30))

    // Method chaining: abs().clamp()
    c::printf("%d\n", neg.abs().clamp(0, 3))

    // Rect static and receiver
    Rect r = Rect::make(0, 0, 10, 5)
    r.print()
    c::printf("%d\n", r.area())
    c::printf("%d\n", r.perimeter())

    if r.contains(5, 3)  { c::printf("inside\n") }
    if not r.contains(11, 3) { c::printf("outside\n") }

    // Vec2 add two vectors
    Vec2 v1 = Vec2::from(1, 2)
    Vec2 v2 = Vec2::from(3, 4)
    v1.add(v2).print()

    // Multiple instances, independent state
    Vec2 a = Vec2::from(10, 20)
    Vec2 b = Vec2::from(30, 40)
    c::printf("%d\n", a.sum())
    c::printf("%d\n", b.sum())

    return 0
}
