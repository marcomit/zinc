foreign c {
    u0 printf(*char, ...)
}

i32 main() {
    i32 a = 10
    i32 b = 20

    *i32 p = none
    *i32 r1 = p ?? &b
    c::printf("%d\n", *r1)

    *i32 q = &a
    *i32 r2 = q ?? &b
    c::printf("%d\n", *r2)

    *i32 n1 = none
    *i32 n2 = none
    *i32 r3 = n1 ?? n2 ?? &b
    c::printf("%d\n", *r3)

    *i32 r4 = n1 ?? &a
    c::printf("%d\n", *r4)

    i32 x = 5
    *i32 px = none
    c::printf("%d\n", *(px ?? &x))

    return 0
}
