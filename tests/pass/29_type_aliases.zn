foreign printf :: u0 (*char, ...)
foreign exit :: u0 (i32)

void  :: type u0
bool  :: type u1
int   :: type i32
uint  :: type u32
byte  :: type u8
float :: type f32

scalar :: type float   // alias of an alias
index  :: type uint    // alias of an alias

Point :: struct {
    float x
    float y
}

V2     :: type Point    // struct alias
V2ptr  :: type *Point   // pointer-to-struct alias
byteptr :: type *byte   // pointer alias of aliased primitive

add_scalar :: float (scalar a, scalar b) -> a + b

print_point :: void (V2ptr p) {
    printf("(%.0f, %.0f)\n", p.x, p.y)
}

is_positive :: bool (int n) -> n > 0

V2 self :: impl {
    len :: float () -> self.x * self.x + self.y * self.y
    scale :: V2 (scalar factor) -> V2{x: self.x * factor, y: self.y * factor}
}

main :: int () {
    V2 a = Point{x: 3.0, y: 4.0}

    Point b = V2{x: 1.0, y: 2.0}

    scalar s = 2.0
    index  i = 0
    
    V2ptr pa = &a
    
    print_point(pa)
    
    float l = b.len()
    printf("len sq: %.0f\n", l)
    
    Point scaled = a.scale(s)
    printf("scaled: %.0f %.0f\n", scaled.x, scaled.y)
    
    bool pos = is_positive(-5)
    if pos -> printf("positive\n")
    else   -> printf("not positive\n")


    return 0
}
