printf :: foreign fn (*char, ...) u0
exit :: foreign fn (i32) u0

void  :: type u0
bool  :: type u1
int   :: type i32
uint  :: type u32
byte  :: type u8
float :: type f32

scalar :: type float   // alias of an alias
index  :: type uint    // alias of an alias

Point :: struct {
    x: float
    y: float
}

V2     :: type Point    // struct alias
V2ptr  :: type *Point   // pointer-to-struct alias
byteptr :: type *byte   // pointer alias of aliased primitive

add_scalar :: fn (a: scalar, b: scalar) float -> a + b

print_point :: fn (p: V2ptr) void {
    printf("(%.0f, %.0f)\n", p.x, p.y)
}

is_positive :: fn (n: int) bool -> n > 0

V2 self :: impl {
    len :: fn () float -> self.x * self.x + self.y * self.y
    scale :: fn (factor: scalar) V2 -> V2{x: self.x * factor, y: self.y * factor}
}

main :: fn () int {
    a: V2 = Point{x: 3.0, y: 4.0}

    b: Point = V2{x: 1.0, y: 2.0}

    s: scalar = 2.0
    i: index = 0

    pa: V2ptr = &a

    print_point(pa)

    l: float = b.len()
    printf("len sq: %.0f\n", l)

    scaled: Point = a.scale(s)
    printf("scaled: %.0f %.0f\n", scaled.x, scaled.y)

    pos: bool = is_positive(-5)
    if pos do printf("positive\n")
    else   do printf("not positive\n")


    return 0
}
