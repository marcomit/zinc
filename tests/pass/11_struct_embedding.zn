c :: foreign {
    printf :: u0 (*char, ...)
}

Position :: struct {
    i32 x
    i32 y
    i32 z
}

Velocity :: struct {
    i32 vx
    i32 vy
    i32 vz
}

Acceleration :: struct {
    i32 ax
    i32 ay
    i32 az
}

Metadata :: struct {
    u32 flags
    *char name
}

Stats :: struct {
    i32 health
    i32 stamina
}

// Flatten-safe composition
Player :: struct  {
    ...Position
    ...Velocity
    ...Acceleration
    ...Metadata
    ...Stats
}

Player self :: impl {
    update :: u0 () {
        self.vx = self.vx + self.ax
        self.vy = self.vy + self.ay
        self.vz = self.vz + self.az

        self.x = self.x + self.vx
        self.y = self.y + self.vy
        self.z = self.z + self.vz
    }

    print :: u0 () {
        c::printf("%s\n", self.name)
        c::printf("Pos: %d %d %d\n", self.x, self.y, self.z)
        c::printf("Vel: %d %d %d\n", self.vx, self.vy, self.vz)
        c::printf("HP: %d\n", self.health)
    }
}

main :: i32 () {
    p := Player {
        name: "Hero",

        x: 0, y: 0, z: 0,
        vx: 1, vy: 0, vz: 0,
        ax: 0.1, ay: 0.2, az: 0,

        health: 100,
        stamina: 50
    }

    p.update()
    p.print()

    return 0
}
