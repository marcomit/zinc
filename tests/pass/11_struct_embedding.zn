c :: foreign {
    printf : fn (*char, ...) u0
}

Position :: struct {
    x: i32
    y: i32
    z: i32
}

Velocity :: struct {
    vx: i32
    vy: i32
    vz: i32
}

Acceleration :: struct {
    ax: i32
    ay: i32
    az: i32
}

Metadata :: struct {
    flags: u32
    name: *char
}

Stats :: struct {
    health: i32
    stamina: i32
}

// Flatten-safe composition
Player :: struct  {
    ...Position
    ...Velocity
    ...Acceleration
    ...Metadata
    ...Stats
}

Player self :: impl {
    update :: fn () u0 {
        self.vx = self.vx + self.ax
        self.vy = self.vy + self.ay
        self.vz = self.vz + self.az

        self.x = self.x + self.vx
        self.y = self.y + self.vy
        self.z = self.z + self.vz
    }

    print :: fn () u0 {
        c.printf("%s\n", self.name)
        c.printf("Pos: %d %d %d\n", self.x, self.y, self.z)
        c.printf("Vel: %d %d %d\n", self.vx, self.vy, self.vz)
        c.printf("HP: %d\n", self.health)
    }
}

main :: fn () i32 {
    p := Player {
        name: "Hero",

        x: 0, y: 0, z: 0,
        vx: 1, vy: 0, vz: 0,
        ax: 0.1, ay: 0.2, az: 0,

        health: 100,
        stamina: 50
    }

    p.update()
    p.print()

    return 0
}
