c :: foreign { printf : fn (*char, ...) u0 }

Pt :: struct { x: i32 y: i32 }

main :: fn () i32 {
    arr := [
        Pt { x: 10, y: 20 },
        Pt { x: 30, y: 40 },
        Pt { x: 50, y: 60 },
        Pt { x: 70, y: 80 }
    ]
    c.printf("%d,%d\n", arr[0].x, arr[0].y)
    c.printf("%d,%d\n", arr[0].x, arr[0].y)
    c.printf("%d,%d\n", arr[0].x, arr[0].y)
    return 0
}
