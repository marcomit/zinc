c :: foreign {
    printf : fn (*char, ...) u0
}

Shape :: enum {
    Circle(i32)
    Rect(i32, i32)
    Point
}

Vec2 :: struct {
    x: i32
    y: i32
}

Segment :: struct {
    a: Vec2
    b: Vec2
}

Entity :: struct {
    pos: Vec2
    shape: Shape
}

tag :: fn (s: Shape) i32 {
    if .Circle(r) := s {
        return r
    } else if .Rect(w, h) := s {
        return w + h
    }
    return 0
}

mag :: fn (v: Vec2) i32 {
    return v.x + v.y
}

pick :: fn (n: i32) Shape {
    if n == 0 {
        return .Point()
    }
    return if n > 0 -> .Circle(n) else -> .Rect(n, n)
}

origin :: fn () Vec2 {
    return .{ x: 0, y: 0 }
}

main :: fn () i32 {
    c::printf("%d\n", tag(.Circle(3)))
    c::printf("%d\n", tag(.Rect(2, 3)))
    c::printf("%d\n", tag(.Point()))

    s: Shape = .Circle(4)
    if .Circle(r) := s {
        c::printf("%d\n", r)
    }

    c::printf("%d\n", tag(pick(7)))
    c::printf("%d\n", tag(pick(-2)))
    c::printf("%d\n", tag(pick(0)))

    v: Vec2 = .{ x: 1, y: 2 }
    c::printf("%d\n", mag(v))
    c::printf("%d\n", mag(.{ x: 3, y: 4 }))
    c::printf("%d\n", mag(origin()))

    seg: Segment = .{ a: .{ x: 1, y: 1 }, b: .{ x: 2, y: 2 } }
    c::printf("%d\n", mag(seg.a) + mag(seg.b))

    e: Entity = .{ pos: .{ x: 9, y: 9 }, shape: .Circle(8) }
    c::printf("%d\n", tag(e.shape))

    shapes: [2]Shape = [.Circle(1), .Rect(2, 2)]
    c::printf("%d %d\n", tag(shapes[0]), tag(shapes[1]))

    return 0
}
