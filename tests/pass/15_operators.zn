c :: foreign {
    printf :: u0 (*char, ...)
}

main :: i32 () {
    i32 a = 10
    i32 b = 3

    c::printf("%d\n", a + b)
    c::printf("%d\n", a - b)
    c::printf("%d\n", a * b)
    c::printf("%d\n", a / b)
    c::printf("%d\n", a % b)
    c::printf("%d\n", -a)
    c::printf("%d\n", +a)

    i32 x = 5
    if x == 5  { c::printf("eq\n") }
    if x != 4  { c::printf("neq\n") }
    if x > 4   { c::printf("gt\n") }
    if x < 6   { c::printf("lt\n") }
    if x >= 5  { c::printf("gte\n") }
    if x <= 5  { c::printf("lte\n") }

    u1 t = true
    u1 f = false

    if t and t  { c::printf("and_tt\n") }
    if t and f  { c::printf("FAIL\n") } else { c::printf("and_tf\n") }
    if f or t   { c::printf("or_ft\n") }
    if f or f   { c::printf("FAIL\n") } else { c::printf("or_ff\n") }
    if not f    { c::printf("not_f\n") }
    if not t    { c::printf("FAIL\n") } else { c::printf("not_t\n") }

    // Operator precedence: * before +
    i32 r = 2 + 3 * 4
    c::printf("%d\n", r)

    // Parentheses override precedence
    i32 r2 = (2 + 3) * 4
    c::printf("%d\n", r2)

    // Comparison in and-chain
    i32 y = 3
    if y > 1 and y < 5 { c::printf("range\n") }

    // Unsigned mod
    u32 ua = 17
    u32 ub = 5
    c::printf("%u\n", ua % ub)

    // Negative mod (signed, C semantics: result has sign of dividend)
    i32 na = -7
    i32 nb = 3
    c::printf("%d\n", na % nb)

    // Exact boundary
    i32 z = 10
    if z >= 10 and z <= 10 { c::printf("exact\n") }

    // not on bool
    u1 bval = false
    if not bval { c::printf("bool_not\n") }

    // Division truncation toward zero for negatives
    i32 neg = -9
    i32 pos = 2
    c::printf("%d\n", neg / pos)

    // Nested arithmetic expression
    c::printf("%d\n", (a + b) * (a - b))

    return 0
}
