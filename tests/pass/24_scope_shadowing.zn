c :: foreign {
    printf :: u0 (*char, ...)
}

outer_fn :: i32 () -> 100

inner_fn :: i32 (x: i32) -> x * 2

main :: i32 () {
    // Variable shadowing in nested scopes via for loops
    x := 1
    c::printf("%d\n", x)

    i := 0
    for i < 3 {
        // 'x' in this scope refers to outer x (zinc doesn't shadow, just reads it)
        c::printf("%d\n", x)
        i = i + 1
    }

    // Reassign outer variable inside loop
    j := 0
    sum := 0
    for j < 5 {
        sum = sum + j
        j = j + 1
    }
    c::printf("%d\n", sum)

    // Variable used in if body
    flag := 1
    if flag == 1 {
        local := 99
        c::printf("%d\n", local)
    }

    // Multiple function scopes
    c::printf("%d\n", outer_fn())
    c::printf("%d\n", inner_fn(5))
    c::printf("%d\n", inner_fn(inner_fn(3)))

    // Nested function calls
    c::printf("%d\n", inner_fn(outer_fn()))

    // Variable used across different branches
    result := 0
    condition := 7
    if condition > 5 {
        result = condition * 2
    } else {
        result = condition + 1
    }
    c::printf("%d\n", result)

    // Counter updated across loop iterations
    total := 0
    k := 1
    for k <= 10 {
        total = total + k
        k = k + 1
    }
    c::printf("%d\n", total)

    // Nested loop with accumulator
    grid := 0
    r := 0
    for r < 4 {
        col := 0
        for col < 4 {
            grid = grid + 1
            col = col + 1
        }
        r = r + 1
    }
    c::printf("%d\n", grid)

    // Complex expression result stored and reused
    a := 3
    b := 4
    hyp2 := a * a + b * b
    c::printf("%d\n", hyp2)

    // Function results in expressions
    base := outer_fn()
    doubled := inner_fn(base)
    halved := doubled / 2
    c::printf("%d %d %d\n", base, doubled, halved)

    return 0
}
