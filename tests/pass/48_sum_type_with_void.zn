foreign printf :: u0 (*char, ...)

Range :: struct {
    end:        i32
    current:    i32
}

range :: Range (start: i32, end: i32) -> Range {end: end, current:start}

*Range self :: impl {
    next :: u0 | i32 () {
        if self.current >= self.end { return }
        res := self.current
        self.current: + 1
        return res
    }
}

main :: i32 () {
    for i32(i) in range(0, 10) {
        printf("%d\n", i)
    }
    return 0
}
