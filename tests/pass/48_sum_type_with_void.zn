printf :: foreign fn (*char, ...) u0

Range :: struct {
    end:        i32
    current:    i32
}

range :: fn (start: i32, end: i32) Range -> .{end: end, current:start}

*Range self :: impl {
    next :: fn () ?i32 {
        if self.current >= self.end return none
        defer self.current += 1
        return self.current
    }
}

main :: fn () i32 {
    for i in range(0, 10) {
        printf("%d\n", i)
    }
    return 0
}
