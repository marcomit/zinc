c :: foreign {
    printf : fn (*char, ..) u0
    malloc : fn (u64) *u8
}

Node :: struct {
    val: i32
    next: *Node
}

main :: fn () i32 {
    head: *Node = none
    i := 5
    for i > 0 {
        n := c.malloc(sizeof Node) as *Node
        n.val = i
        n.next = head
        head = n
        i = i - 1
    }
    sum := 0
    cur := head
    for cur != none {
        sum = sum + cur.val
        c.printf("%d ", cur.val)
        cur = cur.next
    }
    c.printf("\nsum=%d\n", sum)
    return 0
}
