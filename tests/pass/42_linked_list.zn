c :: foreign {
    printf :: u0 (*char, ...)
    malloc :: *u8 (u64)
}

Node :: struct {
    val: i32
    next: *Node
}

main :: i32 () {
    head: *Node = none
    i := 5
    for i > 0 {
        n := c::malloc(sizeof Node) as *Node
        n.val = i
        n.next = head
        head = n
        i = i - 1
    }
    sum := 0
    cur := head
    for cur != none {
        sum = sum + cur.val
        c::printf("%d ", cur.val)
        cur = cur.next
    }
    c::printf("\nsum=%d\n", sum)
    return 0
}
