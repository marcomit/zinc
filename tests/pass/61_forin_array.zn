printf :: foreign fn (*char, ..) u0

sumAll :: fn (s: []i32) i32 {
    total := 0
    for v in s {
        total += v
    }
    return total
}

main :: fn () i32 {
    arr: [4]i32 = [10, 20, 30, 40]


    printf("values\n")
    for v in arr {
        printf("%d\n", v)
    }


    printf("indexed\n")
    for (v, i) in arr {
        printf("%llu:%d\n", i, v)
    }

    printf("break\n")
    for v in arr {
        if v == 30 { break }
        printf("%d\n", v)
    }

    printf("continue\n")
    for v in arr {
        if v == 20 { continue }
        printf("%d\n", v)
    }

    printf("nested\n")
    small: [2]i32 = [1, 2]
    for a in small {
        for b in small {
            printf("%d%d\n", a, b)
        }
    }


    printf("slices\n")
    mid  := arr[1..3]
    tail := arr[2..]
    head := arr[..2]
    for v in mid {
        printf("m%d\n", v)
    }
    for v in tail {
        printf("t%d\n", v)
    }
    for v in head {
        printf("h%d\n", v)
    }

    printf("len\n")
    printf("%llu\n", mid.len)


    printf("defer\n")
    for v in small {
        defer printf("d%d\n", v)
        printf("b%d\n", v)
    }

    printf("sum\n")
    printf("%d\n", sumAll(arr[0..]))

    return 0
}
