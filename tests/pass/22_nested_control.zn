c :: foreign {
    printf : fn (*char, ...) u0
}

main :: fn () i32 {
    // Nested while loops
    i := 0
    for i < 3 {
        j := 0
        for j < 3 {
            c.printf("%d%d\n", i, j)
            j = j + 1
        }
        i = i + 1
    }

    // break exits only innermost loop
    outer := 0
    for outer < 3 {
        inner := 0
        for inner < 5 {
            if inner == 2 { break }
            c.printf("i%d\n", inner)
            inner = inner + 1
        }
        c.printf("o%d\n", outer)
        outer = outer + 1
    }

    // continue in inner loop
    row := 0
    for row < 2 {
        col := 0
        for col < 4 {
            col = col + 1
            if col % 2 == 0 { continue }
            c.printf("%d\n", col)
        }
        row = row + 1
    }

    // Nested C-style for loops
    x := 0
    for x < 3 {
        y := 0
        for y < 3 {
            if x == y { c.printf("diag%d\n", x) }
            y :+ 1
        }
        x :+ 1
    }

    // Nested if-else chains
    score: i32 = 75
    if score >= 90 {
        c.printf("A\n")
    } else {
        if score >= 80 {
            c.printf("B\n")
        } else {
            if score >= 70 {
                c.printf("C\n")
            } else {
                c.printf("F\n")
            }
        }
    }

    // break in nested for loop (C-style)
    found := -1
    idx := 0
    for idx < 10 {
        if idx * idx > 20 {
            found = idx
            break
        }
        idx :+ 1
    }
    c.printf("found=%d\n", found)

    // Loop with multiple continues and break
    cnt: i32 = 0
    k := 0
    for k < 20 {
        k = k + 1
        if k % 3 == 0 { continue }
        if k > 10 { break }
        cnt = cnt + 1
    }
    c.printf("cnt=%d\n", cnt)

    // Many conditions chained
    v: i32 = 5
    if v == 1      { c.printf("one\n") }
    else { if v == 5 { c.printf("five\n") }
    else { c.printf("other\n") } }

    return 0
}
