printf :: foreign fn (*char, ...) u0

Shape :: facet {
    area : fn () i32
    name : fn () u0
}

Circle :: struct {
    radius: i32
}

Rect :: struct {
    width: i32
    height: i32
}

*Circle self :: impl(Shape) {
    area :: fn () i32 -> self.radius * self.radius
    name :: fn () u0 -> printf("circle\n")
}

*Rect self :: impl(Shape) {
    area :: fn () i32 -> self.width * self.height
    name :: fn () u0 -> printf("rect\n")
}

report :: fn (s: Shape) u0 {
    s.name()
    printf("area=%d\n", s.area())
}

main :: fn () i32 {
    c := Circle{radius = 5}
    r := Rect{width = 3, height = 4}

    sc := Shape(c.&)
    sr := Shape(r.&)

    printf("%d\n", sc.area())
    printf("%d\n", sr.area())

    printf("%d\n", Shape(c.&).area())

    report(sc)
    report(sr)

    report(Shape(r.&))

    return 0
}
