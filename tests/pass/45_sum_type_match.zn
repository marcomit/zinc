c :: foreign {
    printf : fn (*char, ...) u0
}

pick :: fn (n: i32) i32 | *char | f32 {
    return  if n == 0 -> "zero"
            else      ->
                if n == 1 -> 3.5 as f32
                else      -> n
}

show :: fn (val: i32 | *char | f32) u0 {
    match val {
        i32(num)    -> c.printf("i32:%d\n", num),
        *char(msg)  -> c.printf("str:%s\n", msg),
        f32(f)      -> c.printf("f32:%f\n", f)
    }
}

main :: fn () i32 {
    show(pick(0))
    show(pick(1))
    show(pick(42))

    val: i32 | *char | f32 = pick(7)
    match val {
        i32(num)    -> c.printf("var:%d\n", num),
        *char(msg)  -> c.printf("var:%s\n", msg),
        f32(f)      -> c.printf("var:%f\n", f)
    }
    return 0
}
