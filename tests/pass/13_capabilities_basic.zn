use <std::libc>
use <std::mem::gpa>


fill :: i32 (size: u64)[alloc: Allocator] {
    _ := alloc.alloc(size)
    return 42
}

main :: i32 () {
    gpa := GeneralPurposeAllocator::init()
    with _ := (&gpa).allocator() {
        result: i32 = fill(64)
        io::printf("%d\n", result)
    }
    return 0
}
