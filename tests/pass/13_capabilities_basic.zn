use <std::libc>
use <std::mem>
use <std::mem::gpa>


fill :: fn (size: u64) i32 with alloc: Allocator {
    _ := alloc.alloc(size)
    return 42
}

main :: fn () i32 {
    gpa := GeneralPurposeAllocator.init()
    with _ := (&gpa).allocator() {
        result: i32 = fill(64)
        io.printf("%d\n", result)
    }
    return 0
}
