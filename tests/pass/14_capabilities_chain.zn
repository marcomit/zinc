use <std.mem.gpa>
use <std.mem>
use <std.libc>

allocInner :: fn (size: u64) *u8 with Allocator -> alloc(size)

allocOuter :: fn (size: u64) i32 with Allocator {
    buf := allocInner(size)
    defer buf
    return 7
}

main :: fn () i32 {
    gpa := GeneralPurposeAllocator.init()
    allocator := (&gpa).allocator()
    with _ := allocator {
        a: i32 = allocOuter(32)
        b: i32 = allocOuter(64)
        io.printf("%d %d\n", a, b)
    }

    with _ := allocator do allocInner(1024)
    return 0
}
