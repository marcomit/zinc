use <core::mem>

c :: foreign {
    printf :: u0 (*char, ...)
}

// allocInner requires the same capability as its caller.
// The capability is threaded automatically - no explicit passing.
allocInner :: *u8 (size: u64)[alloc: Allocator] -> alloc.alloc(size)

allocOuter :: i32 (size: u64)[alloc: Allocator] {
    buf := allocInner(size)
    return 7
}

main :: i32 () {
    with heap := Allocator::heap() {
        a: i32 = allocOuter(32)
        b: i32 = allocOuter(64)
        c::printf("%d %d\n", a, b)
    }
    return 0
}
