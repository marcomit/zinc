use <std::mem::gpa>
use <std::libc>

allocInner :: *u8 (size: u64)[Allocator] -> alloc(size)

allocOuter :: i32 (size: u64)[Allocator] {
    buf := allocInner(size)
    defer buf
    return 7
}

main :: i32 () {
    gpa := GeneralPurposeAllocator::init()
    allocator := (&gpa).allocator()
    with _ := allocator {
        a: i32 = allocOuter(32)
        b: i32 = allocOuter(64)
        io::printf("%d %d\n", a, b)
    }

    with _ := allocator -> allocInner(1024)
    return 0
}
