foreign c {
    u0 printf(*char, ...)
}

struct Inner {
    i32 value
    i32(i32) add
}

struct Outer {
    Inner a
    Inner b
}

for Inner self {
    i32 get() -> self.value
    i32 add(i32 n) -> self.value + n
}

for Outer self {
    i32 sum() {
        return self.a.get() + self.b.get()
    }
    i32 addToA(i32 n) {
        return self.a.add(n)
    }
}

for i32 self {
    u0 print() -> c::printf("%d\n", self)
}

i32 addInner(i32 val) -> val

i32 main() {
    
    Inner x = Inner { value: 3, add: addInner }
    Inner y = Inner { value: 4 }
    Outer o = Outer { a: x, b: y }

    x.get().print()
    o.a.get().print()
    o.b.get().print()
    o.a.add(2).print()


    o.sum().print()

    o.addToA(1).print()

    return 0
}
