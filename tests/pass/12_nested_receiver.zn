c :: foreign {
    printf : fn (*char, ...) u0
}

Inner :: struct {
    value:  i32
    add:    fn (i32) i32
}

Outer :: struct {
    a: Inner
    b: Inner
}

Inner self :: impl {
    get :: fn () i32 -> self.value
    add :: fn (n: i32) i32 -> self.value + n
}

Outer self :: impl {
    sum :: fn () i32 -> self.a.get() + self.b.get()
    addToA :: fn (n: i32) i32 -> self.a.add(n)
}

i32 self :: impl {
    print :: fn () u0 -> c.printf("%d\n", self)
}
addInner :: fn (val: i32) i32 -> val

main :: fn () i32 {

    x: Inner = Inner { value= 3, add= addInner }
    y: Inner = Inner { value= 4 }
    o: Outer = Outer { a= x, b= y }

    x.get().print()
    o.a.get().print()
    o.b.get().print()
    o.a.add(2).print()

    o.sum().print()

    o.addToA(1).print()

    return 0
}
