c :: foreign {
    printf :: u0 (*char, ...)
}

Inner :: struct {
    value:  i32
    add:    i32(i32)
}

Outer :: struct {
    a: Inner
    b: Inner
}

Inner self :: impl {
    get :: i32 () -> self.value
    add :: i32 (n: i32) -> self.value + n
}

Outer self :: impl {
    sum :: i32 () -> self.a.get() + self.b.get()
    addToA :: i32 (n: i32) -> self.a.add(n)
}

i32 self :: impl {
    print :: u0 () -> c::printf("%d\n", self)
}
addInner :: i32 (val: i32) -> val

main :: i32 () {
    
    x: Inner = Inner { value: 3, add: addInner }
    y: Inner = Inner { value: 4 }
    o: Outer = Outer { a: x, b: y }

    x.get().print()
    o.a.get().print()
    o.b.get().print()
    o.a.add(2).print()

    o.sum().print()

    o.addToA(1).print()

    return 0
}
