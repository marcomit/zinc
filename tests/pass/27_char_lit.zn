c :: foreign {
    printf : fn (*char, ...) u0
}

main :: fn () u32 {
    // ASCII rune printed as character and as integer value
    c::printf("%c\n", 'a')
    c::printf("%d\n", 'A')

    // Single-char escape sequences (values: 10, 9, 92, 39, 0)
    c::printf("%d\n", '\n')
    c::printf("%d\n", '\t')
    c::printf("%d\n", '\\')
    c::printf("%d\n", '\'')
    c::printf("%d\n", '\0')

    // \u 4-digit hex rune: U+0042 = 66
    c::printf("%d\n", '\u0042')

    // \U 8-digit hex rune: U+00000043 = 67
    c::printf("%d\n", '\U00000043')

    // multi-byte raw UTF-8 rune: é = U+00E9 = 233
    c::printf("%d\n", 'é')

    // rune arithmetic: 'z' - 'a' = 25
    c::printf("%d\n", 'z' - 'a')

    // \u in a string: U+0048 = H, produces "Hello"
    c::printf("%s\n", "\u0048ello")

    // \U in a string: U+0001F600 = 😀
    c::printf("%s\n", "\U0001F600")

    return 0
}
