use <std::mem::gpa>
use <std::mem>
use <std::libc>

allocate :: i32 (size: u64)[alloc: Allocator] {
    buf: *u8 = alloc.alloc(size)
    return 1
}

main :: i32 () {
    gpa := GeneralPurposeAllocator::init()
    with heap := (&gpa).allocator() {
        sum: i32 = 0
        i := 0
        for i < 3 {
            sum = sum + allocate(16)
            i :+ 1
        }
        io::printf("%d\n", sum)
    }
    return 0
}
