c :: foreign {
    printf : fn (*char, ...) u0
}

// Inline-if producing a sum type: branches have different types
classify :: fn (flag: i32) (*char | i32) {
    return if flag != 0 -> "str" else -> 42
}

// Direct return of a concrete variant
pick_str :: fn () (*char | i32) {
    return "hello"
}

pick_int :: fn () (*char | i32) {
    return 99
}

// Sum type via conditional branches (statement if)
describe :: fn (n: i32) (*char | i32) {
    if n > 0 { return "positive" }
    return 0
}

main :: fn () i32 {
    classify(1)
    classify(0)
    pick_str()
    pick_int()
    describe(5)
    describe(0)
    c.printf("sum types ok\n")
    return 0
}
