c :: foreign {
    printf : fn (*char, ..) u0
}

// Inline-if producing a sum type: branches have different types
classify :: fn (flag: i32) (i32 | []char) {
    return if flag != 0 do "str"
            else 42
}

// Direct return of a concrete variant
pick_str :: fn () (i32 | []char) {
    return "hello"
}

pick_int :: fn () (i32 | []char) {
    return 99
}

// Sum type via conditional branches (statement if)
describe :: fn (n: i32) (i32 | []char) {
    return if n > 0 do "positive" else 0
}

main :: fn () i32 {
    classify(1)
    classify(0)
    pick_str()
    pick_int()
    describe(5)
    describe(0)
    c.printf("sum types ok\n")
    return 0
}
