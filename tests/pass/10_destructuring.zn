c :: foreign {
    printf :: u0 (*char, ...)
}

Vec :: struct {
    x: i32
    y: i32
}

Vec :: impl {
    new :: Vec () -> Vec{ x: 10, y: 20 }
}

flatTuple       :: (i32, i32)() -> (1, 2)
labeledTuple    :: (*char, i32)() -> ("hello", 42)
nested          :: ((*char, Vec), i32)() -> (("ciao", Vec::new()), 99)

main :: i32 () {
    (a, b) := flatTuple()
    c::printf("%d %d\n", a, b)

    (name, num) := labeledTuple()
    c::printf("%s %d\n", name, num)

    {x, y} := Vec::new()
    c::printf("%d %d\n", x, y)

    {x: renamed, y: ry} := Vec::new()
    c::printf("%d %d\n", renamed, ry)

    ((first, {x: overridden, y: y2}), second) := nested()
    c::printf("%s %d %d %d\n", first, overridden, y2, second)

    return 0
}
