putchar :: foreign fn (i32) i32

printSlice :: fn (s: []i32) u0 {
    i := 0
    for i < s.len {
        putchar(48 + s[i])
        putchar(10)
        i = i + 1
    }
}

sum :: fn (s: []i32) i32 {
    total := 0
    i := 0
    for i < s.len {
        total = total + s[i]
        i = i + 1
    }
    return total
}

main :: fn () i32 {
    arr := [0, 1, 2, 3, 4]

    // arr[2:] -> {ptr: &arr[2], len: 3} -> {2, 3, 4}
    tail := arr[2:]
    printSlice(tail)

    // arr[:3] -> {ptr: &arr[0], len: 3} -> {0, 1, 2}
    head := arr[:3]
    printSlice(head)

    // arr[1:4] -> {ptr: &arr[1], len: 3} -> {1, 2, 3}
    mid := arr[1:4]
    printSlice(mid)

    // .len field
    putchar(48 + mid.len)
    putchar(10)

    // pass slice to function
    putchar(48 + sum(mid))
    putchar(10)

    // slice of slice: mid[1:] -> {2, 3}
    inner := mid[1:]
    printSlice(inner)

    // element mutation through slice
    mid[0] = 9
    putchar(48 + arr[1])
    putchar(10)

    return 0
}
