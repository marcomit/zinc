use <std.mem.gpa>
use <std.mem>
use <std.libc>

allocate :: fn (size: u64) i32 with alloc: Allocator {
    buf: *u8 = alloc.alloc(size)
    return 1
}

main :: fn () i32 {
    flag: i32 = 1
    gpa := GeneralPurposeAllocator.init()
    with heap := (&gpa).allocator() {
        r: i32 = 0
        if flag == 1 {
            r = allocate(16)
        } else {
            r = allocate(32)
        }
        io.printf("%d\n", r)
    }
    return 0
}
