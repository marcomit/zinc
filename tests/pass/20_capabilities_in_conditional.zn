// Capability-requiring function called in both branches of an if.
// The if-body is a child scope; lookupScopedCapability walks up to find the capability.

use <std::core::mem>

c :: foreign {
    printf :: u0 (*char, ...)
}

allocate :: i32 (size: u64)[alloc: Allocator] {
    buf: *u8 = alloc.alloc(size)
    return 1
}

main :: i32 () {
    flag: i32 = 1
    with heap := Allocator::heap() {
        r: i32 = 0
        if flag == 1 {
            r = allocate(16)
        } else {
            r = allocate(32)
        }
        c::printf("%d\n", r)
    }
    return 0
}
