c :: foreign {
    printf :: u0 (*char, ...)
}

add :: i32 (i32 a, i32 b) -> a + b
mul :: i32 (i32 a, i32 b) -> a * b

apply :: i32 (i32(i32, i32) op, i32 x, i32 y) {
    return op(x, y)
}

main :: i32 () {
    c::printf("%d\n", apply(add, 3, 4))
    c::printf("%d\n", apply(mul, 3, 4))
    return 0
}
