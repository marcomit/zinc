foreign printf :: fn (*char, ...) u0

Shape :: facet {
    area : fn () i32
}

Circle :: struct {
    radius: i32
}

Bad :: struct {
    x: i32
}

*Circle self :: impl Shape {
    area :: fn () i32 -> self.radius
}

main :: fn () i32 {
    b := Bad{x: 1}
    s := Shape(&b)
    printf("%d\n", s.area())
    return 0
}
