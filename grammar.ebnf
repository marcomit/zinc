(* ============================================================= *)
(*  Zinc grammar (EBNF)                                           *)
(*                                                                *)
(*  Restored to match the language as implemented (see            *)
(*  tests/pass and examples/), with the comptime-parameter        *)
(*  extension layered on top. Comptime additions are grouped      *)
(*  under the "Compile-time parameters" section and referenced    *)
(*  from the declaration rules; see docs/comptime.md.             *)
(* ============================================================= *)

source_file = { declaration } ;

declaration =
    { attribute } [ "pub" ]
    (
        struct_declaration  |
        enum_declaration    |
        type_alias          |
        facet_declaration   |
        foreign_block       |
        foreign_func        |
        func_block          |
        func_decl           |
        import_decl         |
        constant_declaration ) ;

(* ------------------------------------------------------------- *)
(*  Attributes                                                    *)
(* ------------------------------------------------------------- *)

attribute = "#" "[" attribute_item { "," attribute_item } [ "," ] "]" ;

attribute_item = identifier [ "(" [ attribute_arg { "," attribute_arg } ] ")" ] ;

(* args may be identifiers (e.g. inline(always)) or operators
   (e.g. overload(+), overload(==)) *)
attribute_arg = identifier | operator | literal ;

(* ------------------------------------------------------------- *)
(*  Imports                                                       *)
(* ------------------------------------------------------------- *)

import_decl =
    "use" (
        "<" module_path ">" | module_path
    ) ;

module_path = identifier { "::" identifier } ;

(* ------------------------------------------------------------- *)
(*  Declarations                                                  *)
(* ------------------------------------------------------------- *)

struct_declaration =
    identifier [ comptime_params ] "::" "struct" "{" { struct_member } "}" ;

struct_member = field_declaration | struct_embed ;

field_declaration =
    field_type identifier
  | identifier ":" field_type ;

struct_embed = "..." type ;

enum_declaration =
    identifier [ comptime_params ] "::" "enum" "{" { enum_variant } "}" ;

enum_variant =
    { attribute } identifier
    [ "(" [ field_type { "," field_type } ] ")" ] ;

type_alias = identifier "::" "type" field_type ;

(* top-level compile-time constant, e.g.  GLOBAL :: 100 *)
constant_declaration = identifier "::" literal ;

foreign_block = identifier "::" "foreign" "{" { foreign_signature } "}" ;

foreign_signature = identifier "::" type parameter_list ;

foreign_func = "foreign" identifier "::" type parameter_list ;

facet_declaration =
    identifier [ comptime_params ] "::" "facet" "{" { func_decl } "}" ;

(* receiver-style or static impl block.
   The receiver is a type optionally bound to a name, e.g.
       Vec :: impl { ... }                (static methods)
       Counter self :: impl { ... }       (value receiver)
       *Range self :: impl { ... }         (pointer receiver)
       []i32 self :: impl { ... }          (slice receiver)
       i32 self :: impl { ... }            (primitive receiver)
   and may declare the facet it satisfies, e.g.  impl Iter[i32] *)
func_block =
    type [ identifier ] "::" "impl" [ facet_name ] "{" { func_decl } "}" ;

facet_name = type_identifier | generic_type ;

func_decl =
    [ "pub" ]
    identifier [ comptime_params ] "::"
    field_type
    parameter_list
    [ capability_list ]
    func_body ;

func_body = block | "->" expression ;

(* ------------------------------------------------------------- *)
(*  Compile-time parameters  (see docs/comptime.md)               *)
(*                                                                *)
(*  Rule: "[" introduces compile-time parameters, "(" introduces  *)
(*  run-time parameters. Inside "[", a parameter declares its     *)
(*  KIND with "::" exactly as a run-time parameter declares its   *)
(*  TYPE with ":". A bare identifier is sugar for ":: type".      *)
(* ------------------------------------------------------------- *)

comptime_params = "[" comptime_param { "," comptime_param } [ "," ] "]" ;

comptime_param = identifier [ "::" kind ] ;   (* bare identifier  ==  identifier :: type *)

kind =
    "type"        (* any type                            *)
  | facet_name    (* any type satisfying a facet         *)
  | field_type ;  (* a compile-time value of this type   *)

(* ------------------------------------------------------------- *)
(*  Run-time parameters & capabilities                            *)
(* ------------------------------------------------------------- *)

parameter_list = "(" [
        parameter_or_variadic
        { "," parameter_or_variadic }
        [ "," ]
    ] ")" ;

parameter_or_variadic = parameter | "..." ;

parameter =
    field_type identifier
  | identifier ":" field_type
  | field_type ;          (* unnamed parameter type (foreign signatures) *)

capability_list = "[" capability { "," capability } [ "," ] "]" ;

capability =
    field_type [ identifier ]
  | identifier ":" field_type ;

(* ------------------------------------------------------------- *)
(*  Types                                                         *)
(* ------------------------------------------------------------- *)

field_type = type | sum_type ;

type =
    primitive_type  |
    pointer_type    |
    slice_type      |
    tuple_type      |
    grouped_type    |
    generic_type    |
    func_type       |
    type_identifier ;

sum_type = type "|" type { "|" type } ;

grouped_type = "(" field_type ")" ;   (* grouping, e.g. return type (*char | i32) *)

func_type = type "(" [ type { "," type } ] ")" ;

primitive_type =
    "u0"    |
    "u1"    |
    "u8"    |
    "i8"    |
    "u16"   |
    "i16"   |
    "u32"   |
    "i32"   |
    "u64"   |
    "i64"   |
    "f32"   |
    "f64"   |
    "char"  |
    "rune"  ;

pointer_type = "*" type ;

slice_type = "[" [ expression ] "]" type ;   (* [ ]T slice, [N]T sized array *)

tuple_type = "(" type "," type { "," type } ")" ;

(* use-site instantiation, e.g. Vec[i32], Array[i32, 8], Iter[i32].
   Arguments are compile-time: types or compile-time values. *)
generic_type =
    type_identifier "[" comptime_arg { "," comptime_arg } [ "," ] "]" ;

comptime_arg = type | expression ;

type_identifier = identifier ;

(* ------------------------------------------------------------- *)
(*  Statements                                                    *)
(* ------------------------------------------------------------- *)

block = "{" { statement } "}" ;

statement
    = variable_declaration
    | update_statement
    | for_statement
    | match_statement
    | with_statement
    | return_statement
    | defer_statement
    | break_statement
    | continue_statement
    | comptime_statement
    | expression_statement
    | block ;

variable_declaration
    = field_type identifier [ "=" expression ]        (* type-first:  i32 x = e   / *Point p = e *)
    | identifier ":" field_type [ "=" expression ]    (* name-first:  x: i32 = e                  *)
    | identifier "::" expression                       (* comptime local binding                  *)
    | binding ":=" expression ;                        (* inferred:    x := e  / (a, b) := e       *)

binding
    = identifier
    | tuple_destructure
    | struct_destructure ;

tuple_destructure
    = "("
        binding ","
        binding
        { "," binding }
        [ "," ]
      ")" ;

struct_destructure
    = "{"
        struct_destructure_field
        { "," struct_destructure_field }
        [ "," ]
      "}" ;

struct_destructure_field
    = identifier [ ":" identifier ] ;

(* compound / self-relative update, e.g.
       i :+ 1        ->  i = i + 1
       self.cap :* 2 ->  self.cap = self.cap * 2
       root : .next  ->  root = root.next
       flag : not    ->  flag = not flag
       root : e      ->  root = e                       *)
update_statement
    = expression ":" update_tail ;

update_tail
    = "." identifier                     (* self-relative member  *)
    | ( "not" | "!" | "~" )              (* self-relative unary   *)
    | binary_operator expression         (* compound assignment   *)
    | expression ;                        (* plain assignment      *)

comptime_statement
    = "comptime" ( block | for_statement | if_expression | expression_statement ) ;

expression_statement
    = expression ;

for_statement
    = "for"
      [ c_style_for_header | for_in_header | condition ]
      block ;

for_in_header = ( binding | enum_pattern ) "in" expression ;

c_style_for_header
    = ( variable_declaration | expression )
      ";"
      expression
      ";"
      expression ;

condition
    = let_condition
    | expression ;

let_condition
    = match_pattern ":=" expression ;

match_statement
    = "match"
      expression
      "{"
        { match_arm }
      "}" ;

match_arm
    = match_pattern
      (
          "->" expression
        | block
      )
      [ "," ] ;

with_statement
    = "with"
      ( let_condition | expression )
      block ;

return_statement
    = "return" [ expression ] ;

defer_statement
    = "defer" expression ;

break_statement
    = "break" ;

continue_statement
    = "continue" ;

(* ------------------------------------------------------------- *)
(*  Patterns                                                      *)
(* ------------------------------------------------------------- *)

match_pattern
    = enum_pattern
    | type_pattern
    | tuple_pattern
    | literal
    | identifier ;

type_pattern
    = type "(" [ match_pattern { "," match_pattern } [ "," ] ] ")" ;

enum_pattern
    = scoped_identifier
      [ "("
            [
                match_pattern
                { "," match_pattern }
                [ "," ]
            ]
        ")" ] ;

tuple_pattern
    = "("
        match_pattern ","
        match_pattern
        { "," match_pattern }
        [ "," ]
      ")" ;

(* ------------------------------------------------------------- *)
(*  Expressions                                                   *)
(* ------------------------------------------------------------- *)

expression
    = assignment_expression ;

assignment_expression
    = coalesce_expression
    | coalesce_expression "=" assignment_expression ;

coalesce_expression
    = logical_or_expression
    | logical_or_expression "??" coalesce_expression ;

logical_or_expression
    = logical_and_expression
    | logical_or_expression
      ( "or" | "||" )
      logical_and_expression ;

logical_and_expression
    = bitwise_or_expression
    | logical_and_expression
      ( "and" | "&&" )
      bitwise_or_expression ;

bitwise_or_expression
    = bitwise_xor_expression
    | bitwise_or_expression "|"
      bitwise_xor_expression ;

bitwise_xor_expression
    = bitwise_and_expression
    | bitwise_xor_expression "^"
      bitwise_and_expression ;

bitwise_and_expression
    = equality_expression
    | bitwise_and_expression "&"
      equality_expression ;

equality_expression
    = relational_expression
    | equality_expression
      ( "==" | "!=" )
      relational_expression ;

relational_expression
    = shift_expression
    | relational_expression
      ( "<" | ">" | "<=" | ">=" )
      shift_expression ;

shift_expression
    = additive_expression
    | shift_expression
      ( "<<" | ">>" )
      additive_expression ;

additive_expression
    = multiplicative_expression
    | additive_expression
      ( "+" | "-" )
      multiplicative_expression ;

multiplicative_expression
    = cast_expression
    | multiplicative_expression
      ( "*" | "/" | "%" )
      cast_expression ;

cast_expression
    = unary_expression
    | unary_expression "as" type ;

unary_expression
    = postfix_expression
    | ( "-" | "+" | "!" | "not" | "~" | "*" | "&" )
      unary_expression
    | sizeof_expression
    | comptime_expression ;

sizeof_expression
    = "sizeof" field_type ;

comptime_expression
    = "comptime" unary_expression ;

(* A postfix "[" ... "]" is either a subscript or a compile-time
   instantiation; the two share this syntax and are disambiguated
   during name resolution (a given name is either indexable or
   generic, never both). See docs/comptime.md. *)
postfix_expression
    = primary_expression
      {
          argument_list
        | "[" ( expression | slice ) "]"
        | "." identifier
        | "?"
      } ;

primary_expression
    = identifier
    | scoped_identifier
    | literal
    | if_expression
    | struct_literal
    | array_literal
    | tuple_literal
    | parenthesized_expression ;

if_expression
    = "if"
      condition
      if_branch
      [ "else" ( if_expression | if_branch ) ] ;

if_branch
    = block
    | "->" expression ;

scoped_identifier
    = identifier "::"
      identifier
      { "::" identifier } ;

parenthesized_expression
    = "(" expression ")" ;

tuple_literal
    = "("
        expression ","
        expression
        { "," expression }
        [ "," ]
      ")" ;

array_literal
    = "["
        [
            expression
            { "," expression }
            [ "," ]
        ]
      "]" ;

struct_literal
    = ( identifier | generic_type )
      field_initializer_list ;

field_initializer_list
    = "{"
        [
            field_initializer
            { "," field_initializer }
            [ "," ]
        ]
      "}" ;

field_initializer
    = identifier ":" expression ;

argument_list
    = "("
        [
            expression
            { "," expression }
            [ "," ]
        ]
      ")" ;

slice
    = [ expression ]
      ":"
      [ expression ] ;

(* ------------------------------------------------------------- *)
(*  Operators                                                     *)
(* ------------------------------------------------------------- *)

binary_operator
    = "+" | "-" | "*" | "/" | "%"
    | "&" | "|" | "^" | "<<" | ">>"
    | "and" | "or" | "&&" | "||"
    | "==" | "!=" | "<" | ">" | "<=" | ">=" ;

operator
    = binary_operator
    | "!" | "not" | "~" | "??" | "=" ;

(* ------------------------------------------------------------- *)
(*  Literals & lexical                                            *)
(* ------------------------------------------------------------- *)

literal
    = int_literal
    | float_literal
    | string_literal
    | rune_literal
    | bool_literal
    | none_literal ;

bool_literal
    = "true"
    | "false" ;

none_literal
    = "none" ;

identifier
    = letter { letter | digit | "_" } ;

int_literal
    = decimal_literal
    | hexadecimal_literal
    | binary_literal ;

float_literal
    = digit { digit }
      "."
      { digit }
      [ exponent ] ;

decimal_literal
    = digit { digit } ;

hexadecimal_literal
    = "0x"
      hexadecimal_digit
      { hexadecimal_digit } ;

binary_literal
    = "0b"
      binary_digit
      { binary_digit } ;

string_literal
    = "\""
      { string_character }
      "\"" ;

rune_literal
    = "'"
      { rune_character }
      "'" ;

exponent
    = ( "e" | "E" )
      [ "+" | "-" ]
      digit
      { digit } ;

letter
    = "a"..."z"
    | "A"..."Z"
    | "_" ;

digit
    = "0"..."9" ;

binary_digit
    = "0" | "1" ;

hexadecimal_digit
    = digit
    | "a"..."f"
    | "A"..."F" ;

string_character
    = ? any non-quote character or escaped sequence ? ;

rune_character
    = ? any non-quote character or escaped sequence ? ;

comment
    = "//" { ? any character except newline ? }
    | "/*" { ? comment content ? } "*/" ;
